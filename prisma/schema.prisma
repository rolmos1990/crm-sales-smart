generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================
// ENUMS
// =====================

enum Rol {
  OWNER
  ADMIN
  GERENTE_VENTAS
  SUPERVISOR
  AGENTE_VENTAS
  EJECUTIVO_VENTAS
  AGENTE_SOPORTE
  INVITADO
  AGENTE
}

enum EstadoContacto {
  ACTIVO
  INACTIVO
  LEAD
}

// Mantenido para compatibilidad con el kanban actual
enum Etapa {
  PROSPECTO
  CALIFICADO
  PROPUESTA
  NEGOCIACION
  GANADO
  PERDIDO
}

enum TipoActividad {
  LLAMADA
  EMAIL
  REUNION
  TAREA
  NOTA
  WHATSAPP
}

enum PrioridadActividad {
  ALTA
  MEDIA
  BAJA
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  APROBADA
  RECHAZADA
  VENCIDA
}

enum EstadoPedido {
  PENDIENTE
  CONFIRMADO
  EN_PROCESO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum TipoTransportista {
  COURIER_EXTERNO
  MENSAJERO_PROPIO
  RETIRO_TIENDA
  DIGITAL
  INSTALACION_SERVICIO
}

enum MetodoEntrega {
  COURIER_EXTERNO
  MENSAJERO_PROPIO
  RETIRO_TIENDA
  DIGITAL
  INSTALACION_SERVICIO
}

enum EstadoEntrega {
  PENDIENTE
  PREPARANDO
  EN_CAMINO
  ENTREGADO
  FALLIDO
  CANCELADO
  DEVUELTO
}

enum TipoCampoPersonalizado {
  TEXTO
  TEXTO_LARGO
  NUMERO
  DECIMAL
  FECHA
  BOOLEANO
  SELECT
  MULTISELECT
  EMAIL
  TELEFONO
  URL
  JSON
}

enum EntidadCampoPersonalizado {
  OPORTUNIDAD
  CONTACTO
  EMPRESA
  PEDIDO
  COTIZACION
  PRODUCTO
}

enum EstadoInstancia {
  ACTIVA
  INACTIVA
  SUSPENDIDA
}

enum EstadoUsuario {
  ACTIVO
  INVITADO
  SUSPENDIDO
  BLOQUEADO
}

enum TipoUsuario {
  USUARIO
  AGENTE
}

enum EstadoIntegracion {
  INSTALADA
  ACTIVA
  INACTIVA
  ERROR
}

enum TipoAccionDisparador {
  CREAR_TAREA
  CREAR_NOTA
  WEBHOOK
  ASIGNAR_USUARIO
  ASIGNAR_ETIQUETA
  MODIFICAR_CAMPO
  CAMBIAR_ETAPA
}

enum EstadoDisparadorJob {
  PENDIENTE
  PROCESANDO
  COMPLETADO
  CANCELADO
  FALLIDO
}

enum OperadorCondicion {
  IGUAL
  DIFERENTE
  MAYOR_QUE
  MENOR_QUE
  CONTIENE
  ES_VERDADERO
  ES_FALSO
}

enum TipoMovimientoEtapa {
  MANUAL
  AUTOMATICO
}

enum TipoPlantilla {
  TEXTO
  TEXTO_IMAGEN
}

enum EstadoMedia {
  PENDIENTE
  PROCESANDO
  LISTO
  ERROR
}

enum EstadoConversacion {
  ABIERTA
  CERRADA
  ARCHIVADA
  EN_ESPERA
}

enum EstadoImportacion {
  EN_PROCESO
  COMPLETADO
  COMPLETADO_CON_ERRORES
  FALLIDO
}

enum TipoMensaje {
  TEXTO
  IMAGEN
  VIDEO
  AUDIO
  NOTA_VOZ
  DOCUMENTO
  PLANTILLA
  BOTON
  EVENTO_SISTEMA
}

enum RemitenteMsg {
  CONTACTO
  AGENTE
  SISTEMA
  BOT
}

enum EstadoMensaje {
  RECIBIDO
  ENVIADO
  ENTREGADO
  LEIDO
  FALLIDO
}

enum TipoReaccion {
  CANAL // sincroniza con canal externo (WhatsApp)
  INTERNA // solo visible en CRM
}

// =====================
// INSTANCIA / TENANT
// =====================

model Instancia {
  id            String          @id @default(cuid())
  nombre        String
  slug          String          @unique
  descripcion   String?
  dominio       String?
  logoUrl       String?
  estado        EstadoInstancia @default(ACTIVA)
  configuracion Json?
  metadata      Json?
  creadoEn      DateTime        @default(now())
  actualizadoEn DateTime        @updatedAt

  usuarios             UsuarioInstancia[]
  empresas             Empresa[]
  contactos            Contacto[]
  pipelines            Pipeline[]
  oportunidades        Oportunidad[]
  productos            Producto[]
  actividades          Actividad[]
  cotizaciones         Cotizacion[]
  pedidos              Pedido[]
  tags                 Tag[]
  campos               CampoPersonalizado[]
  eventos              EventoLog[]
  integraciones        IntegracionInstancia[]
  configuracionEmpresa ConfiguracionEmpresa?
  plantillas           PlantillaCRM[]
  mediaArchivos        MediaArchivo[]
  cuentasCanal         CuentaCanal[]
  conversaciones       Conversacion[]
  identificadoresCanal ContactoIdentificadorCanal[]

  flujosVenta          FlujoVenta[]
  importaciones        HistorialImportacion[]
  transportistas       Transportista[]

  // IA
  configuracionIA ConfiguracionIA?
  proveedoresIA   ProveedorIA[]
  agentesIAConfig AgenteIAConfig[]
  usoIA           UsoIA[]

  @@index([slug])
  @@index([estado])
}

// =====================
// USUARIOS
// =====================

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String?
  rol          Rol      @default(AGENTE)
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  tipo     TipoUsuario   @default(USUARIO)
  telefono String?
  cargo    String?

  // Autenticación (proveedor externo, ej. Supabase)
  authUserId       String?       @unique
  estado           EstadoUsuario @default(INVITADO)
  intentosFallidos Int           @default(0)
  bloqueadoHasta   DateTime?
  nivelBloqueo     Int           @default(0)
  ultimoLogin      DateTime?

  instancias    UsuarioInstancia[]
  empresas      Empresa[]
  contactos     Contacto[]
  oportunidades Oportunidad[]
  actividades   Actividad[]
  cotizaciones  Cotizacion[]
  pedidos       Pedido[]

  // IA — presente solo en usuarios tipo AGENTE con capacidades IA
  agenteIAConfig AgenteIAConfig?
}

model UsuarioInstancia {
  id            String   @id @default(cuid())
  rol           Rol      @default(AGENTE)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  oportunidades Oportunidad[]
  actividades   Actividad[]
  cotizaciones  Cotizacion[]
  pedidos       Pedido[]
  empresas      Empresa[]
  contactos     Contacto[]

  @@unique([usuarioId, instanciaId])
  @@index([instanciaId])
  @@index([usuarioId])
}

// =====================
// CRM BASE
// =====================

model Empresa {
  id            String   @id @default(cuid())
  nombre        String
  ruc           String?
  industria     String?
  tamano        String?
  sitioWeb      String?
  telefono      String?
  email         String?
  notas         String?
  activo        Boolean  @default(true)
  metadata      Json?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  contactos     Contacto[]
  oportunidades Oportunidad[]
  actividades   Actividad[]
  cotizaciones  Cotizacion[]
  pedidos       Pedido[]
  campos        CampoPersonalizadoValor[]

  @@index([instanciaId])
  @@index([nombre])
  @@index([ruc])
}

model Contacto {
  id                 String         @id @default(cuid())
  nombre             String
  apellido           String
  email              String?
  telefonoPrincipal  String?
  telefonoSecundario String?
  cargo              String?
  notas              String?
  estado             EstadoContacto @default(LEAD)
  activo             Boolean        @default(true)
  avatarUrl          String?
  metadata           Json?
  creadoEn           DateTime       @default(now())
  actualizadoEn      DateTime       @updatedAt

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  oportunidades        OportunidadContacto[]
  actividades          Actividad[]
  cotizaciones         Cotizacion[]
  pedidos              Pedido[]
  campos               CampoPersonalizadoValor[]
  tags                 ContactoTag[]
  conversaciones       Conversacion[]
  identificadoresCanal ContactoIdentificadorCanal[]
  mediaArchivos        MediaArchivo[]

  @@index([instanciaId])
  @@index([nombre])
  @@index([apellido])
  @@index([email])
}

// =====================
// PIPELINES DINÁMICOS
// =====================

model Pipeline {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  esDefault     Boolean  @default(false)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  stages        PipelineStage[]
  oportunidades Oportunidad[]
  campos        CampoPersonalizado[]
  disparadores  Disparador[]
  cuentasCanal  CuentaCanal[]

  @@index([instanciaId])
  @@index([esDefault])
}

model PipelineStage {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  color         String?
  orden         Int
  probabilidad  Int      @default(20)
  esInicial     Boolean  @default(false)
  esGanado      Boolean  @default(false)
  esPerdido     Boolean  @default(false)
  // Solo aplica a etapas esGanado/esPerdido: permite ocultarlas como columna
  // del kanban sin perder la posibilidad de mover una oportunidad a esa etapa
  // (drag&drop directo o vía el popover "Mover a").
  visible       Boolean  @default(true)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  respuestaIAHabilitada Boolean         @default(false)
  agenteIAConfigId      String?
  agenteIAConfig        AgenteIAConfig? @relation(fields: [agenteIAConfigId], references: [id], onDelete: SetNull)

  oportunidades Oportunidad[]
  campos        CampoPersonalizado[]
  disparadores  Disparador[]
  cuentasCanal  CuentaCanal[]

  @@unique([pipelineId, orden])
  @@index([pipelineId])
}

// =====================
// OPORTUNIDADES
// =====================

model Oportunidad {
  id                  String    @id @default(cuid())
  titulo              String
  descripcion         String?
  valor               Decimal   @default(0)
  moneda              String    @default("PEN")
  etapa               Etapa     @default(PROSPECTO)
  probabilidad        Int       @default(20)
  fechaCierre         DateTime?
  fechaGanada         DateTime?
  fechaPerdida        DateTime?
  notas               String?
  motivoPerdida       String?
  metadata            Json?
  nuevoMensaje        Boolean   @default(false)
  ultimaInteraccionEn DateTime?
  creadoEn            DateTime  @default(now())
  actualizadoEn       DateTime  @updatedAt

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  // Pipeline dinámico (opcional, convive con etapa enum)
  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id])

  stageId String?
  stage   PipelineStage? @relation(fields: [stageId], references: [id])

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  contactos             OportunidadContacto[]
  productos             OportunidadProducto[]
  actividades           Actividad[]
  cotizaciones          Cotizacion[]
  pedidos               Pedido[]
  tags                  OportunidadTag[]
  campos                CampoPersonalizadoValor[]
  disparadorJobs        DisparadorJob[]
  conversaciones        OportunidadConversacion[]
  conversacionesGanadas Conversacion[]            @relation("ConvOportunidadGanada")

  @@index([instanciaId])
  @@index([instanciaId, id])
  @@index([pipelineId])
  @@index([stageId])
  @@index([empresaId])
  @@index([etapa])
}

model OportunidadContacto {
  oportunidadId String
  contactoId    String
  principal     Boolean @default(false)

  oportunidad Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)
  contacto    Contacto    @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  @@id([oportunidadId, contactoId])
  @@index([oportunidadId, principal])
}

model OportunidadProducto {
  id             String  @id @default(cuid())
  descripcion    String?
  cantidad       Decimal @default(1)
  precioUnitario Decimal
  descuento      Decimal @default(0)
  subtotal       Decimal @default(0)

  oportunidadId String
  oportunidad   Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)

  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id])
}

// =====================
// TAGS POR INSTANCIA
// =====================

model Tag {
  id       String   @id @default(cuid())
  nombre   String
  color    String?
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now())

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  oportunidades OportunidadTag[]
  contactos     ContactoTag[]

  @@index([instanciaId])
}

model OportunidadTag {
  oportunidadId String
  tagId         String

  oportunidad Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([oportunidadId, tagId])
}

model ContactoTag {
  contactoId String
  tagId      String

  contacto Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactoId, tagId])
}

// =====================
// CAMPOS PERSONALIZADOS
// =====================

model CampoPersonalizado {
  id            String                    @id @default(cuid())
  nombre        String
  clave         String
  descripcion   String?
  tipo          TipoCampoPersonalizado
  entidad       EntidadCampoPersonalizado
  requerido     Boolean                   @default(false)
  bloqueado     Boolean                   @default(false)
  activo        Boolean                   @default(true)
  orden         Int                       @default(0)
  opciones      Json?
  validaciones  Json?
  valorDefault  Json?
  visibleEn     Json?
  requeridoEn   Json?
  bloqueadoEn   Json?
  creadoEn      DateTime                  @default(now())
  actualizadoEn DateTime                  @updatedAt

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  stageId String?
  stage   PipelineStage? @relation(fields: [stageId], references: [id], onDelete: Cascade)

  valores CampoPersonalizadoValor[]

  @@index([instanciaId])
  @@index([entidad])
  @@index([pipelineId])
  @@index([stageId])
}

model CampoPersonalizadoValor {
  id    String @id @default(cuid())
  valor Json?

  campoId String
  campo   CampoPersonalizado @relation(fields: [campoId], references: [id], onDelete: Cascade)

  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)

  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  pedidoId String?
  pedido   Pedido? @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  cotizacionId String?
  cotizacion   Cotizacion? @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([campoId])
  @@index([oportunidadId])
  @@index([contactoId])
  @@index([empresaId])
  @@index([pedidoId])
  @@index([cotizacionId])
}

// =====================
// PRODUCTOS
// =====================

model Producto {
  id                 String   @id @default(cuid())
  sku                String?
  nombre             String
  descripcion        String?
  precio             Decimal  @default(0)
  moneda             String   @default("PEN")
  categoria          String?
  unidad             String   @default("unidad")
  imagenUrl          String?
  activo             Boolean  @default(true)
  manejaStock        Boolean  @default(false)
  cantidadDisponible Decimal  @default(0)
  metadata           Json?
  creadoEn           DateTime @default(now())
  actualizadoEn      DateTime @updatedAt

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  oportunidadLineas OportunidadProducto[]
  cotizacionLineas  CotizacionLinea[]
  pedidoLineas      PedidoLinea[]

  @@index([instanciaId])
  @@index([sku])
  @@index([nombre])
  @@index([categoria])
}

// =====================
// ACTIVIDADES
// =====================

model Actividad {
  id            String             @id @default(cuid())
  tipo          TipoActividad      @default(TAREA)
  prioridad     PrioridadActividad @default(MEDIA)
  titulo        String
  descripcion   String?
  fecha         DateTime
  completada    Boolean            @default(false)
  completadaEn  DateTime?
  metadata      Json?
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt

  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id])

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id])

  pedidoId String?
  pedido   Pedido? @relation(fields: [pedidoId], references: [id])

  cotizacionId String?
  cotizacion   Cotizacion? @relation(fields: [cotizacionId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  @@index([instanciaId])
  @@index([fecha])
  @@index([completada])
  @@index([pedidoId])
  @@index([cotizacionId])
}

// =====================
// COTIZACIONES
// =====================

model Cotizacion {
  id               String           @id @default(cuid())
  numero           String
  estado           EstadoCotizacion @default(BORRADOR)
  fechaEmision     DateTime         @default(now())
  fechaVencimiento DateTime?
  subtotal         Decimal          @default(0)
  descuento        Decimal          @default(0)
  impuesto         Decimal          @default(0)
  total            Decimal          @default(0)
  moneda           String           @default("PEN")
  notas            String?
  metadata         Json?
  creadoEn         DateTime         @default(now())
  actualizadoEn    DateTime         @updatedAt

  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id])

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  lineas      CotizacionLinea[]
  pedidos     Pedido[]
  campos      CampoPersonalizadoValor[]
  actividades Actividad[]

  @@unique([instanciaId, numero])
  @@index([instanciaId])
  @@index([estado])
  @@index([oportunidadId])
}

model CotizacionLinea {
  id             String  @id @default(cuid())
  descripcion    String?
  cantidad       Decimal
  precioUnitario Decimal
  descuento      Decimal @default(0)
  impuesto       Decimal @default(0)
  subtotal       Decimal
  total          Decimal @default(0)
  orden          Int     @default(0)
  metadata       Json?

  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id])
}

// =====================
// PEDIDOS
// =====================

model Pedido {
  id     String       @id @default(cuid())
  numero String
  estado EstadoPedido @default(PENDIENTE)

  // Datos del comprador (pedido manual sin contacto en sistema)
  nombre        String?
  apellido      String?
  telefono      String?
  email         String?
  ruc           String?
  empresaNombre String?

  fechaPedido   DateTime  @default(now())
  fechaEntrega  DateTime?
  subtotal      Decimal   @default(0)
  descuento     Decimal   @default(0)
  impuesto      Decimal   @default(0)
  total         Decimal   @default(0)
  moneda        String    @default("PEN")
  notas         String?
  metadata      Json?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id])

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  cotizacionId String?
  cotizacion   Cotizacion? @relation(fields: [cotizacionId], references: [id])

  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  flujoVentaId String?
  flujoVenta   FlujoVenta? @relation(fields: [flujoVentaId], references: [id])

  flujoVentaEtapaId String?
  flujoVentaEtapa   FlujoVentaEtapa? @relation(fields: [flujoVentaEtapaId], references: [id])

  lineas          PedidoLinea[]
  campos          CampoPersonalizadoValor[]
  historialEtapas PedidoHistorialEtapa[]
  historial       PedidoHistorial[]
  disparadorJobs  DisparadorJob[]
  actividades     Actividad[]
  entrega         EntregaPedido?

  @@unique([instanciaId, numero])
  @@index([instanciaId])
  @@index([estado])
  @@index([flujoVentaEtapaId])
  @@index([telefono])
  @@index([email])
}

model PedidoLinea {
  id             String  @id @default(cuid())
  descripcion    String?
  cantidad       Decimal
  precioUnitario Decimal
  descuento      Decimal @default(0)
  impuesto       Decimal @default(0)
  subtotal       Decimal
  total          Decimal @default(0)
  orden          Int     @default(0)
  metadata       Json?

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id])
}

// =====================
// ENTREGA Y TRANSPORTISTAS
// =====================

model Transportista {
  id     String            @id @default(cuid())
  nombre String
  tipo   TipoTransportista @default(COURIER_EXTERNO)
  activo Boolean           @default(true)
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  entregas EntregaPedido[]

  @@index([instanciaId])
}

model EntregaPedido {
  id             String        @id @default(cuid())
  metodoEntrega  MetodoEntrega @default(COURIER_EXTERNO)
  estadoEntrega  EstadoEntrega @default(PENDIENTE)
  numeroGuia     String?
  urlSeguimiento String?
  fechaEstimada  DateTime?
  observaciones  String?
  creadoEn       DateTime      @default(now())
  actualizadoEn  DateTime      @updatedAt

  pedidoId String  @unique
  pedido   Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  transportistaId String?
  transportista   Transportista? @relation(fields: [transportistaId], references: [id])

  @@index([pedidoId])
}

// =====================
// EVENTOS / AUDITORÍA
// =====================

model EventoLog {
  id          String   @id @default(cuid())
  tipo        String
  payload     Json
  ocurridoEn  DateTime @default(now())
  entidadTipo String?
  entidadId   String?
  usuarioId   String?

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@index([instanciaId])
  @@index([entidadTipo, entidadId])
  @@index([tipo])
  @@index([ocurridoEn])
}

// =====================
// HISTORIAL DE IMPORTACIONES
// =====================

model HistorialImportacion {
  id                 String            @id @default(cuid())
  entidad            String
  archivoNombre      String
  archivoTipo        String
  archivoPeso        Int
  totalRegistros     Int
  registrosExitosos  Int
  registrosConError  Int
  errores            Json
  estado             EstadoImportacion @default(EN_PROCESO)
  fechaCreacion      DateTime          @default(now())

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioId String?

  @@index([instanciaId])
  @@index([fechaCreacion])
}

// =====================
// DISPARADORES (TRIGGERS)
// =====================

model Disparador {
  id            String               @id @default(cuid())
  nombre        String
  activo        Boolean              @default(true)
  orden         Int                  @default(0)
  delayMinutos  Int?
  tipo          TipoAccionDisparador
  config        Json
  creadoEn      DateTime             @default(now())
  actualizadoEn DateTime             @updatedAt

  // Pipeline CRM (oportunidades) — opcionales
  stageId String?
  stage   PipelineStage? @relation(fields: [stageId], references: [id], onDelete: Cascade)

  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  // Flujo de Venta (pedidos) — opcionales
  flujoVentaEtapaId String?
  flujoVentaEtapa   FlujoVentaEtapa? @relation(fields: [flujoVentaEtapaId], references: [id], onDelete: Cascade)

  flujoVentaId String?
  flujoVenta   FlujoVenta? @relation(fields: [flujoVentaId], references: [id], onDelete: Cascade)

  jobs DisparadorJob[]

  @@index([stageId])
  @@index([pipelineId])
  @@index([flujoVentaEtapaId, activo])
  @@index([flujoVentaId])
}

model DisparadorJob {
  id          String              @id @default(cuid())
  estado      EstadoDisparadorJob @default(PENDIENTE)
  ejecutarEn  DateTime
  payload     Json
  resultado   Json?
  error       String?
  creadoEn    DateTime            @default(now())
  procesadoEn DateTime?

  disparadorId String
  disparador   Disparador @relation(fields: [disparadorId], references: [id])

  // Oportunidad (CRM) — opcional
  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)

  // Pedido (Ventas) — opcional
  pedidoId String?
  pedido   Pedido? @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  // Denormalizados para búsqueda rápida
  stageId           String?
  pipelineId        String?
  flujoVentaEtapaId String?
  flujoVentaId      String?

  @@index([estado, ejecutarEn])
  @@index([oportunidadId, stageId])
  @@index([pedidoId, flujoVentaEtapaId])
  @@index([disparadorId])
}

// =====================
// FLUJO DE VENTA (PEDIDOS)
// =====================

model FlujoVenta {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  esDefault     Boolean  @default(false)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  etapas       FlujoVentaEtapa[]
  pedidos      Pedido[]
  disparadores Disparador[]

  @@index([instanciaId])
}

model FlujoVentaEtapa {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  color         String?
  orden         Int      @default(0)
  esInicial           Boolean  @default(false)
  esFinal             Boolean  @default(false)
  esCancelacion       Boolean  @default(false)
  esSecuencial         Boolean  @default(true)
  permiteEditarPedido  Boolean  @default(true)
  permiteEditarEntrega Boolean  @default(false)
  activo               Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  flujoVentaId String
  flujoVenta   FlujoVenta @relation(fields: [flujoVentaId], references: [id], onDelete: Cascade)

  parentId String?
  parent   FlujoVentaEtapa?  @relation("EtapaTree", fields: [parentId], references: [id])
  children FlujoVentaEtapa[] @relation("EtapaTree")

  pedidos      Pedido[]
  reglas       FlujoVentaRegla[]
  historial    PedidoHistorialEtapa[]
  disparadores Disparador[]

  @@index([flujoVentaId, orden])
  @@index([flujoVentaId])
  @@index([parentId])
}

model FlujoVentaRegla {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  activo        Boolean  @default(true)
  prioridad     Int      @default(0)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  etapaDestinoId String
  etapaDestino   FlujoVentaEtapa @relation(fields: [etapaDestinoId], references: [id], onDelete: Cascade)

  condiciones FlujoVentaReglaCondicion[]

  @@index([etapaDestinoId])
}

model FlujoVentaReglaCondicion {
  id       String            @id @default(cuid())
  campo    String
  operador OperadorCondicion
  valor    String

  reglaId String
  regla   FlujoVentaRegla @relation(fields: [reglaId], references: [id], onDelete: Cascade)

  @@index([reglaId])
}

model PedidoHistorialEtapa {
  id                  String              @id @default(cuid())
  etapaNombre         String
  etapaAnteriorNombre String?
  tipo                TipoMovimientoEtapa
  origen              String              @default("SISTEMA")
  notas               String?
  referencia          String?
  usuarioNombre       String?
  creadoEn            DateTime            @default(now())

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  etapaId String
  etapa   FlujoVentaEtapa @relation(fields: [etapaId], references: [id])

  usuarioId String?

  @@index([pedidoId])
  @@index([etapaId])
}

model PedidoHistorial {
  id            String   @id @default(cuid())
  accion        String
  valorAnterior Json?
  valorNuevo    Json?
  usuarioNombre String?
  creadoEn      DateTime @default(now())

  pedidoId  String
  pedido    Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  usuarioId String?

  @@index([pedidoId])
}

// =====================
// INTEGRACIONES
// =====================

model IntegracionInstancia {
  id            String            @id @default(cuid())
  clave         String
  estado        EstadoIntegracion @default(INSTALADA)
  configuracion Json?
  metadata      Json?
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@unique([instanciaId, clave])
  @@index([instanciaId])
  @@index([clave])
}

// =====================
// CONFIGURACIÓN EMPRESA
