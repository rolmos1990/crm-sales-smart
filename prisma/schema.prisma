// Configuración del análisis por cuenta. Se crea de forma perezosa la primera
// vez que se marca un contacto (research D16). `peso` lo ajusta el equipo de
// Karia: no se acepta desde las acciones de la cuenta.
model ConfiguracionAnalisisContactos {
  id                       String                @id @default(cuid())
  habilitado               Boolean               @default(true)
  modoInteres              ModoAplicacionInteres @default(SOLO_SUGERIR)
  mesesAntiguedadInicial   Int                   @default(12)
  tamanoLote               Int                   @default(20)
  maxLotesSimultaneos      Int                   @default(1)
  presupuestoDiarioCosto   Decimal?
  presupuestoDiarioTokens  Int?
  ventanaAgrupacionSeg     Int                   @default(300)
  esperaMaximaSeg          Int                   @default(1800)
  historicoPausado         Boolean               @default(false)
  peso                     Int                   @default(1)
  // Stride scheduling (research D2): la cuenta con menor valor recibe el turno.
  siguienteTurnoEn         DateTime              @default(now())
  lotesEnCurso             Int                   @default(0)
  ultimaAtencionEn         DateTime?
  modoInteresCambiadoPorId String?
  modoInteresCambiadoEn    DateTime?
  creadoEn                 DateTime              @default(now())
  actualizadoEn            DateTime              @updatedAt

  instanciaId String    @unique
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@index([habilitado, siguienteTurnoEn])
}

// Una fila por contacto, PERMANENTE: así `versionDatos` es monótona y la
// escritura de una evaluación puede descartar resultados viejos (research D4).
// En estado PENDIENTE es lo que la spec llama "Contacto pendiente". Los índices
// parciales (estado = PENDIENTE / EN_PROCESO) están en el SQL de la migración.
model ContactoAnalisisCola {
  id                String                @id @default(cuid())
  estado            EstadoColaAnalisis    @default(PENDIENTE)
  prioridad         PrioridadAnalisis     @default(P2)
  tipo              TipoEjecucionAnalisis @default(INCREMENTAL)
  versionDatos      BigInt                @default(1)
  versionReclamada  BigInt?
  forzarIA          Boolean               @default(false)
  primerMarcadoEn   DateTime?
  elegibleDesde     DateTime              @default(now())
  datosHasta        DateTime?
  intentos          Int                   @default(0)
  bloqueadoHasta    DateTime?
  ultimaEjecucionId String?
  motivo            String?
  creadoEn          DateTime              @default(now())
  actualizadoEn     DateTime              @updatedAt

  contactoId String   @unique
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@index([instanciaId, estado])
}

// Resultado vigente del análisis de un contacto. `relacionComercial` es una
// foto para el panel, NO una fuente de filtros: "Cliente" sigue saliendo de
// condiciones.ts en cada consulta (regla 10 de CLAUDE.md).
model ContactoEvaluacion {
  id                        String             @id @default(cuid())
  origen                    OrigenEvaluacion
  relacionComercial         RelacionComercial
  puntaje                   Int
  puntajeBase               Int
  ajusteIA                  Int?
  intencion                 IntencionCompra?
  urgencia                  NivelUrgencia?
  recuperacion              NivelRecuperacion?
  // Lo de las reglas se reescribe en CADA evaluación; lo de la IA solo cuando
  // hay evaluación con IA. Por eso van en columnas separadas: un pedido nuevo
  // (solo reglas) no puede borrar lo que la IA leyó en la conversación.
  senalesReglas             Json               @default("[]")
  motivosReglas             Json               @default("[]")
  senales                   Json               @default("[]")
  objeciones                Json               @default("[]")
  motivos                   Json               @default("[]")
  accionIA                  AccionComercial?
  /// Acción visible: la de las reglas si es RESPONDER/NO_CONTACTAR (FR-021), si no la de la IA, si no la de las reglas.
  accionSugerida            AccionComercial
  versionEvaluada           BigInt
  iaHasta                   DateTime?
  evaluadoEn                DateTime           @default(now())
  evaluadoIAEn              DateTime?
  proximaEvaluacionEn       DateTime?
  plantillaAplicada         String?
  ejecucionId               String?
  // Sugerencias (research D14): la IA nunca escribe "No contactar", y el
  // interés solo lo escribe si la cuenta eligió APLICAR_AUTOMATICO.
  interesSugerido           NivelInteres?
  interesSugeridoEstado     EstadoSugerencia?
  noContactarSugerido       Boolean            @default(false)
  noContactarMotivo         String?
  noContactarSugeridoEstado EstadoSugerencia?
  noContactarResueltoEn     DateTime?
  sugerenciaResueltaPorId   String?
  sugerenciaResueltaEn      DateTime?
  actualizadoEn             DateTime           @updatedAt

  criterioVersionId String?
  criterioVersion   CriterioAnalisisContactosVersion? @relation(fields: [criterioVersionId], references: [id], onDelete: SetNull)

  contactoId String   @unique
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@index([instanciaId, proximaEvaluacionEn])
  @@index([instanciaId, interesSugeridoEstado])
}

// Criterio de análisis de la cuenta. Sin fila = plantilla GENERAL en memoria
// (research D12): no hace falta sembrar nada.
model CriterioAnalisisContactos {
  id                 String   @id @default(cuid())
  versionPublicadaId String?  @unique
  creadoEn           DateTime @default(now())
  actualizadoEn      DateTime @updatedAt

  instanciaId String    @unique
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  versiones CriterioAnalisisContactosVersion[]
}

model CriterioAnalisisContactosVersion {
  id              String                @id @default(cuid())
  numero          Int?
  estado          EstadoVersionCriterio
  plantillaOrigen String
  // Validado con CriterioContenidoSchema (src/crm/contactos/analisis/criterio/schema.ts).
  contenido       Json
  publicadaEn     DateTime?
  creadaPorId     String?
  publicadaPorId  String?
  creadoEn        DateTime              @default(now())
  actualizadoEn   DateTime              @updatedAt

  criterioId String
  criterio   CriterioAnalisisContactos @relation(fields: [criterioId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  evaluaciones ContactoEvaluacion[]

  @@index([criterioId, estado])
  @@index([instanciaId])
}

// Una fila por INTENTO de procesar un lote (FR-037). Nunca guarda claves,
// prompts ni texto de conversaciones (FR-041). La finalización lógica de cada
// contacto se cuenta en la cola, no acá, para no contar dos veces (FR-038).
model EjecucionAnalisisContactos {
  id                  String                  @id @default(cuid())
  loteId              String
  loteRaizId          String?
  intento             Int                     @default(1)
  tipo                TipoEjecucionAnalisis
  prioridad           PrioridadAnalisis
  modo                ModoEjecucionAnalisis
  estado              EstadoEjecucionAnalisis @default(EN_CURSO)
  proveedor           String?
  modelo              String?
  configAplicada      Json                    @default("{}")
  contactosPedidos    Int                     @default(0)
  contactosProcesados Int                     @default(0)
  contactosExitosos   Int                     @default(0)
  contactosFallidos   Int                     @default(0)
  tokensEntrada       Int                     @default(0)
  tokensSalida        Int                     @default(0)
  tokensCacheados     Int                     @default(0)
  costoEstimado       Decimal?
  usoIAId             String?
  duracionMs          Int?
  esperaColaMs        Int?
  iniciadoEn          DateTime                @default(now())
  finalizadoEn        DateTime?
  leaseHasta          DateTime
  errorCodigo         String?
  errorMensaje        String?
  creadoEn            DateTime                @default(now())

  proveedorIAId String?
  proveedorIA   ProveedorIA? @relation(fields: [proveedorIAId], references: [id], onDelete: SetNull)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  items EjecucionAnalisisContactosItem[]

  @@index([instanciaId, creadoEn])
  @@index([estado, leaseHasta])
  @@index([loteId])
}

// Detalle por contacto. Retención de 90 días (motor/retencion.ts). Sin FK a
// Contacto a propósito: el detalle auditado sobrevive al borrado del contacto.
model EjecucionAnalisisContactosItem {
  id          String             @id @default(cuid())
  contactoId  String
  estado      EstadoItemAnalisis
  antes       Json?
  despues     Json?
  motivo      String?
  errorCodigo String?
  procesadoEn DateTime           @default(now())

  ejecucionId String
  ejecucion   EjecucionAnalisisContactos @relation(fields: [ejecucionId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@index([instanciaId, contactoId, procesadoEn])
  @@index([procesadoEn])
}

// Agregado diario por cuenta; se conserva cuando el detalle se purga.
model ResumenDiarioAnalisisContactos {
  id                 String   @id @default(cuid())
  /// YYYY-MM-DD en la zona horaria del negocio.
  dia                String
  atenciones         Int      @default(0)
  atencionesFallidas Int      @default(0)
  contactosEvaluados Int      @default(0)
  contactosPorReglas Int      @default(0)
  contactosConIA     Int      @default(0)
  contactosFallidos  Int      @default(0)
  tokensEntrada      Int      @default(0)
  tokensSalida       Int      @default(0)
  tokensCacheados    Int      @default(0)
  costoEstimado      Decimal  @default(0)
  duracionTotalMs    BigInt   @default(0)
  esperaTotalMs      BigInt   @default(0)
  actualizadoEn      DateTime @updatedAt

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@unique([instanciaId, dia])
}

// --- 012-perfil-dinamico-cliente ---

// Cache persistente del perfil calculado de un contacto — se recalcula de
// forma incremental por evento (ver invalidar-perfil.suscriptor.ts), nunca
// en cada mensaje. datosObjetivos y datosInterpretados quedan en columnas
// separadas a propósito (no se mezclan hechos verificables con
// interpretaciones de IA — ver spec 012, Historia 2).
model PerfilClienteSnapshot {
  id                 String   @id @default(cuid())
  tipoRelacion       String
  datosObjetivos     Json
  datosInterpretados Json?
  senalesObjetivas   Json
  calculadoEn        DateTime @default(now())
  disparadoPor       String?

  contactoId String   @unique
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@index([instanciaId])
}

// 031-memoria-y-ficha-conversacion — lo que el agente registró de UNA
// conversación en curso: qué producto se habló, qué precio ya informó, qué
// dejó preguntado. Distinta de PerfilClienteSnapshot, que es por contacto y
// de largo plazo (FR-015): un contacto con tres conversaciones abiertas tiene
// un perfil y tres fichas.
//
// Dos mitades que nunca se mezclan, mismo criterio que el perfil:
//   hechos       — derivados de datos verificables (resultados de herramientas
//                  y mensajes efectivamente enviados). Nunca de lo que el
//                  modelo cree recordar.
//   interpretado — derivado por IA. Puede equivocarse, y se le presenta al
//                  agente etiquetado como no confirmado.
//
// Sin campo `vigente`: la vigencia se deriva comparando `actualizadoEn` con
// `Conversacion.atencionDesde` (research D14), así ningún camino de
// transferencia a humano tiene que acordarse de apagar un flag.
model FichaConversacionIA {
  id            String   @id @default(cuid())
  hechos        Json
  interpretado  Json?
  turnos        Int      @default(0)
  actualizadoEn DateTime @default(now()) @updatedAt

  conversacionId String       @unique
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@index([instanciaId])
}

// =====================
// PIPELINES DINÁMICOS
// =====================

model Pipeline {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  esDefault     Boolean  @default(false)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  stages               PipelineStage[]
  oportunidades        Oportunidad[]
  campos               CampoPersonalizado[]
  disparadores         Disparador[]
  workflowAsignaciones WorkflowAsignacion[]
  cuentasCanal         CuentaCanal[]

  @@index([instanciaId])
  @@index([esDefault])
}

model PipelineStage {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  color         String?
  // Nombre del ícono de lucide-react (ej. "UserRound"). Nullable: una etapa
  // sin ícono elegido cae a uno por defecto en el tablero, así que las etapas
  // que ya existen no necesitan backfill. Solo se muestra en el Pipeline.
  icono         String?
  orden         Int
  probabilidad  Int      @default(20)
  esInicial     Boolean  @default(false)
  esGanado      Boolean  @default(false)
  esPerdido     Boolean  @default(false)
  // Solo aplica a etapas esGanado/esPerdido: permite ocultarlas como columna
  // del kanban sin perder la posibilidad de mover una oportunidad a esa etapa
  // (drag&drop directo o vía el popover "Mover a").
  visible       Boolean  @default(true)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  respuestaIAHabilitada Boolean         @default(false)
  agenteIAConfigId      String?
  agenteIAConfig        AgenteIAConfig? @relation(fields: [agenteIAConfigId], references: [id], onDelete: SetNull)

  oportunidades             Oportunidad[]
  campos                    CampoPersonalizado[]
  disparadores              Disparador[]
  workflowAsignaciones      WorkflowAsignacion[]
  cuentasCanal              CuentaCanal[]        @relation("CuentaCanalStageEntrada")
  cuentasCanalRespuestaAuto CuentaCanal[]        @relation("CuentaCanalStageRespuesta")

  @@unique([pipelineId, orden])
  @@index([pipelineId])
}

// =====================
// OPORTUNIDADES
// =====================

model Oportunidad {
  id                  String    @id @default(cuid())
  titulo              String
  descripcion         String?
  valor               Decimal   @default(0)
  moneda              String    @default("PEN")
  etapa               Etapa     @default(PROSPECTO)
  probabilidad        Int       @default(20)
  fechaCierre         DateTime?
  fechaGanada         DateTime?
  fechaPerdida        DateTime?
  notas               String?
  motivoPerdida       String?
  metadata            Json?
  nuevoMensaje        Boolean   @default(false)
  ultimaInteraccionEn DateTime?

  /// 034 — Bandera derivada: la oportunidad nació de un remitente de correo
  /// todavía sin aprobar. Se desnormaliza acá para que el Kanban la distinga
  /// con su `select` fijo por etapa, sin una consulta por columna.
  aprobacionPendiente Boolean  @default(false)
  creadoEn            DateTime @default(now())
  actualizadoEn       DateTime @updatedAt

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  // Pipeline dinámico (opcional, convive con etapa enum)
  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id])

  stageId String?
  stage   PipelineStage? @relation(fields: [stageId], references: [id])

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  contactos             OportunidadContacto[]
  productos             OportunidadProducto[]
  actividades           Actividad[]
  cotizaciones          Cotizacion[]
  pedidos               Pedido[]
  tags                  OportunidadTag[]
  campos                CampoPersonalizadoValor[]
  disparadorJobs        DisparadorJob[]
  historialEtapas       OportunidadHistorialEtapa[]
  workflowEjecuciones   WorkflowEjecucion[]
  conversaciones        OportunidadConversacion[]
  conversacionesGanadas Conversacion[]              @relation("ConvOportunidadGanada")

  @@index([instanciaId])
  @@index([instanciaId, id])
  @@index([pipelineId])
  @@index([stageId])
  @@index([empresaId])
  @@index([etapa])
  @@index([instanciaId, aprobacionPendiente])
}

// Una fila por cada cambio de etapa del pipeline dinámico, venga de donde
// venga (ver moverOportunidadAEtapa). `procesadoWorkflowEn` lo usará el motor
// de Workflows como outbox de respaldo (docs/WORKFLOWS-PROPUESTA-ARQUITECTURA.md).
model OportunidadHistorialEtapa {
  id                  String                @id @default(cuid())
  stageAnteriorId     String?
  stageNuevoId        String
  pipelineId          String
  origen              OrigenMovimientoEtapa
  usuarioId           String?
  ejecucionWorkflowId String?
  motivo              String?
  procesadoWorkflowEn DateTime?
  creadoEn            DateTime              @default(now())

  oportunidadId String
  oportunidad   Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)
  instanciaId   String

  @@index([oportunidadId, creadoEn])
  @@index([instanciaId, creadoEn])
  @@index([procesadoWorkflowEn])
}

// =====================
// WORKFLOWS (docs/WORKFLOWS-PROPUESTA-ARQUITECTURA.md)
// =====================

enum EstadoWorkflow {
  BORRADOR
  PUBLICADO
  INACTIVO
}

enum TipoDisparadorWorkflow {
  ENTRADA_ETAPA
  MENSAJE_RECIBIDO
  CONVERSACION_CREADA
  OPORTUNIDAD_CREADA
  PEDIDO_CREADO
  // "Ejecutar otro Workflow" y el simulador
  MANUAL
}

model Workflow {
  id            String         @id @default(cuid())
  nombre        String
  descripcion   String?
  estado        EstadoWorkflow @default(BORRADOR)
  // DefinicionWorkflow editable (src/workflows/definicion/schema.ts). Las
  // ejecuciones NUNCA leen esto: usan una WorkflowVersion publicada.
  borrador      Json
  configuracion Json?

  versionPublicadaId String?          @unique
  versionPublicada   WorkflowVersion? @relation("VersionVigente", fields: [versionPublicadaId], references: [id])

  creadoPorId      String?
  actualizadoPorId String?
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  versiones    WorkflowVersion[]    @relation("VersionesDeWorkflow")
  ejecuciones  WorkflowEjecucion[]
  asignaciones WorkflowAsignacion[]

  @@unique([instanciaId, nombre])
  @@index([instanciaId, estado])
}

// Inmutable una vez creada: publicar siempre crea una versión nueva.
model WorkflowVersion {
  id             String   @id @default(cuid())
  numero         Int
  definicion     Json
  publicadaEn    DateTime @default(now())
  publicadaPorId String?

  workflowId  String
  workflow    Workflow            @relation("VersionesDeWorkflow", fields: [workflowId], references: [id], onDelete: Cascade)
  vigenteDe   Workflow?           @relation("VersionVigente")
  ejecuciones WorkflowEjecucion[]
  instanciaId String

  @@unique([workflowId, numero])
  @@index([instanciaId])
}

// Dónde y ante qué evento corre un Workflow. Una sola asignación activa de
// tipo ENTRADA_ETAPA por etapa (índice parcial en la migración).
model WorkflowAsignacion {
  id         String                 @id @default(cuid())
  disparador TipoDisparadorWorkflow
  activo     Boolean                @default(true)
  // ConditionTree opcional para acotar cuándo aplica (p.ej. solo un canal).
  filtros    Json?
  creadoEn   DateTime               @default(now())

  workflowId String
  workflow   Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  pipelineId String?
  pipeline   Pipeline?      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId    String?
  stage      PipelineStage? @relation(fields: [stageId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@index([instanciaId, disparador, activo])
  @@index([workflowId])
  @@index([stageId])
}

enum EstadoEjecucionWorkflow {
  EJECUTANDO
  ESPERANDO_RESPUESTA
  ESPERANDO_TIMER
  // p.ej. respuesta de IA pendiente de revisión humana (autonomía)
  ESPERANDO_ACCION_EXTERNA
  IA_ACTIVA
  // Pausada porque un humano tomó la conversación; se puede retomar (D6).
  TRANSFERIDA_HUMANO
  COMPLETADA
  FALLIDA
  CANCELADA
}

enum TipoEsperaWorkflow {
  TIMER
  RESPUESTA
  IA
  REVISION
  // Reintento programado de un nodo que falló por un error transitorio.
  REINTENTO
}

// Una ejecución de una versión publicada (inmutable) de un Workflow.
model WorkflowEjecucion {
  id     String                  @id @default(cuid())
  estado EstadoEjecucionWorkflow @default(EJECUTANDO)

  nodoActualId String?
  // { variables: {...}, meta: {...} } — variables del Workflow y datos de
  // control de los nodos (intentos, interacciones de IA, inicio de espera).
  contexto     Json
  esperaTipo   TipoEsperaWorkflow?
  esperaDesde  DateTime?
  esperaHasta  DateTime?

  ultimoMensajeProcesadoId String?
  intentosNodo             Int     @default(0)

  // Lease: quién la está procesando y hasta cuándo (sin locks largos).
  bloqueadoHasta DateTime?
  bloqueadoPor   String?

  claveIdempotencia    String                 @unique
  controlaConversacion Boolean                @default(false)
  // Cadena de ejecuciones (Mover etapa → Workflow de la etapa siguiente,
  // Ejecutar otro Workflow): límite contra bucles.
  profundidad          Int                    @default(0)
  disparador           TipoDisparadorWorkflow
  stageId              String?

  resultado         String?
  error             String?
  motivoCancelacion String?
  iniciadaEn        DateTime  @default(now())
  actualizadaEn     DateTime  @updatedAt
  finalizadaEn      DateTime?

  workflowId String
  workflow   Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  versionId  String
  version    WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  oportunidadId  String?
  oportunidad    Oportunidad?  @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)
  conversacionId String?
  conversacion   Conversacion? @relation(fields: [conversacionId], references: [id], onDelete: SetNull)
  contactoId     String?

  ejecucionOrigenId String?
  ejecucionOrigen   WorkflowEjecucion?  @relation("CadenaEjecuciones", fields: [ejecucionOrigenId], references: [id], onDelete: SetNull)
  ejecucionesHijas  WorkflowEjecucion[] @relation("CadenaEjecuciones")

  instanciaId String

  pasos WorkflowEjecucionPaso[]

  @@index([estado, esperaHasta])
  @@index([estado, bloqueadoHasta])
  @@index([oportunidadId, estado])
  @@index([conversacionId, estado])
  @@index([instanciaId, workflowId, iniciadaEn])
}

// Historial de la ejecución y, a la vez, garantía de idempotencia: el paso
// se registra ANTES del efecto (enviar, mover, crear tarea); si el motor se
// reintenta, el unique evita repetir el efecto.
model WorkflowEjecucionPaso {
  id         String   @id @default(cuid())
  nodoId     String
  tipoNodo   String
  iteracion  Int      @default(0)
  // EJECUTANDO | OK | ERROR | ESPERANDO | INTERRUMPIDO
  estado     String
  salida     String?
  resultado  Json?
  error      String?
  duracionMs Int?
  ocurridoEn DateTime @default(now())

  ejecucionId String
  ejecucion   WorkflowEjecucion @relation(fields: [ejecucionId], references: [id], onDelete: Cascade)
  instanciaId String

  @@unique([ejecucionId, nodoId, iteracion])
  @@index([ejecucionId, ocurridoEn])
}

model OportunidadContacto {
  oportunidadId String
  contactoId    String
  principal     Boolean @default(false)

  oportunidad Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)
  contacto    Contacto    @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  @@id([oportunidadId, contactoId])
  @@index([oportunidadId, principal])
  // 041 — señal comercial de "Interesado"
  @@index([contactoId])
}

model OportunidadProducto {
  id             String  @id @default(cuid())
  descripcion    String?
  cantidad       Decimal @default(1)
  precioUnitario Decimal
  descuento      Decimal @default(0)
  subtotal       Decimal @default(0)

  oportunidadId String
  oportunidad   Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)

  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id])
}

// =====================
// TAGS POR INSTANCIA
// =====================

model Tag {
  id       String   @id @default(cuid())
  nombre   String
  color    String?
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now())

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  oportunidades OportunidadTag[]
  contactos     ContactoTag[]

  @@index([instanciaId])
}

model OportunidadTag {
  oportunidadId String
  tagId         String

  oportunidad Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([oportunidadId, tagId])
}

model ContactoTag {
  contactoId String
  tagId      String

  contacto Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactoId, tagId])
}

// Etiquetas del catálogo de productos (Esfera, Base, Pequeña…). Lista propia,
// separada de Tag: no se mezclan con las etiquetas de contactos/oportunidades.
model EtiquetaProducto {
  id       String   @id @default(cuid())
  nombre   String
  color    String?
  creadoEn DateTime @default(now())

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  productos ProductoEtiqueta[]

  @@unique([instanciaId, nombre])
}

model ProductoEtiqueta {
  productoId String
  etiquetaId String

  producto Producto         @relation(fields: [productoId], references: [id], onDelete: Cascade)
  etiqueta EtiquetaProducto @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@id([productoId, etiquetaId])
  @@index([etiquetaId])
}

// =====================
// CAMPOS PERSONALIZADOS
// =====================

model CampoPersonalizado {
  id            String                    @id @default(cuid())
  nombre        String
  clave         String
  descripcion   String?
  tipo          TipoCampoPersonalizado
  entidad       EntidadCampoPersonalizado
  requerido     Boolean                   @default(false)
  bloqueado     Boolean                   @default(false)
  activo        Boolean                   @default(true)
  orden         Int                       @default(0)
  opciones      Json?
  validaciones  Json?
  valorDefault  Json?
  visibleEn     Json?
  requeridoEn   Json?
  bloqueadoEn   Json?
  creadoEn      DateTime                  @default(now())
  actualizadoEn DateTime                  @updatedAt

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  stageId String?
  stage   PipelineStage? @relation(fields: [stageId], references: [id], onDelete: Cascade)

  valores CampoPersonalizadoValor[]

  @@index([instanciaId])
  @@index([entidad])
  @@index([pipelineId])
  @@index([stageId])
}

model CampoPersonalizadoValor {
  id    String @id @default(cuid())
  valor Json?

  campoId String
  campo   CampoPersonalizado @relation(fields: [campoId], references: [id], onDelete: Cascade)

  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)

  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  pedidoId String?
  pedido   Pedido? @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  cotizacionId String?
  cotizacion   Cotizacion? @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([campoId])
  @@index([oportunidadId])
  @@index([contactoId])
  @@index([empresaId])
  @@index([pedidoId])
  @@index([cotizacionId])
}

// =====================
// PRODUCTOS
// =====================

model Producto {
  id                 String       @id @default(cuid())
  sku                String?
  nombre             String
  descripcion        String?
  precio             Decimal      @default(0)
  moneda             String       @default("PEN")
  categoria          String?
  // Determina qué bloque de cumplimiento usa una Cotización/Pedido que
  // incluya este producto — ver TipoProducto, ServicioCotizacion/Pedido y
  // EntregaDigitalCotizacion/Pedido.
  tipo               TipoProducto @default(FISICO)
  unidad             String       @default("unidad")
  imagenUrl          String?
  activo             Boolean      @default(true)
  manejaStock        Boolean      @default(false)
  cantidadDisponible Decimal      @default(0)
  // 029-combos-productos-compuestos — un combo no tiene stock propio (se
  // fuerza manejaStock=false): su disponibilidad se deriva de los
  // componentes. "Venta directa" es independiente de "es combo": un
  // componente puede ocultarse del selector de pedidos y seguir usándose.
  esCombo            Boolean      @default(false)
  ventaDirecta       Boolean      @default(true)
  // 030-variantes-producto — opt-in. Con variantes, la fuente de verdad del
  // stock es cada ProductoVariante y `cantidadDisponible` queda en 0 (nunca
  // stock de producto + stock de variantes). Los atributos son configuración
  // ([{ nombre, valores[] }]); lo que se vende y se referencia es la variante.
  tieneVariantes     Boolean      @default(false)
  atributosVariantes Json?
  metadata           Json?
  creadoEn           DateTime     @default(now())
  actualizadoEn      DateTime     @updatedAt

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  oportunidadLineas OportunidadProducto[]
  cotizacionLineas  CotizacionLinea[]
  pedidoLineas      PedidoLinea[]
  // Plantilla de entrega digital — solo se usa cuando tipo = DIGITAL. Se
  // copia como snapshot independiente a cada línea que use este producto
  // (ver EntregaDigitalCotizacion/Pedido); editar esto después NUNCA
  // cambia una Cotización/Pedido ya creada.
  entregaDigital    ProductoEntregaDigital?

  // 014-conversaciones-piloto-ejemplos-relevantes
  conversacionesPiloto     ConversacionPiloto[]
  ejemplosPrompt           EjemploPrompt[]
  // 017-aprendizaje-supervisado-auditoria
  respuestasIdentificadoEn RespuestaPendienteRevision[] @relation("RespuestasProductoIdentificado")

  // 029-combos-productos-compuestos
  componentes   ProductoComponente[] @relation("ComboComponentes")
  usadoEnCombos ProductoComponente[] @relation("ComponenteDeCombos")

  // 030-variantes-producto
  variantes ProductoVariante[]

  // Etiquetas propias del catálogo (separadas de las Tag del CRM).
  etiquetas ProductoEtiqueta[]

  @@index([instanciaId])
  @@index([sku])
  @@index([nombre])
  @@index([categoria])
}

// Valores por defecto de entrega digital de un Producto — ver comentario en
// Producto.entregaDigital. Todos los campos abiertos/opcionales, igual
// criterio que EntregaDigitalCotizacion/Pedido. Sin `email` a propósito: el
// email es del comprador, no del producto.
// 029-combos-productos-compuestos — un nivel: el componente nunca es combo
// (se valida en el servidor), así que un ciclo es imposible por construcción.
// Restrict sobre el componente: los productos se desactivan (activo=false),
// no se borran; un borrado físico no debe dejar combos rotos en silencio.
// 030-variantes-producto — cada combinación de valores de atributos de un
// producto. `clave` es la combinación normalizada (minúsculas, sin espacios
// sobrantes, en el orden de los atributos) y garantiza que no se repita.
// `precio` null = usa el precio del producto. El control de stock lo decide
// Producto.manejaStock para todas sus variantes.
model ProductoVariante {
  id                 String   @id @default(cuid())
  valores            Json
  clave              String
  nombre             String
  sku                String?
  precio             Decimal?
  cantidadDisponible Decimal  @default(0)
  activo             Boolean  @default(true)
  orden              Int      @default(0)
  creadoEn           DateTime @default(now())
  actualizadoEn      DateTime @updatedAt

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  pedidoLineas     PedidoLinea[]
  cotizacionLineas CotizacionLinea[]

  @@unique([productoId, clave])
  @@index([productoId])
}

model ProductoComponente {
  id       String @id @default(cuid())
  cantidad Int

  comboId      String
  combo        Producto @relation("ComboComponentes", fields: [comboId], references: [id], onDelete: Cascade)
  componenteId String
  componente   Producto @relation("ComponenteDeCombos", fields: [componenteId], references: [id], onDelete: Restrict)

  creadoEn DateTime @default(now())

  @@unique([comboId, componenteId])
  @@index([componenteId])
}

model ProductoEntregaDigital {
  id                  String                @id @default(cuid())
  metodo              MetodoEntregaDigital?
  url                 String?
  archivo             String?
  codigo              String?
  usuarioAcceso       String?
  instrucciones       String?
  observaciones       String?
  requiereSeguimiento Boolean               @default(false)
  tipoSeguimiento     String?
  creadoEn            DateTime              @default(now())
  actualizadoEn       DateTime              @updatedAt

  productoId String   @unique
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId])
}

// =====================
// ACTIVIDADES
// =====================

model Actividad {
  id            String             @id @default(cuid())
  tipo          TipoActividad      @default(TAREA)
  prioridad     PrioridadActividad @default(MEDIA)
  titulo        String
  descripcion   String?
  fecha         DateTime
  completada    Boolean            @default(false)
  completadaEn  DateTime?
  metadata      Json?
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt

  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id])

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id])

  pedidoId String?
  pedido   Pedido? @relation(fields: [pedidoId], references: [id])

  cotizacionId String?
  cotizacion   Cotizacion? @relation(fields: [cotizacionId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  @@index([instanciaId])
  @@index([fecha])
  @@index([completada])
  @@index([pedidoId])
  @@index([cotizacionId])
  // 041 — actividad pendiente vencida / vigente por contacto (seguimiento)
  @@index([contactoId, completada, fecha])
}

// =====================
// COTIZACIONES
// =====================

model Cotizacion {
  id               String           @id @default(cuid())
  numero           String
  estado           EstadoCotizacion @default(BORRADOR)
  fechaEmision     DateTime         @default(now())
  fechaVencimiento DateTime?
  subtotal         Decimal          @default(0)
  descuento        Decimal          @default(0)
  impuesto         Decimal          @default(0)
  // Costo de envío — se suma al `total` (lo que paga el cliente) pero se
  // excluye a propósito de los KPIs "Total ventas"/"Total ventas · mes
  // actual" de Pedidos (no es ganancia, ver obtenerPedidosKpis).
  costoEnvio       Decimal          @default(0)
  total            Decimal          @default(0)
  moneda           String           @default("PEN")
  notas            String?
  metadata         Json?
  // Calculado en el servidor a partir del producto de la primera línea que
  // tenga uno vinculado (FISICO si ninguna línea tiene producto) — nunca lo
  // manda el cliente. Determina cuál de entrega/servicio/entregaDigital usa
  // esta cotización. Ver resolverTipoCumplimiento en actions.ts.
  tipoCumplimiento TipoProducto     @default(FISICO)
  creadoEn         DateTime         @default(now())
  actualizadoEn    DateTime         @updatedAt

  // --- 015-herramientas-operativas-inventario-envios-acciones ---
  // Defaults preservan el comportamiento actual: un documento creado por un
  // humano queda indistinguible de uno anterior a esta spec.
  generadoPorIA       Boolean @default(false)
  confirmadoPorHumano Boolean @default(true)

  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id])

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  confirmadoPorUsuarioId String?
  confirmadoPorUsuario   Usuario? @relation("CotizacionesConfirmadasPorUsuario", fields: [confirmadoPorUsuarioId], references: [id], onDelete: SetNull)

  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  lineas      CotizacionLinea[]
  pedidos     Pedido[]
  campos      CampoPersonalizadoValor[]
  actividades Actividad[]
  // entrega/servicio: solo una existe a la vez, según tipoCumplimiento —
  // sin cambios. entregaDigital ya NO vive acá: pasó a CotizacionLinea
  // (una cotización puede tener varios productos DIGITAL, cada uno con su
  // propia entrega — ver CotizacionLinea.entregaDigital).
  entrega     EntregaCotizacion?
  servicio    ServicioCotizacion?

  @@unique([instanciaId, numero])
  @@index([instanciaId])
  @@index([estado])
  @@index([oportunidadId])
  // 041 — señal comercial de "Interesado"
  @@index([contactoId])
}

// Espejo de EntregaPedido — se captura ya en la cotización para que, al
// aprobarla y generar el Pedido, la información de entrega pase directo sin
// que el usuario tenga que volver a registrarla (ver aprobarCotizacion).
// A esta altura (cotización, antes de despachar nada) todavía no existen
// numeroGuia/urlSeguimiento — esos se completan recién en el Pedido.
// Solo aplica cuando Cotizacion.tipoCumplimiento = FISICO.
model EntregaCotizacion {
  id            String        @id @default(cuid())
  metodoEntrega MetodoEntrega @default(COURIER_EXTERNO)
  estadoEntrega EstadoEntrega @default(PENDIENTE)
  fechaEstimada DateTime?
  observaciones String?
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt

  cotizacionId String     @unique
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  transportistaId String?
  transportista   Transportista? @relation(fields: [transportistaId], references: [id])

  // 019-cobertura-geografica-envios — ubicación de destino, capturada al
  // crear la cotización. paisId es opcional: en modo UN_SOLO_PAIS no se pide
  // (se asume ConfiguracionEmpresa.paisOperacionId). Ciudad es texto libre,
  // refinamiento opcional (nunca requerido para encontrar costo).
  paisId String?
  pais   Pais?   @relation(fields: [paisId], references: [id])

  estadoProvinciaId String?
  estadoProvincia   EstadoProvincia? @relation(fields: [estadoProvinciaId], references: [id])

  ciudad String?

  // Exigidos por CondicionesTransportista del transportista elegido:
  // requiereDireccionCompleta pide direccionEntrega (la calle, no solo la
  // ciudad) y requiereIdentificacion pide identificacion (texto libre: cédula,
  // pasaporte o RUC, según el país). Nullable y nunca bloquean el guardado
  // —se avisa en el formulario— pero sí bloquean aprobarCotizacion, igual
  // que "costo de entrega por confirmar".
  direccionEntrega String?
  identificacion   String?

  // Quién recibe físicamente el envío. Distinto del `destinatario` que vive
  // en Cotizacion.metadata: ese es el cliente al que va dirigida la
  // cotización (sección "Información general"), y quien recibe en la puerta
  // puede ser otra persona — recepción, un familiar, el encargado del local.
  // Opcional: la inmensa mayoría de los envíos van a nombre del comprador.
  nombreDestinatario String?

  // 022-transportistas-zonas-tarifas — snapshot de envío (FR-041/046, ver
  // data-model.md). corregimiento/sectorOCodigoPostal son nuevos niveles de
  // destino junto a ciudad (distrito/ciudad).
  corregimiento       String?
  sectorOCodigoPostal String?

  zonaEntregaId           String?
  zonaEntrega             ZonaEntrega? @relation(fields: [zonaEntregaId], references: [id])
  zonaAsignadaManualmente Boolean      @default(false)

  servicioTransportistaId String?
  servicioTransportista   ServicioTransportista? @relation(fields: [servicioTransportistaId], references: [id])

  tarifaTransportistaZonaId String?
  tarifaTransportistaZona   TarifaTransportistaZona? @relation(fields: [tarifaTransportistaZonaId], references: [id])

  // Snapshot del costo interno al crear el documento — solo visible con
  // permiso financiero (FR-042/050); costoEnvio (raíz de Cotizacion) sigue
  // siendo el precio al cliente, sin cambio de significado (Decisión 6).
  costoInternoEnvio          Decimal?
  // false = "Costo de entrega por confirmar" (FR-039/044); default true
  // preserva el comportamiento de toda fila existente antes de esta feature.
  costoEnvioConfirmado       Boolean  @default(true)
  costoManualAutorizadoPorId String?

  @@index([cotizacionId])
  @@index([estadoProvinciaId])
  @@index([zonaEntregaId])
  @@index([servicioTransportistaId])
  @@index([tarifaTransportistaZonaId])
}

// Cumplimiento cuando Cotizacion.tipoCumplimiento = SERVICIO — espejo de
// ServicioPedido. Todos los campos abiertos/opcionales a propósito: las
// reglas de obligatoriedad se resuelven después desde el Flujo de Venta.
model ServicioCotizacion {
  id            String             @id @default(cuid())
  modalidad     ModalidadServicio?
  fecha         DateTime?
  hora          String?
  duracion      String?
  ubicacion     String?
  direccion     String?
  responsable   String?
  instrucciones String?
  observaciones String?
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt

  cotizacionId String     @unique
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@index([cotizacionId])
}

// Cumplimiento cuando la línea usa un producto DIGITAL — espejo de
// EntregaDigitalPedido. Todos los campos abiertos/opcionales. Anclada a la
// LÍNEA (no a la cotización completa): una cotización con varios productos
// DIGITAL distintos tiene una fila independiente por cada uno — se copia
// como snapshot desde Producto.entregaDigital al agregar la línea, y queda
// totalmente editable sin depender del producto (ver actions.ts).
model EntregaDigitalCotizacion {
  id              String                @id @default(cuid())
  metodo          MetodoEntregaDigital?
  email           String?
  url             String?
  archivo         String?
  codigo          String?
  usuarioAcceso   String?
  fechaEntrega    DateTime?
  fechaExpiracion DateTime?
  instrucciones   String?
  observaciones   String?
  creadoEn        DateTime              @default(now())
  actualizadoEn   DateTime              @updatedAt

  cotizacionLineaId String          @unique
  cotizacionLinea   CotizacionLinea @relation(fields: [cotizacionLineaId], references: [id], onDelete: Cascade)

  @@index([cotizacionLineaId])
}

model CotizacionLinea {
  id             String  @id @default(cuid())
  descripcion    String?
  cantidad       Decimal
  precioUnitario Decimal
  descuento      Decimal @default(0)
  impuesto       Decimal @default(0)
  subtotal       Decimal
  total          Decimal @default(0)
  orden          Int     @default(0)
  metadata       Json?

  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id])

  // 030-variantes-producto — ver PedidoLinea.varianteId.
  varianteId     String?
  variante       ProductoVariante? @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  varianteNombre String?

  entregaDigital EntregaDigitalCotizacion?
}

// =====================
// PEDIDOS
// =====================

model Pedido {
  id     String       @id @default(cuid())
  numero String
  estado EstadoPedido @default(PENDIENTE)

  // Datos del comprador (pedido manual sin contacto en sistema)
  nombre        String?
  apellido      String?
  telefono      String?
  email         String?
  ruc           String?
  empresaNombre String?

  fechaPedido      DateTime     @default(now())
  fechaEntrega     DateTime?
  subtotal         Decimal      @default(0)
  descuento        Decimal      @default(0)
  impuesto         Decimal      @default(0)
  // Costo de envío — se suma al `total` (lo que paga el cliente) pero se
  // excluye a propósito de "Total ventas"/"Total ventas · mes actual" en
  // los KPIs del listado (no es ganancia, ver obtenerPedidosKpis).
  costoEnvio       Decimal      @default(0)
  total            Decimal      @default(0)
  moneda           String       @default("PEN")
  notas            String?
  metadata         Json?
  // Igual que Cotizacion.tipoCumplimiento — se copia directo de la
  // cotización de origen si el pedido nace de una aprobación, o se calcula
  // igual (primera línea con producto) si el pedido se crea directo.
  tipoCumplimiento TipoProducto @default(FISICO)
  creadoEn         DateTime     @default(now())
  actualizadoEn    DateTime     @updatedAt

  // --- 015-herramientas-operativas-inventario-envios-acciones ---
  generadoPorIA       Boolean @default(false)
  confirmadoPorHumano Boolean @default(true)

  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id])

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  confirmadoPorUsuarioId String?
  confirmadoPorUsuario   Usuario? @relation("PedidosConfirmadosPorUsuario", fields: [confirmadoPorUsuarioId], references: [id], onDelete: SetNull)

  cotizacionId String?
  cotizacion   Cotizacion? @relation(fields: [cotizacionId], references: [id])

  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  flujoVentaId String?
  flujoVenta   FlujoVenta? @relation(fields: [flujoVentaId], references: [id])

  flujoVentaEtapaId String?
  flujoVentaEtapa   FlujoVentaEtapa? @relation(fields: [flujoVentaEtapaId], references: [id])

  // 038 — cuándo el pedido se volvió venta. Es el eje de fecha de "Total
  // ventas": una venta se atribuye al período en que se concretó, no al que
  // se creó el pedido.
  //
  // SE SELLA UNA SOLA VEZ: la primera vez que el pedido entra a una etapa con
  // `cuentaComoVenta`, y no se vuelve a tocar. Si hay varias etapas marcadas
  // (p. ej. "Pagado" y "Entregado"), manda la primera a la que llegó; pasar
  // después a la segunda NO mueve la fecha. Tampoco se borra si el pedido
  // vuelve a una etapa que no cuenta: deja de sumar —la pertenencia se deriva
  // siempre de la etapa ACTUAL— pero conserva cuándo se vendió.
  //
  // Consecuencia a tener presente: al sellarse con la configuración vigente,
  // marcar más adelante una etapa ANTERIOR del flujo no reescribe los pedidos
  // ya sellados; solo aplica a los que todavía no cruzaron. Si alguna vez hace
  // falta recalcular, se reconstruye desde PedidoHistorialEtapa.
  //
  // Se escribe en el mismo update/create que `flujoVentaEtapaId` —desde los
  // cuatro sitios que mueven un pedido de etapa— con el mismo instante que la
  // fila de PedidoHistorialEtapa.
  fechaVenta DateTime?

  lineas          PedidoLinea[]
  campos          CampoPersonalizadoValor[]
  historialEtapas PedidoHistorialEtapa[]
  historial       PedidoHistorial[]
  disparadorJobs  DisparadorJob[]
  actividades     Actividad[]
  // entrega/servicio: solo una existe a la vez, según tipoCumplimiento —
  // sin cambios. entregaDigital ya NO vive acá: pasó a PedidoLinea (mismo
  // motivo que en Cotizacion — ver PedidoLinea.entregaDigital).
  entrega         EntregaPedido?
  servicio        ServicioPedido?
  // 026-preparacion-pedidos — eje ortogonal al flujo de venta y a `entrega`.
  preparacion     PreparacionPedido?

  @@unique([instanciaId, numero])
  @@index([instanciaId])
  @@index([estado])
  @@index([flujoVentaEtapaId])
  @@index([telefono])
  @@index([email])
  // Filtros de fecha del listado (?desde/?hasta sobre fechaPedido,
  // ?entregaDesde/?entregaHasta sobre fechaEntrega). Compuestos y con
  // instanciaId primero porque todo `where` arranca por la instancia, y los
  // rangos son semiabiertos sobre la columna cruda —nunca AT TIME ZONE—, que
  // es justo lo que un B-tree puede aprovechar.
  @@index([instanciaId, fechaPedido])
  @@index([instanciaId, fechaEntrega])
  // 038 — eje de "Total ventas"/"Total ventas · mes actual". Mismo criterio
  // que los dos de arriba: instanciaId primero y rango semiabierto sobre la
  // columna cruda, que es lo que el B-tree puede aprovechar.
  @@index([instanciaId, fechaVenta])
  // 041 — EXISTS de "Cliente" por contacto en el listado de Contactos
  @@index([contactoId])
}

model PedidoLinea {
  id             String  @id @default(cuid())
  descripcion    String?
  cantidad       Decimal
  precioUnitario Decimal
  descuento      Decimal @default(0)
  impuesto       Decimal @default(0)
  subtotal       Decimal
  total          Decimal @default(0)
  orden          Int     @default(0)
  metadata       Json?

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id])

  // 030-variantes-producto — variante vendida + su nombre al momento de la
  // venta (snapshot: el historial no cambia si la variante se renombra o se
  // desactiva). Restrict: una variante con historial nunca se borra.
  varianteId     String?
  variante       ProductoVariante? @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  varianteNombre String?

  entregaDigital EntregaDigitalPedido?

  // 029-combos-productos-compuestos — composición del combo al crear la línea
  // ([{ productoId, nombre, cantidad }]). Inmutable: las ediciones del pedido
  // devuelven/descuentan stock con esto, nunca con la composición vigente
  // del combo. null = la línea consume su propio productoId (como siempre).
  composicionCombo Json?

  // 026-preparacion-pedidos — avance por ítem. Decimal (no Boolean) para
  // admitir parciales ("preparé 2 de 3"). El avance del PEDIDO es derivado
  // (todas las líneas completas), nunca persistido: un segundo lugar donde
  // guardarlo sería un segundo lugar que se puede desincronizar.
  cantidadPreparada Decimal   @default(0)
  preparadaEn       DateTime?
  preparadaPorId    String?
  preparadaPor      Usuario?  @relation("LineasPreparadasPorUsuario", fields: [preparadaPorId], references: [id], onDelete: SetNull)
}

// =====================
// ENTREGA Y TRANSPORTISTAS
// =====================

model Transportista {
  id            String            @id @default(cuid())
  nombre        String
  tipo          TipoTransportista @default(COURIER_EXTERNO)
  activo        Boolean           @default(true)
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt

  // 022-transportistas-zonas-tarifas — datos de contacto operativo (FR-004)
  personaContacto   String?
  telefono          String?
  correoElectronico String?
  notasInternas     String?

  // 023-transportistas-por-pais — nullable a nivel de BD (research.md
  // Decisión 2): obligatorio por regla de negocio para transportistas
  // nuevos (ver schema.ts); un transportista existente puede quedar sin
  // país ("país pendiente") hasta completarse. Se bloquea (solo lectura)
  // en cuanto el transportista tiene alguna TarifaTransportistaZona
  // (research.md Decisión 3, aplicado en actions.ts).
  paisId String?
  pais   Pais?   @relation(fields: [paisId], references: [id], onDelete: Restrict)

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  entregas           EntregaPedido[]
  entregasCotizacion EntregaCotizacion[]

  // 022-transportistas-zonas-tarifas — reemplaza coberturaGeografica (retirada, ver ZonaEntrega/TarifaTransportistaZona)
  servicios   ServicioTransportista[]
  zonas       ZonaEntrega[]
  tarifas     TarifaTransportistaZona[]
  condiciones CondicionesTransportista?

  @@index([instanciaId])
  @@index([paisId])
}

// --- 022-transportistas-zonas-tarifas ---
// Catálogo reutilizable por empresa de zonas de entrega, independiente de
// cualquier transportista (FR-009) — reemplaza TransportistaCoberturaGeografica
// (research.md Decisión 1).
model ZonaEntrega {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  activa        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  // Las zonas son de UN transportista, no del catálogo de la empresa.
  //
  // Antes eran compartidas (@@unique([instanciaId, nombre])) con la idea de
  // que "Coclé" es el mismo lugar reparta quien reparta, y cada transportista
  // le ponía su tarifa. En la práctica eso significaba que importar destinos
  // para un transportista modificaba la cobertura de otro: resolverZona
  // reutilizaba la zona existente por nombre y le agregaba las ubicaciones
  // del archivo, así que el otro transportista pasaba a cubrir lugares que
  // nadie le configuró. Además, la pestaña de un transportista listaba las
  // zonas de todos los demás como "sin tarifa".
  //
  // Cascade igual que TarifaTransportistaZona: borrar un transportista se
  // lleva sus zonas.
  transportistaId String
  transportista   Transportista @relation(fields: [transportistaId], references: [id], onDelete: Cascade)

  ubicaciones        ZonaEntregaUbicacion[]
  tarifas            TarifaTransportistaZona[]
  entregasCotizacion EntregaCotizacion[]
  entregasPedido     EntregaPedido[]

  @@unique([transportistaId, nombre])
  @@index([instanciaId])
  @@index([transportistaId])
}

// Un punto geográfico dentro de una zona (FR-010/FR-011). País es catálogo
// obligatorio; el resto es texto libre — un nivel vacío actúa como comodín
// (research.md Decisión 2/3).
model ZonaEntregaUbicacion {
  id String @id @default(cuid())

  zonaEntregaId String
  zonaEntrega   ZonaEntrega @relation(fields: [zonaEntregaId], references: [id], onDelete: Cascade)

  paisId String
  pais   Pais   @relation(fields: [paisId], references: [id])

  provinciaEstado     String?
  distritoCiudad      String?
  corregimiento       String?
  sectorOCodigoPostal String?

  // 024-alias-ubicaciones-transportistas — etiqueta legible calculada a
  // partir de los niveles no vacíos (ej. "Panamá > Panamá > San Francisco") y
  // su versión normalizada para búsqueda (FR-001). Nullable en esta migración
  // (backfill vía scripts/backfill-normalizar-ubicaciones.ts, luego NOT NULL
  // en una migración de seguimiento — mismo patrón que Transportista.paisId
  // en 023). El motor de matching (resolver-costo-envio.ts) sigue comparando
  // nivel por nivel — estos campos son solo para mostrar/buscar la fila como
  // una unidad en UI e importación, nunca para resolver cobertura.
  nombreVisible     String?
  nombreNormalizado String?

  aliases AliasUbicacion[]

  @@index([zonaEntregaId])
  @@index([paisId])
  @@index([nombreNormalizado])
}

// 024-alias-ubicaciones-transportistas — nombre alternativo por el que puede
// reconocerse UN nivel geográfico puntual de una ZonaEntregaUbicacion ya
// existente (error ortográfico común, abreviatura, forma coloquial). No crea
// destinos nuevos — solo amplía cómo puede nombrarse uno ya configurado
// (FR-002).
enum CampoUbicacion {
  PROVINCIA_ESTADO
  DISTRITO_CIUDAD
  CORREGIMIENTO
  SECTOR_O_CODIGO_POSTAL
}

model AliasUbicacion {
  id String @id @default(cuid())

  zonaEntregaUbicacionId String
  zonaEntregaUbicacion   ZonaEntregaUbicacion @relation(fields: [zonaEntregaUbicacionId], references: [id], onDelete: Cascade)

  // A qué nivel de la ubicación se refiere el alias — un alias de
  // CORREGIMIENTO solo se compara contra destino.corregimiento, aunque ambos
  // campos vivan en la misma fila de ZonaEntregaUbicacion.
  campo CampoUbicacion

  valor            String // texto tal como lo ingresó el usuario (para mostrarlo)
  valorNormalizado String // normalizarUbicacion(valor) — usado para el match por ALIAS

  // Denormalizado desde zonaEntrega.instanciaId — evita un join de 2 saltos
  // en cada búsqueda de matching (corre en cada consulta de la tool de IA) y
  // habilita el índice de unicidad por instancia (FR-003).
  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  creadoEn DateTime @default(now())

  @@unique([instanciaId, campo, valorNormalizado])
  @@index([zonaEntregaUbicacionId])
  @@index([instanciaId, valorNormalizado])
}

// Modalidad de envío ofrecida por un transportista concreto (FR-016) —
// sembrada con Estándar/Express/Personalizado al crear el transportista.
model ServicioTransportista {
  id          String  @id @default(cuid())
  nombre      String
  descripcion String?
  activo      Boolean @default(true)

  transportistaId String
  transportista   Transportista @relation(fields: [transportistaId], references: [id], onDelete: Cascade)

  tarifas            TarifaTransportistaZona[]
  entregasCotizacion EntregaCotizacion[]
  entregasPedido     EntregaPedido[]

  @@unique([transportistaId, nombre])
  @@index([transportistaId])
}

// Costo/precio/margen para transportista+zona+servicio (FR-015). El margen
// no se almacena — se calcula en cada lectura (research.md Decisión 6).
model TarifaTransportistaZona {
  id               String    @id @default(cuid())
  costoInterno     Decimal
  precioCliente    Decimal
  tiempoMinimoDias Int?
  tiempoMaximoDias Int?
  vigenteDesde     DateTime?
  vigenteHasta     DateTime?
  activa           Boolean   @default(true)
  creadoEn         DateTime  @default(now())
  actualizadoEn    DateTime  @updatedAt

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  transportistaId String
  transportista   Transportista @relation(fields: [transportistaId], references: [id], onDelete: Cascade)

  zonaEntregaId String
  zonaEntrega   ZonaEntrega @relation(fields: [zonaEntregaId], references: [id])

  servicioTransportistaId String
  servicioTransportista   ServicioTransportista @relation(fields: [servicioTransportistaId], references: [id])

  entregasCotizacion EntregaCotizacion[]
  entregasPedido     EntregaPedido[]

  @@unique([transportistaId, zonaEntregaId, servicioTransportistaId])
  @@index([instanciaId])
  @@index([transportistaId, activa])
  @@index([zonaEntregaId])
}

// Reglas generales de operación/restricciones/cobro (FR-029/030/031), 1-1
// con Transportista. No duplica nada que ya viva en la tarifa (FR-033).
model CondicionesTransportista {
  id String @id @default(cuid())

  diasEntrega               Json
  horaLimiteMismoDia        String?
  tiempoPreparacionDias     Int      @default(0)
  permiteEntregaMismoDia    Boolean  @default(true)
  pesoMaximoKg              Decimal?
  // Qué datos del cliente exige este transportista para poder entregar. Se
  // piden en el formulario de cotización/pedido al elegirlo y se validan al
  // aprobar (ver requisitos-transportista.ts, fuente única del criterio).
  requiereDireccionCompleta Boolean  @default(true)
  requiereIdentificacion    Boolean  @default(false)
  permiteArticulosFragiles  Boolean  @default(true)
  permitePagoContraEntrega  Boolean  @default(false)
  observaciones             String?
  metodoPagoTransportista   String?
  frecuenciaFacturacion     String?
  responsableCoordinacion   String?
  instruccionesCoordinacion String?

  transportistaId String        @unique
  transportista   Transportista @relation(fields: [transportistaId], references: [id], onDelete: Cascade)
}

enum TipoEntidadHistorialTransportista {
  TRANSPORTISTA
  TARIFA
  CONDICIONES
  ZONA_MANUAL
  COSTO_MANUAL
}

// Auditoría del módulo de transportistas (FR-051, Historia 6) — mismo
// patrón que PedidoHistorial (research.md Decisión 7).
model TransportistaHistorial {
  id            String                            @id @default(cuid())
  entidadTipo   TipoEntidadHistorialTransportista
  entidadId     String
  accion        String
  valorAnterior Json?
  valorNuevo    Json?
  usuarioId     String?
  usuarioNombre String?
  creadoEn      DateTime                          @default(now())

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@index([instanciaId])
  @@index([entidadTipo, entidadId])
}

// Solo aplica cuando Pedido.tipoCumplimiento = FISICO.
model EntregaPedido {
  id             String        @id @default(cuid())
  metodoEntrega  MetodoEntrega @default(COURIER_EXTERNO)
  estadoEntrega  EstadoEntrega @default(PENDIENTE)
  numeroGuia     String?
  urlSeguimiento String?
  fechaEstimada  DateTime?
  observaciones  String?
  creadoEn       DateTime      @default(now())
  actualizadoEn  DateTime      @updatedAt

  pedidoId String @unique
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  transportistaId String?
  transportista   Transportista? @relation(fields: [transportistaId], references: [id])

  // 019-cobertura-geografica-envios — mismo criterio que EntregaCotizacion;
  // generar-pedido-desde-cotizacion.service.ts copia estos 3 campos igual
  // que ya copia transportistaId/metodoEntrega.
  paisId String?
  pais   Pais?   @relation(fields: [paisId], references: [id])

  estadoProvinciaId String?
  estadoProvincia   EstadoProvincia? @relation(fields: [estadoProvinciaId], references: [id])

  ciudad String?

  // Exigidos por CondicionesTransportista del transportista elegido:
  // requiereDireccionCompleta pide direccionEntrega (la calle, no solo la
  // ciudad) y requiereIdentificacion pide identificacion (texto libre: cédula,
  // pasaporte o RUC, según el país). Nullable y nunca bloquean el guardado
  // —se avisa en el formulario— pero sí bloquean aprobarCotizacion, igual
  // que "costo de entrega por confirmar".
  direccionEntrega String?
  identificacion   String?

  // Quién recibe físicamente el envío — ver EntregaCotizacion.nombreDestinatario.
  nombreDestinatario String?

  // 022-transportistas-zonas-tarifas — snapshot inmutable de envío copiado
  // desde EntregaCotizacion al convertir en pedido (FR-046/047).
  corregimiento       String?
  sectorOCodigoPostal String?

  zonaEntregaId           String?
  zonaEntrega             ZonaEntrega? @relation(fields: [zonaEntregaId], references: [id])
  zonaAsignadaManualmente Boolean      @default(false)

  servicioTransportistaId String?
  servicioTransportista   ServicioTransportista? @relation(fields: [servicioTransportistaId], references: [id])

  tarifaTransportistaZonaId String?
  tarifaTransportistaZona   TarifaTransportistaZona? @relation(fields: [tarifaTransportistaZonaId], references: [id])

  costoInternoEnvio          Decimal?
  costoEnvioConfirmado       Boolean  @default(true)
  costoManualAutorizadoPorId String?

  @@index([pedidoId])
  @@index([estadoProvinciaId])
  @@index([zonaEntregaId])
  @@index([servicioTransportistaId])
  @@index([tarifaTransportistaZonaId])
}

// Cumplimiento cuando Pedido.tipoCumplimiento = SERVICIO — espejo de
// ServicioCotizacion. Todos los campos abiertos/opcionales a propósito:
// las reglas de obligatoriedad se resuelven después desde el Flujo de
// Venta.
model ServicioPedido {
  id            String             @id @default(cuid())
  modalidad     ModalidadServicio?
  fecha         DateTime?
  hora          String?
  duracion      String?
  ubicacion     String?
  direccion     String?
  responsable   String?
  instrucciones String?
  observaciones String?
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt

  pedidoId String @unique
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
}

// Cumplimiento cuando Pedido.tipoCumplimiento = DIGITAL — espejo de
// EntregaDigitalCotizacion. Todos los campos abiertos/opcionales.
// Anclada a la LÍNEA — ver comentario en EntregaDigitalCotizacion (mismo
// motivo: un pedido puede tener varios productos DIGITAL distintos).
model EntregaDigitalPedido {
  id              String                @id @default(cuid())
  metodo          MetodoEntregaDigital?
  email           String?
  url             String?
  archivo         String?
  codigo          String?
  usuarioAcceso   String?
  fechaEntrega    DateTime?
  fechaExpiracion DateTime?
  instrucciones   String?
  observaciones   String?
  creadoEn        DateTime              @default(now())
  actualizadoEn   DateTime              @updatedAt

  pedidoLineaId String      @unique
  pedidoLinea   PedidoLinea @relation(fields: [pedidoLineaId], references: [id], onDelete: Cascade)

  @@index([pedidoLineaId])
}

// =====================
// EVENTOS / AUDITORÍA
// =====================

model EventoLog {
  id          String   @id @default(cuid())
  tipo        String
  payload     Json
  ocurridoEn  DateTime @default(now())
  entidadTipo String?
  entidadId   String?
  usuarioId   String?

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@index([instanciaId])
  @@index([entidadTipo, entidadId])
  @@index([tipo])
  @@index([ocurridoEn])
}

// =====================
// HISTORIAL DE IMPORTACIONES
// =====================

model HistorialImportacion {
  id                String            @id @default(cuid())
  entidad           String
  archivoNombre     String
  archivoTipo       String
  archivoPeso       Int
  totalRegistros    Int
  registrosExitosos Int
  registrosConError Int
  errores           Json
  estado            EstadoImportacion @default(EN_PROCESO)
  fechaCreacion     DateTime          @default(now())

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioId String?

  @@index([instanciaId])
  @@index([fechaCreacion])
}

// =====================
// DISPARADORES (TRIGGERS)
// =====================

model Disparador {
  id            String               @id @default(cuid())
  nombre        String
  activo        Boolean              @default(true)
  orden         Int                  @default(0)
  delayMinutos  Int?
  tipo          TipoAccionDisparador
  config        Json
  creadoEn      DateTime             @default(now())
  actualizadoEn DateTime             @updatedAt

  // Pipeline CRM (oportunidades) — opcionales
  stageId String?
  stage   PipelineStage? @relation(fields: [stageId], references: [id], onDelete: Cascade)

  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  // Flujo de Venta (pedidos) — opcionales
  flujoVentaEtapaId String?
  flujoVentaEtapa   FlujoVentaEtapa? @relation(fields: [flujoVentaEtapaId], references: [id], onDelete: Cascade)

  flujoVentaId String?
  flujoVenta   FlujoVenta? @relation(fields: [flujoVentaId], references: [id], onDelete: Cascade)

  jobs DisparadorJob[]

  @@index([stageId])
  @@index([pipelineId])
  @@index([flujoVentaEtapaId, activo])
  @@index([flujoVentaId])
}

model DisparadorJob {
  id             String              @id @default(cuid())
  estado         EstadoDisparadorJob @default(PENDIENTE)
  ejecutarEn     DateTime
  payload        Json
  resultado      Json?
  error          String?
  creadoEn       DateTime            @default(now())
  procesadoEn    DateTime?
  // Reintentos ante errores transitorios (red, HTTP 5xx) y recuperación de
  // jobs que quedaron en PROCESANDO porque el worker se cayó a mitad.
  intentos       Int                 @default(0)
  bloqueadoHasta DateTime?

  disparadorId String
  disparador   Disparador @relation(fields: [disparadorId], references: [id])

  // Oportunidad (CRM) — opcional
  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)

  // Pedido (Ventas) — opcional
  pedidoId String?
  pedido   Pedido? @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  // Denormalizados para búsqueda rápida
  stageId           String?
  pipelineId        String?
  flujoVentaEtapaId String?
  flujoVentaId      String?

  @@index([estado, ejecutarEn])
  @@index([estado, bloqueadoHasta])
  @@index([oportunidadId, stageId])
  @@index([pedidoId, flujoVentaEtapaId])
  @@index([disparadorId])
}

// =====================
// FLUJO DE VENTA (PEDIDOS)
// =====================

model FlujoVenta {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  esDefault     Boolean  @default(false)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  etapas       FlujoVentaEtapa[]
  pedidos      Pedido[]
  disparadores Disparador[]

  @@index([instanciaId])
}

model FlujoVentaEtapa {
  id                   String   @id @default(cuid())
  nombre               String
  descripcion          String?
  color                String?
  orden                Int      @default(0)
  esInicial            Boolean  @default(false)
  esFinal              Boolean  @default(false)
  esCancelacion        Boolean  @default(false)
  esSecuencial         Boolean  @default(true)
  permiteEditarPedido  Boolean  @default(true)
  permiteEditarEntrega Boolean  @default(false)
  // 038 — los pedidos cuya etapa actual tenga esto en true cuentan en "Total
  // ventas" y "Total ventas · mes actual" del listado de Pedidos.
  //
  // Se lee SIEMPRE en vivo y NUNCA se copia al Pedido, y eso es el requisito,
  // no un detalle: al no persistir lo que depende de la configuración, marcar
  // o desmarcar una etapa se refleja en los KPIs en la siguiente consulta,
  // sin recálculo ni migración. Mismo criterio que
  // src/sales/preparacion/utils/entrada.ts:11.
  cuentaComoVenta      Boolean  @default(false)
  activo               Boolean  @default(true)
  creadoEn             DateTime @default(now())
  actualizadoEn        DateTime @updatedAt

  flujoVentaId String
  flujoVenta   FlujoVenta @relation(fields: [flujoVentaId], references: [id], onDelete: Cascade)

  parentId String?
  parent   FlujoVentaEtapa?  @relation("EtapaTree", fields: [parentId], references: [id])
  children FlujoVentaEtapa[] @relation("EtapaTree")

  pedidos             Pedido[]
  reglas              FlujoVentaRegla[]
  historial           PedidoHistorialEtapa[]
  disparadores        Disparador[]
  // 026-preparacion-pedidos — etapas que hacen entrar pedidos al tablero
  entradasPreparacion FlujoPreparacionEntrada[]

  @@index([flujoVentaId, orden])
  @@index([flujoVentaId])
  @@index([parentId])
}

model FlujoVentaRegla {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  activo        Boolean  @default(true)
  prioridad     Int      @default(0)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Gobierno de la regla — ver Reglas de validación (src/sales/flujo-venta/reglas/)
  estado EstadoFlujoVentaRegla @default(PUBLICADA)

  // Árbol tipado AND/OR (GroupNode/ConditionNode, ver reglas/tipos.ts). Si es
  // null, el evaluador cae al comportamiento legado: AND plano sobre
  // `condiciones` — así las reglas creadas antes de este árbol se siguen
  // evaluando exactamente igual que hoy, sin necesidad de migrar datos.
  arbolCondiciones Json?

  mensajeFallo      String?
  mostrarPendientes Boolean @default(true)
  version           Int     @default(1)

  // Auditoría — string plano (sin FK), mismo patrón que
  // PedidoHistorialEtapa.usuarioId.
  creadoPorId      String?
  actualizadoPorId String?

  etapaDestinoId String
  etapaDestino   FlujoVentaEtapa @relation(fields: [etapaDestinoId], references: [id], onDelete: Cascade)

  // Tabla legada — sigue sirviendo a las reglas sin `arbolCondiciones`.
  condiciones FlujoVentaReglaCondicion[]

  @@index([etapaDestinoId])
}

model FlujoVentaReglaCondicion {
  id       String            @id @default(cuid())
  campo    String
  operador OperadorCondicion
  valor    String

  reglaId String
  regla   FlujoVentaRegla @relation(fields: [reglaId], references: [id], onDelete: Cascade)

  @@index([reglaId])
}

model PedidoHistorialEtapa {
  id                  String              @id @default(cuid())
  etapaNombre         String
  etapaAnteriorNombre String?
  tipo                TipoMovimientoEtapa
  origen              String              @default("SISTEMA")
  notas               String?
  referencia          String?
  usuarioNombre       String?
  creadoEn            DateTime            @default(now())

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  etapaId String
  etapa   FlujoVentaEtapa @relation(fields: [etapaId], references: [id])

  usuarioId String?

  @@index([pedidoId])
  @@index([etapaId])
}

// =====================
// PREPARACIÓN DE PEDIDOS (026-preparacion-pedidos)
// =====================
// Eje propio, independiente del Flujo de Venta: mover un pedido acá NO cambia
// su etapa comercial, y mover la etapa comercial NO cambia su preparación.
// La pertenencia al tablero se DERIVA de la etapa del pedido (ver
// FlujoPreparacionEntrada) y la fila de PreparacionPedido se materializa
// perezosamente — `flujoVentaEtapaId` se escribe desde 4 lugares distintos
// (motor de etapas, ejecutor de disparadores, conversión de cotización y
// creación manual de pedido), así que engancharse a uno solo dejaría pedidos
// fuera del tablero (research.md Decisión 1).

model FlujoPreparacion {
  id                    String                @id @default(cuid())
  nombre                String                @default("Preparación")
  activo                Boolean               @default(true)
  agrupacionDefecto     AgrupacionPreparacion @default(POR_PEDIDO)
  rangoDefecto          RangoPreparacion      @default(HOY)
  // true: todas las tarjetas pendientes muestran productos y checks. false:
  // solo la tarjeta seleccionada se despliega y las demás quedan como resumen.
  // El default conserva el comportamiento que el tablero tuvo siempre.
  detalleSiempreVisible Boolean               @default(true)
  creadoEn              DateTime              @default(now())
  actualizadoEn         DateTime              @updatedAt

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  estados       EstadoPreparacion[]
  etapasEntrada FlujoPreparacionEntrada[]

  // Una sola configuración por instancia en esta versión. Quitar este unique
  // es el único cambio necesario para tableros por equipo más adelante.
  @@unique([instanciaId])
  @@index([instanciaId])
}

// Qué etapas del Flujo de Venta hacen entrar un pedido al tablero. Sin filas,
// el default es: entran los pedidos cuya etapa no es final ni de cancelación.
model FlujoPreparacionEntrada {
  id String @id @default(cuid())

  flujoPreparacionId String
  flujoPreparacion   FlujoPreparacion @relation(fields: [flujoPreparacionId], references: [id], onDelete: Cascade)

  flujoVentaEtapaId String
  flujoVentaEtapa   FlujoVentaEtapa @relation(fields: [flujoVentaEtapaId], references: [id], onDelete: Cascade)

  @@unique([flujoPreparacionId, flujoVentaEtapaId])
  @@index([flujoPreparacionId])
}

// Una columna del tablero.
model EstadoPreparacion {
  id            String   @id @default(cuid())
  nombre        String
  color         String?
  orden         Int      @default(0)
  esInicial     Boolean  @default(false)
  // Al entrar a este estado se sella PreparacionPedido.iniciadaEn (solo la
  // primera vez). Si ningún estado lo tiene, el inicio se sella al entrar al
  // tablero — así iniciadaEn nunca queda vacía en flujos de 2 estados.
  marcaInicio   Boolean  @default(false)
  esFinal       Boolean  @default(false)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  flujoPreparacionId String
  flujoPreparacion   FlujoPreparacion @relation(fields: [flujoPreparacionId], references: [id], onDelete: Cascade)

  preparaciones PreparacionPedido[]
  historial     PreparacionHistorial[]

  @@index([flujoPreparacionId, orden])
}

// El registro de preparación de un pedido. Bloque 1:1, mismo patrón que
// EntregaPedido y ServicioPedido. Sobrevive a la salida del pedido del
// tablero: es el registro de qué se preparó, cuándo y quién.
model PreparacionPedido {
  id            String    @id @default(cuid())
  iniciadaEn    DateTime?
  completadaEn  DateTime?
  notas         String?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  pedidoId String @unique
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  estadoId String
  estado   EstadoPreparacion @relation(fields: [estadoId], references: [id])

  // Quien movió el pedido al estado final.
  asignadaAId String?
  asignadaA   Usuario? @relation(fields: [asignadaAId], references: [id], onDelete: SetNull)

  historial PreparacionHistorial[]

  @@index([estadoId])
  @@index([completadaEn])
}

// Traza de cada cambio de estado. Guarda los nombres además de los ids
// (snapshot), igual que PedidoHistorialEtapa, para que el historial siga
// siendo legible si el estado se renombra o se desactiva.
model PreparacionHistorial {
  id                   String              @id @default(cuid())
  estadoNombre         String
  estadoAnteriorNombre String?
  tipo                 TipoMovimientoEtapa @default(MANUAL)
  usuarioId            String?
  usuarioNombre        String?
  creadoEn             DateTime            @default(now())

  preparacionId String
  preparacion   PreparacionPedido @relation(fields: [preparacionId], references: [id], onDelete: Cascade)

  // Nullable con SetNull: una columna que ya no se usa se puede borrar, y su
  // historial sobrevive — `estadoNombre`/`estadoAnteriorNombre` son snapshots,
  // así que la traza sigue siendo legible sin el estado original. Con la FK
  // obligatoria (RESTRICT) borrar una columna con movimientos era imposible.
  estadoId String?
  estado   EstadoPreparacion? @relation(fields: [estadoId], references: [id], onDelete: SetNull)

  @@index([preparacionId])
  @@index([creadoEn])
}

model PedidoHistorial {
  id            String   @id @default(cuid())
  accion        String
  valorAnterior Json?
  valorNuevo    Json?
  usuarioNombre String?
  creadoEn      DateTime @default(now())

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  usuarioId String?

  @@index([pedidoId])
}

// =====================
// INTEGRACIONES
// =====================

model IntegracionInstancia {
  id            String            @id @default(cuid())
  clave         String
  estado        EstadoIntegracion @default(INSTALADA)
  configuracion Json?
  metadata      Json?
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@unique([instanciaId, clave])
  @@index([instanciaId])
  @@index([clave])
}

// =====================
// CONFIGURACIÓN EMPRESA
// =====================

model ConfiguracionEmpresa {
  id                String   @id @default(cuid())
  nombreEmpresa     String?
  nombreComercial   String?
  razonSocial       String?
  ruc               String?
  tipoNegocio       String?
  industria         String?
  correoPrincipal   String?
  telefonoPrincipal String?
  whatsappPrincipal String?
  sitioWeb          String?
  pais              String?
  provincia         String?
  ciudad            String?
  direccion         String?
  zonaHoraria       String   @default("America/Lima")
  monedaPrincipal   String   @default("PEN")
  idiomaPrincipal   String   @default("es")
  formatoFecha      String   @default("DD/MM/YYYY")
  formatoHora       String   @default("24h")
  activo            Boolean  @default(true)
  creadoEn          DateTime @default(now())
  actualizadoEn     DateTime @updatedAt

  // 019-cobertura-geografica-envios — determina si cotización/pedido piden
  // país o no (FR-011/FR-012). Default MULTIPAIS solo aplica a instancias
  // nuevas sin `pais` (texto libre, arriba) cargado — la migración de datos
  // de esta feature resuelve `pais` contra el catálogo para instancias
  // existentes (data-model.md "Nota de migración").
  modoGeografico  ModoGeografico @default(MULTIPAIS)
  paisOperacionId String?
  paisOperacion   Pais?          @relation(fields: [paisOperacionId], references: [id])

  // 022-transportistas-zonas-tarifas — permite convertir una cotización con
  // costoEnvioConfirmado=false en pedido sin exigir la confirmación (FR-040).
  permiteConvertirSinConfirmarCostoEnvio Boolean             @default(false)
  // 029-combos-productos-compuestos — filtro inicial del selector de
  // productos en pedidos y cotizaciones. Solo el inicial: el usuario puede
  // cambiarlo a mano.
  filtroProductosPedido                  FiltroCatalogoVenta @default(TODOS)
  // Workflows — apagado por defecto: sin el flag, el motor no hace nada y la
  // IA por etapa funciona como siempre (D3).
  workflowsHabilitado                    Boolean             @default(false)
  // 041 — Umbrales en días del seguimiento de contactos (Pendiente <
  // Por recuperar ≤ Inactivo). Validados en guardarUmbralesSeguimientoAction.
  diasSeguimientoPendiente               Int                 @default(3)
  diasSeguimientoRecuperar               Int                 @default(7)
  diasSeguimientoInactivo                Int                 @default(60)
  // 049-proveedores-de-voz — apagado por defecto: sin el flag no se transcribe
  // nada y no se llama a ningún proveedor de voz (FR-008, FR-009).
  transcripcionVozHabilitada             Boolean             @default(false)

  instanciaId String    @unique
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
}

// =====================
// PLANTILLAS CRM
// =====================

model PlantillaCRM {
  id             String        @id @default(cuid())
  nombre         String
  alias          String
  descripcion    String?
  tipo           TipoPlantilla @default(TEXTO)
  contenidoTexto String?
  imagenUrl      String?
  activo         Boolean       @default(true)
  creadoEn       DateTime      @default(now())
  actualizadoEn  DateTime      @updatedAt

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  creadoPorId      String?
  actualizadoPorId String?

  @@unique([instanciaId, alias])
  @@index([instanciaId])
  @@index([alias])
  @@index([activo])
}

// =====================
// MEDIA / ARCHIVOS
// =====================

model MediaArchivo {
  id String @id @default(cuid())

  // Tenant
  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  // Módulo de origen
  modulo      String // "productos" | "plantillas" | "logos" | "conversaciones" | ...
  entidadTipo String? // tipo de entidad relacionada, ej: "producto"
  entidadId   String? // ID de la entidad relacionada

  // Archivo original
  nombreOriginal String
  mimeOriginal   String
  pesoOriginal   Int
  anchoOriginal  Int?
  altoOriginal   Int?

  // Archivo procesado
  mimeOptimizado String @default("image/webp")
  pesoOptimizado Int?
  ancho          Int?
  alto           Int?

  // URLs de storage
  keyOptimizado String // clave en el storage (ej: {instanciaId}/productos/optimized/{id}.webp)
  keyThumbnail  String? // clave del thumbnail
  keyOriginal   String? // clave del original (si se guarda)

  urlOptimizada String
  urlThumbnail  String?
  urlOriginal   String?

  // Metadatos
  hash            String // SHA-256 del buffer original para deduplicación
  proveedor       String      @default("local") // "r2" | "local" | "s3" | "azure"
  canalOrigen     String? // "web" | "whatsapp" | "instagram" | ...
  estadoProcesado EstadoMedia @default(LISTO)
  errorMensaje    String?

  // 049 — Transcripción de audio. Vive acá y no en MensajeConversacion porque
  // MediaArchivo ya es una fila por archivo y ya deduplica por hash: el mismo
  // audio reenviado se transcribe y se cobra UNA vez.
  //
  // OJO: que estas columnas existan acá NO significa que se transcriba
  // cualquier MediaArchivo. El mime NO alcanza para decidirlo — en Instagram
  // una nota de voz y un video llegan los dos como video/mp4 (727 contra 203
  // en datos reales), y el proveedor transcribe video sin devolver error. Solo
  // se marca PENDIENTE desde un mensaje con tipo AUDIO o NOTA_VOZ, y
  // transcribir.ts lo revalida antes de llamar. Ver
  // specs/049-proveedores-de-voz/contracts/alcance-transcripcion.md.
  transcripcion               String?
  transcripcionEstado         EstadoTranscripcion @default(NO_APLICA)
  transcripcionIdioma         String?
  transcripcionSegundos       Int?
  transcripcionIntentos       Int                 @default(0)
  transcripcionBloqueadoHasta DateTime?
  // Sin FK: el proveedor puede borrarse y la transcripción sigue siendo válida.
  transcripcionProveedorVozId String?
  transcripcionEn             DateTime?

  // Relación con contacto (para cascade delete y limpieza de storage)
  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  // Auditoría
  creadoPorId   String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  mensajes MensajeConversacion[]

  @@unique([instanciaId, hash])
  @@index([instanciaId])
  @@index([instanciaId, modulo])
  @@index([entidadTipo, entidadId])
  @@index([contactoId])
  @@index([hash])
  @@index([estadoProcesado])
}

// =====================
// CONVERSACIONES
// =====================

// Identificador externo del contacto por canal (teléfono, email, instagramId, etc.)
model ContactoIdentificadorCanal {
  id            String  @id @default(cuid())
  canal         String // "whatsapp", "email", "instagram", "tiktok"
  identificador String // número, email, userId externo
  handle        String? // @usuario visible del contacto en el canal, si el canal lo expone (ej. Instagram)

  contactoId String
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  // 034 — Aprobación de remitentes desconocidos. SOLO se consulta para el canal
  // "email", y solo cuando ese buzón tiene desactivada la creación automática
  // de contactos: es la fuente de verdad de que un remitente ya fue aprobado,
  // para que sus correos siguientes entren sin volver a pedirlo. En cualquier
  // otro canal queda null para siempre y nadie lo mira.
  aprobadoEn    DateTime?
  aprobadoPorId String?

  creadoEn DateTime @default(now())

  @@unique([canal, identificador, instanciaId])
  @@index([instanciaId])
  @@index([contactoId, canal]) // 041 — filtro por canal en Contactos
}

// Cuenta configurada por canal (número de WhatsApp, email, cuenta Instagram, etc.)
model CuentaCanal {
  id            String  @id @default(cuid())
  canal         String // "whatsapp_lite", "whatsapp_business", "email", "instagram", "facebook_messenger"
  nombre        String // "WhatsApp Principal", "Email Ventas"
  identificador String // +51955..., info@empresa.com
  configuracion Json // tokens, credenciales
  activa        Boolean @default(true)

  // Proveedor de autenticación usado para obtener el token (solo relevante
  // para canal "instagram"; el resto de canales queda en su default). No
  // migra tokens existentes: las cuentas conectadas antes de este campo
  // quedan como "MetaFacebook" (su flujo real) vía el default de la migración.
  proveedorAuth   ProveedorAuthCanal @default(MetaFacebook)
  tokenExpiraEn   DateTime? // vencimiento del access token, si el proveedor lo informa
  tokenRenovadoEn DateTime? // última vez que se renovó/reemplazó el access token

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)

  stageId String?
  stage   PipelineStage? @relation("CuentaCanalStageEntrada", fields: [stageId], references: [id], onDelete: SetNull)

  // Etapa a la que se mueve automáticamente la oportunidad activa de una
  // conversación cuando se responde por primera vez estando en la etapa
  // inicial del pipeline (esInicial=true) — ver procesarPrimeraRespuestaProspecto
  // en conversaciones/actions.ts. El pipeline destino se deriva de
  // stageRespuestaAutomatica.pipelineId en runtime, no se duplica acá.
  stageIdRespuestaAutomatica String?
  stageRespuestaAutomatica   PipelineStage? @relation("CuentaCanalStageRespuesta", fields: [stageIdRespuestaAutomatica], references: [id], onDelete: SetNull)

  conversaciones    Conversacion[]
  buzonCorreoEstado BuzonCorreoEstado?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  // Nota: además de este índice existen dos índices únicos parciales,
  // creados a mano porque Prisma no soporta índices únicos parciales en el
  // schema DSL:
  //   - (instanciaId, identificador) WHERE canal = 'instagram'
  //     (migración 20260817120000_add_instagram_auth_provider)
  //   - (instanciaId, identificador) WHERE canal = 'facebook_messenger'
  //     (migración 20260827000000_add_facebook_messenger_canal)
  // Ambos se restringen a su canal específico para no arriesgar otros
  // canales (whatsapp_lite, email) que hoy no garantizan esa unicidad en
  // datos existentes. Si se corre `prisma migrate dev` después de tocar
  // este modelo, revisar el diff propuesto antes de aceptar — Prisma puede
  // proponer eliminar esos índices por no estar declarados aquí.

  @@index([instanciaId])
  @@index([canal])
  @@index([stageId])
}

// Agrupador de mensajes por contacto + canal/cuenta
model Conversacion {
  id               String                    @id @default(cuid())
  asunto           String?
  estado           EstadoConversacion        @default(ABIERTA)
  clasificacion    ClasificacionConversacion @default(NINGUNA)
  clasificadoEn    DateTime?
  clasificadoPorId String?

  // Separado de `clasificacion`: clasificar como SOPORTE a mano no debe
  // apagar la IA; solo una transferencia explícita lo hace.
  modoAtencion        ModoAtencionConversacion @default(AUTOMATICO)
  atencionDesde       DateTime?
  atencionMotivo      String?
  atencionUsuarioId   String?
  // Ejecución de Workflow que controla la conversación (modoAtencion = WORKFLOW).
  atencionEjecucionId String?

  // 034 — Bandera derivada de ContactoIdentificadorCanal.aprobadoEn. Existe
  // para que los tres puntos que pueden emitir un mensaje saliente (agente
  // humano en envio.ts, IA en orquestar-ia.suscriptor.ts y Workflows en
  // workflows/motor/disparo.ts) corten con la conversación que YA cargan, sin
  // una consulta extra. Solo el canal de correo la pone en true.
  bloqueadaPorAprobacion Boolean @default(false)

  // 034 — Raíz del hilo de correo (Message-ID normalizado). Solo se usa cuando
  // el buzón agrupa POR_HILO; null en el resto de los canales y en los buzones
  // que agrupan por remitente.
  hiloExterno String?

  oportunidadGanadaRelId String?
  oportunidadGanadaRel   Oportunidad? @relation("ConvOportunidadGanada", fields: [oportunidadGanadaRelId], references: [id], onDelete: SetNull)

  contactoId String
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  cuentaCanalId String?
  cuentaCanal   CuentaCanal? @relation(fields: [cuentaCanalId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: SetNull)

  mensajes                     MensajeConversacion[]
  oportunidades                OportunidadConversacion[]
  // 011-playbook-estrategia-comercial
  seleccionesEstrategia        SeleccionEstrategiaLog[]
  // 016-niveles-autonomia-automatizacion
  respuestasPendientesRevision RespuestaPendienteRevision[]
  // 014-conversaciones-piloto-ejemplos-relevantes — auditoría de origen
  conversacionesPilotoOrigen   ConversacionPiloto[]
  workflowEjecuciones          WorkflowEjecucion[]
  // 031-memoria-y-ficha-conversacion — lo que el agente ya mostró y preguntó
  fichaIA                      FichaConversacionIA?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([instanciaId])
  @@index([contactoId])
  @@index([cuentaCanalId])
  @@index([estado])
  @@index([clasificacion])
  @@index([instanciaId, bloqueadaPorAprobacion])
  @@index([instanciaId, hiloExterno])
}

// Mensaje individual dentro de una conversación
model MensajeConversacion {
  id            String        @id @default(cuid())
  contenido     String?
  tipo          TipoMensaje   @default(TEXTO)
  remitente     RemitenteMsg
  estado        EstadoMensaje @default(ENVIADO)
  esNotaInterna Boolean       @default(false)
  idExterno     String? // ID del mensaje en el canal externo

  conversacionId String
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  usuarioId String? // agente que envió (si remitente = AGENTE)

  mediaUrl      String?
  mediaMimeType String?
  mediaDuracion Int?

  // FK a MediaArchivo para imágenes/media procesada con control de estado
  mediaArchivoId String?
  mediaArchivo   MediaArchivo? @relation(fields: [mediaArchivoId], references: [id], onDelete: SetNull)

  creadoEn  DateTime  @default(now())
  enviadoEn DateTime?
  leidoEn   DateTime?

  // Info funcional del fallo cuando estado = FALLIDO (ver EnvioMensajeError
  // en src/conversaciones/errores.ts) — no el stack trace técnico, eso
  // sigue solo en logs. codigoError es el slug estable que usa el frontend
  // para no depender del texto (localizado) que devuelve Meta.
  codigoError String?
  motivoError String?
  fechaError  DateTime?

  reacciones MensajeReaccion[]

  // 035 — Datos propios de correo (HTML limpio, cabeceras, adjuntos). Solo
  // existe para mensajes del canal email desde 035; el resto de los canales
  // nunca lo tiene.
  correo MensajeCorreo?

  @@index([conversacionId])
  @@index([creadoEn])
  @@index([remitente])
  // Último mensaje del CONTACTO en una conversación — la ventana de
  // mensajería de Instagram se calcula desde ahí, no desde el último
  // mensaje en general (ver instagram-ventana.ts).
  @@index([conversacionId, remitente, creadoEn])
}

// 035 — Datos propios de correo de un mensaje de conversación.
//
// SEGURIDAD: `htmlLimpio` es SIEMPRE la salida de la política de limpieza
// (src/integraciones/email/mensaje/html/). El HTML original del correo no se
// guarda en ningún lado. Y aun limpio, nunca se inserta en la página de Karia:
// se sirve solo a un iframe aislado (ver specs/035-correo-html-seguro/).
enum EstadoHtmlCorreo {
  SIN_HTML // el correo no traía HTML, o quedó vacío tras limpiarlo
  DISPONIBLE // hay htmlLimpio
  NO_DISPONIBLE // traía HTML pero no se pudo limpiar dentro de los límites
}

model MensajeCorreo {
  id String @id @default(cuid())

  // @unique: reprocesar un correo nunca duplica este registro (FR-011).
  mensajeId String              @unique
  mensaje   MensajeConversacion @relation(fields: [mensajeId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  estadoHtml      EstadoHtmlCorreo @default(SIN_HTML)
  motivoHtml      String? // código estable; nunca contenido del correo
  htmlLimpio      String?          @db.Text
  versionPolitica Int              @default(1)

  // URLs remotas que el correo traía como imágenes. El proxy de imágenes solo
  // descarga direcciones de esta lista, por índice. No sale al navegador.
  tieneImagenesExternas Boolean @default(false)
  imagenesExternas      Json    @default("[]")

  // AdjuntoCorreo[]: incluye el vínculo cid → MediaArchivo.
  adjuntos Json @default("[]")

  // Cabeceras de ESTE correo (no las de la conversación).
  de         Json?
  para       Json      @default("[]")
  paraTotal  Int       @default(0)
  cc         Json      @default("[]")
  ccTotal    Int       @default(0)
  asunto     String?
  fechaEnvio DateTime?

  creadoEn DateTime @default(now())

  @@index([instanciaId])
}

model MensajeReaccion {
  id            String       @id @default(cuid())
  emoji         String
  tipo          TipoReaccion @default(INTERNA)
  nombreUsuario String?
  canal         String?
  idExterno     String?

  mensajeId String
  mensaje   MensajeConversacion @relation(fields: [mensajeId], references: [id], onDelete: Cascade)

  usuarioId  String?
  contactoId String?

  creadoEn DateTime @default(now())

  @@unique([mensajeId, usuarioId, emoji])
  @@unique([mensajeId, contactoId, emoji])
  @@index([mensajeId])
}

// 034 — Estado operativo de la lectura de un buzón de correo.
//
// Vive aparte de CuentaCanal.configuracion a propósito: esto se escribe en
// CADA ciclo de lectura (cada 60s por buzón), y no corresponde reescribir en
// cada ciclo la fila que guarda las credenciales cifradas del comercio.
model BuzonCorreoEstado {
  id String @id @default(cuid())

  cuentaCanalId String      @unique
  cuentaCanal   CuentaCanal @relation(fields: [cuentaCanalId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  // Marca de posición IMAP. El UID es un entero sin signo de 32 bits: no entra
  // en Int. Se anclan al UID más alto existente al activar el buzón, para no
  // importar el historial previo de la casilla.
  uidValidity BigInt?
  ultimoUid   BigInt?

  ultimaLecturaEn   DateTime?
  ultimaLecturaOkEn DateTime?
  correosLeidos     Int       @default(0)

  // Arrendamiento de lectura. Reemplaza al pg_try_advisory_lock que usaba
  // antes: ese es un lock de SESIÓN, y la base se accede por un pooler en modo
  // transacción, donde cada sentencia puede caer en un backend distinto. El
  // lock se tomaba en uno y el unlock salía por otro, así que quedaba colgado
  // para siempre y el buzón no se volvía a leer nunca. Esto es un UPDATE
  // condicional atómico: funciona por cualquier pooler y se auto-libera si el
  // worker muere a mitad de una lectura.
  leyendoDesde DateTime?

  // Estado de error visible para el negocio. El texto crudo del servidor NO se
  // guarda acá: solo el código funcional y un mensaje ya traducido, porque esto
  // se muestra en pantalla.
  errorCodigo    String?
  errorMensaje   String?
  errorDesde     DateTime?
  fallosSeguidos Int       @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([instanciaId])
}

// Relación conversación ↔ oportunidad
model OportunidadConversacion {
  id       String  @id @default(cuid())
  esActiva Boolean @default(true)

  oportunidadId String
  oportunidad   Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)

  conversacionId String
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  creadoEn DateTime @default(now())

  @@unique([oportunidadId, conversacionId])
  @@index([oportunidadId])
  @@index([conversacionId])
}

enum ClasificacionConversacion {
  NINGUNA
  POSTVENTA
  SOPORTE
  COMERCIAL
}

// =====================
// CAPA DE INTELIGENCIA ARTIFICIAL
// =====================

// =====================
// ENUMS DE VOZ (049-proveedores-de-voz)
// =====================

enum ProveedorVozEnum {
  ELEVENLABS
  OPENAI
  LOCAL
}

// Estado de la transcripción de un MediaArchivo.
//
// NO_APLICA es el default porque la enorme mayoría de los archivos (imágenes,
// documentos, videos) no se transcribe nunca. El índice de la cola es parcial
// sobre PENDIENTE justamente por eso.
//
// INAUDIBLE es TERMINAL y NO se reintenta: el audio no tenía habla. Tratarlo
// como un fallo lo metería en el backoff y gastaría cinco llamadas pagas para
// obtener cinco veces el mismo silencio.
enum EstadoTranscripcion {
  NO_APLICA
  PENDIENTE
  PROCESANDO
  LISTO
  INAUDIBLE
  ERROR
}

// =====================
// ENUMS DE IA
// =====================

enum ProveedorIAEnum {
  ANTHROPIC
  OPENAI
  GEMINI
  DEEPSEEK
  NVIDIA
  LOCAL
}

enum TareaIA {
  CHAT
  RESUMEN
  CLASIFICACION
  SENTIMIENTO
  EXTRACCION_ENTIDADES
  REPORTE
  EMBEDDINGS
  // 010-enrutamiento-modelos-ia-por-objetivo — distinto de EXTRACCION_ENTIDADES
  // genérica: identificar qué producto del catálogo menciona el cliente.
  IDENTIFICACION_PRODUCTO
  // 033-documentacion-vector-store-openai — una búsqueda en la documentación
  // del comercio. Distinta de EMBEDDINGS: los tokens son los de la síntesis de
  // la respuesta, y el costo incluye además la tarifa por llamada de file
  // search. Ver src/ai/documentacion/busqueda.ts.
  BUSQUEDA_DOCUMENTAL
  // 042-contactos-analisis-ia — análisis por lotes de contactos de una cuenta.
  ANALISIS_CONTACTOS
}

enum TipoMemoriaIA {
  EPISODICO
  SEMANTICO
  PROCEDURAL
}

enum TipoAgenteIA {
  COMERCIAL
  GERENCIA
}

// =====================
// MODELOS DE IA
// =====================

// Configuración global de IA por instancia (1-1)
model ConfiguracionIA {
  id                  String          @id @default(cuid())
  habilitado          Boolean         @default(false)
  proveedorDefault    ProveedorIAEnum @default(ANTHROPIC)
  modeloDefault       String          @default("claude-sonnet-4-6")
  temperaturaDefault  Float           @default(0.7)
  limiteTokensDiarios Int?
  limiteTokensMensual Int?
  fallbackHabilitado  Boolean         @default(true)

  // Respaldo de la ventana de espera para cuando la etapa dispara la IA sin
  // agente asignado (agenteIAConfigId undefined en OrquestarIASuscriptor), o
  // cuando el agente no define el suyo.
  esperarAntesDeResponder Boolean @default(false)
  segundosEsperaRespuesta Int     @default(5)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  instanciaId String    @unique
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
}

// Credenciales y configuración de cada proveedor IA por instancia
model ProveedorIA {
  id                     String          @id @default(cuid())
  // 021-alias-proveedores-ia — identificador legible y único por instancia;
  // permite tener varias configuraciones del mismo proveedor (ver alias vs.
  // aliasNormalizado en data-model.md).
  alias                  String
  aliasNormalizado       String
  proveedor              ProveedorIAEnum
  apiKeyEncriptada       String?
  baseUrl                String?
  modelosDisponibles     Json            @default("[]")
  activo                 Boolean         @default(true)
  prioridad              Int             @default(1)
  limitePorMinuto        Int?
  limitePorDia           Int?
  costoInputPorMilToken  Decimal?
  costoOutputPorMilToken Decimal?
  timeoutMs              Int             @default(30000)
  reintentosMax          Int             @default(2)
  casosDeUso             Json?
  tipoAgenteIA           TipoAgenteIA?
  creadoEn               DateTime        @default(now())
  actualizadoEn          DateTime        @updatedAt

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usoIA                        UsoIA[]
  // 042-contactos-analisis-ia
  ejecucionesAnalisisContactos EjecucionAnalisisContactos[]

  @@unique([instanciaId, aliasNormalizado])
  @@index([instanciaId])
  @@index([instanciaId, activo, prioridad])
}

// Extensión de Usuario (tipo=AGENTE) con capacidades de IA
model AgenteIAConfig {
  id                  String       @id @default(cuid())
  sistemaPrompt       String?
  personalidad        String?
  objetivo            String?
  especialidad        String?
  tipo                TipoAgenteIA @default(COMERCIAL)
  temperaturaOverride Float?
  modeloPreferido     String?
  herramientas        Json?
  canalesPermitidos   Json?
  memoriaHabilitada   Boolean      @default(true)
  limiteTokensCtx     Int          @default(4000)
  instrucciones       Json?
  configuracionTono   Json?

  // --- 009-perfil-agente-estructurado-versionado ---
  // Todos opcionales: un agente sin ninguno configurado mantiene el
  // comportamiento exacto que tenía antes de esta extensión (ver
  // construirSystemPrompt en src/ai/prompt/builder.ts).
  nombreAgente                   String?
  rol                            String?
  // Clave de uno de los 8 avatares del set (ver ICONOS_AGENTE en
  // src/configuracion/components/iconos-agente.tsx). Null = el icono
  // genérico de siempre; no viaja al prompt, es solo identidad visual.
  iconoAgente                    String?
  idiomaPrincipal                String?
  idiomasPermitidos              Json? // string[]
  longitudRespuesta              String? // "CORTA" | "MEDIA" | "LARGA"
  // Formato de salida. Viven como columnas propias y no dentro del JSON
  // `configuracionTono` justamente para no repetir el problema que vinieron a
  // resolver: `respuestaLarga` (JSON) y `longitudRespuesta` (columna) decían
  // cosas distintas sobre lo mismo, cada una desde un bloque del prompt.
  // Null/false = el prompt no dice nada al respecto.
  formatoSinMarkdown             Boolean @default(false)
  formatoEmojis                  String? // "OCASIONALES" | "SIN"
  proactividad                   String? // "BAJA" | "MEDIA" | "ALTA"
  intensidadComercial            String? // "SUAVE" | "MODERADA" | "DIRECTA"
  estiloRecomendacion            String? // "CONSULTIVO" | "DIRECTO" | "COMPARATIVO"
  frasesPreferidas               Json? // string[]
  frasesProhibidas               Json? // string[]
  comportamientosProhibidos      Json? // string[]
  reglasPersonalizadas           Json? // string[]
  condicionesTransferenciaHumano Json? // string[]

  // 015-herramientas-operativas-inventario-envios-acciones — default false
  // preserva la creación directa actual de cotizaciones/pedidos por IA.
  accionesComercialesModoBorrador Boolean @default(false)

  // Reglas que le dicen al agente a qué etapa mover la oportunidad y cuándo:
  // ReglaEtapaCicloVidaSchema[] (ver src/configuracion/ia/agente-schema.ts),
  // cada una con el NOMBRE de la etapa destino y el texto que describe la
  // situación. Guarda el nombre y no el stageId a propósito: la herramienta
  // resuelve contra el pipeline de cada oportunidad, así que una misma regla
  // sirve para oportunidades de pipelines distintos.
  //
  // Solo se inyecta en el prompt si la herramienta
  // `actualizar_etapa_oportunidad` está habilitada: sin ella el agente leería
  // una instrucción que no puede ejecutar. Null = sin reglas.
  reglasEtapaCicloVida Json?

  // Ventana de espera antes de responder: el agente aguarda a que el cliente
  // termine de escribir y contesta UNA vez por todos los mensajes del tramo,
  // en vez de uno por mensaje. null = heredar el valor de ConfiguracionIA de
  // la instancia; default false preserva el comportamiento actual (responde
  // apenas llega cada mensaje).
  esperarAntesDeResponder Boolean? @default(false)
  segundosEsperaRespuesta Int?

  /// @deprecated 033-documentacion-vector-store-openai — Reemplazado por el
  /// modelo DocumentoAgenteIA. Ya no se lee ni se escribe: el contenido de los
  /// documentos dejó de ser parte del prompt, así que tampoco es configuración
  /// versionable (restaurar una versión vieja no debe resucitar un archivo
  /// borrado en OpenAI).
  ///
  /// La columna sobrevive solo para que la UI pueda listar lo cargado con el
  /// mecanismo anterior como "Requiere resubir" y permitir eliminarlo.
  /// No borrarla: hacerlo le quitaría a cada cuenta el rastro de lo que tenía.
  documentosFaq Json?

  // 028-respuestas-guia-catalogo-ia — respuestas guía por intención
  // (RespuestaGuiaSchema[] en src/configuracion/ia/agente-schema.ts) y
  // catálogo con precios en la capa 8 del context builder.
  respuestasGuia         Json?
  catalogoEnContexto     Boolean @default(true)
  limiteCatalogoContexto Int     @default(30)

  // Bloque único de instrucciones (Rol y objetivo · Estilo · Proceso de
  // atención · Reglas) que la plantilla del `tipo` siembra al crear el agente
  // y el responsable edita a mano. Es la fuente del prompt y reemplaza a los
  // campos estructurados de la 009 (rol, longitudRespuesta, proactividad,
  // intensidadComercial, estiloRecomendacion, frases*, comportamientos*,
  // reglasPersonalizadas, condicionesTransferenciaHumano), que quedan solo
  // como origen de la migración.
  //
  // Null = agente todavía sin migrar: `construirSystemPrompt` sigue
  // componiendo desde esos campos. El backfill
  // (scripts/backfill-instrucciones-agente.ts) lo rellena a partir de lo que
  // cada agente ya tenía, para que nadie pierda comportamiento al desplegar.
  instruccionesAgente String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  memorias                      MemoriaAgenteIA[]
  usoIA                         UsoIA[]
  pipelineStages                PipelineStage[]
  versiones                     AgenteIAConfigVersion[]
  // 011-playbook-estrategia-comercial
  playbooksAsignados            AgentePlaybookAsignacion[]
  seleccionesEstrategia         SeleccionEstrategiaLog[]
  // 016-niveles-autonomia-automatizacion
  autonomiaIntencionConfigs     AutonomiaIntencionConfig[]
  respuestasPendientes          RespuestaPendienteRevision[]
  // 014-conversaciones-piloto-ejemplos-relevantes
  recomendacionesComportamiento RecomendacionComportamiento[]
  ejemplosPrompt                EjemploPrompt[]
  // 033-documentacion-vector-store-openai
  documentos                    DocumentoAgenteIA[]
}

// --- 009-perfil-agente-estructurado-versionado ---

enum EstadoVersionAgenteIA {
  BORRADOR
  PUBLICADA
}

// Historial append-only de la configuración de un AgenteIAConfig. La fila
// "viva" de AgenteIAConfig siempre representa la versión PUBLICADA vigente
// (se actualiza atómicamente al publicar) — ver research.md de la spec para
// el porqué de este modelado (evita reescribir a los consumidores actuales
// de AgenteIAConfig).
model AgenteIAConfigVersion {
  id        String                @id @default(cuid())
  numero    Int? // null mientras es BORRADOR — se asigna al publicar
  estado    EstadoVersionAgenteIA
  contenido Json // fotografía completa de los campos configurables de AgenteIAConfig

  publicadaEn   DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  agenteIAConfigId String
  agenteIAConfig   AgenteIAConfig @relation(fields: [agenteIAConfigId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  creadaPorUsuarioId String?
  creadaPorUsuario   Usuario? @relation("VersionesAgenteIACreadas", fields: [creadaPorUsuarioId], references: [id], onDelete: SetNull)

  usoIA UsoIA[]

  @@unique([agenteIAConfigId, numero])
  @@index([agenteIAConfigId, estado])
  @@index([instanciaId])
}

// Memoria persistente del agente IA
model MemoriaAgenteIA {
  id       String        @id @default(cuid())
  tipo     TipoMemoriaIA
  clave    String
  valor    String
  expiraEn DateTime?
  creadoEn DateTime      @default(now())

  agenteIAConfigId String
  agenteIAConfig   AgenteIAConfig @relation(fields: [agenteIAConfigId], references: [id], onDelete: Cascade)

  @@index([agenteIAConfigId, tipo])
  @@index([expiraEn])
}

// --- 033-documentacion-vector-store-openai ---

enum EstadoDocumentoAgenteIA {
  INDEXANDO
  LISTO
  ERROR
}

/// Documentación del comercio indexada en el vector store de OpenAI.
///
/// Tabla y no columna JSON en AgenteIAConfig (como era `documentosFaq`) porque
/// esto NO es configuración versionable: el contenido dejó de ser parte del
/// prompt, y versionarlo sería dañino — restaurar una versión vieja no debe
/// resucitar un documento ya borrado en OpenAI.
///
/// Los tres identificadores externos (openaiFileId, vectorStoreFileId,
/// vectorStoreId) NUNCA salen al cliente: listarDocumentosAgente() los excluye
/// con un select explícito. Ver src/ai/documentacion/queries.ts.
model DocumentoAgenteIA {
  id        String @id @default(cuid())
  /// Nombre tal como lo subió el negocio. Es lo ÚNICO que la UI muestra.
  nombre    String
  extension String
  mime      String
  pesoBytes Int

  /// Copia del original en el storage de Karia. Permite reindexar sin pedirle
  /// al negocio que vuelva a subir el archivo.
  storageKey String

  /// Identidad en OpenAI. Infraestructura: nunca viaja al frontend.
  openaiFileId      String?
  vectorStoreFileId String?
  /// En qué store quedó. Hoy siempre el mismo; existe para poder sumar un
  /// segundo store al acercarse el techo de 10.000 archivos, sin migrar nada.
  vectorStoreId     String?

  estado          EstadoDocumentoAgenteIA @default(INDEXANDO)
  /// Motivo legible del fallo. Null salvo en ERROR.
  errorIndexacion String?
  /// Desactivado sigue cargado e indexado, pero la búsqueda lo excluye: el
  /// agente no lo encuentra.
  activo          Boolean                 @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  agenteIAConfigId String
  agenteIAConfig   AgenteIAConfig @relation(fields: [agenteIAConfigId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@index([agenteIAConfigId, estado])
  @@index([instanciaId])
}

// Auditoría de uso y costos de IA
model UsoIA {
  id              String   @id @default(cuid())
  modelo          String
  tarea           TareaIA
  tokensInput     Int      @default(0)
  tokensOutput    Int      @default(0)
  // 042 — los informa el proveedor cuando cachea el prompt (0 si no lo soporta).
  tokensCacheados Int      @default(0)
  costoEstimado   Decimal?
  tiempoMs        Int      @default(0)
  exito           Boolean  @default(true)
  error           String?
  entidadTipo     String?
  entidadId       String?
  creadoEn        DateTime @default(now())

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  proveedorIAId String?
  proveedorIA   ProveedorIA? @relation(fields: [proveedorIAId], references: [id], onDelete: SetNull)

  agenteIAConfigId String?
  agenteIAConfig   AgenteIAConfig? @relation(fields: [agenteIAConfigId], references: [id], onDelete: SetNull)

  // 009-perfil-agente-estructurado-versionado — qué versión exacta generó esta respuesta
  agenteIAConfigVersionId String?
  agenteIAConfigVersion   AgenteIAConfigVersion? @relation(fields: [agenteIAConfigVersionId], references: [id], onDelete: SetNull)

  // 017-aprendizaje-supervisado-auditoria
  registrosRespuesta RespuestaPendienteRevision[]

  @@index([instanciaId, creadoEn])
  @@index([instanciaId, tarea])
  @@index([proveedorIAId])
  @@index([agenteIAConfigVersionId])
}

// --- 011-playbook-estrategia-comercial ---

enum OrigenPlaybook {
  PLANTILLA
  PERSONALIZADA
}

// Estrategia de atención/venta, independiente del agente y del proveedor de
// IA (FR-012) — contenido es una lista de reglas en lenguaje natural
// (research.md Decisión 2), condiciones es { tiposRelacion, intenciones }
// (research.md Decisión 3).
model PlaybookEstrategia {
  id            String         @id @default(cuid())
  nombre        String
  descripcion   String?
  origen        OrigenPlaybook
  activo        Boolean        @default(false)
  contenido     Json
  condiciones   Json
  prioridad     Int            @default(0)
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  asignaciones AgentePlaybookAsignacion[]

  // 014-conversaciones-piloto-ejemplos-relevantes
  conversacionesPiloto     ConversacionPiloto[]          @relation("ConversacionesPilotoPorEstrategia")
  recomendacionesAsociadas RecomendacionComportamiento[] @relation("RecomendacionesAsociadas")
  ejemplosPrompt           EjemploPrompt[]               @relation("EjemplosPromptPorEstrategia")

  @@index([instanciaId, activo])
}

model AgentePlaybookAsignacion {
  id                  String   @id @default(cuid())
  prioridadEfectiva   Int?
  condicionesOverride Json?
  creadoEn            DateTime @default(now())

  agenteIAConfigId String
  agenteIAConfig   AgenteIAConfig @relation(fields: [agenteIAConfigId], references: [id], onDelete: Cascade)

  playbookEstrategiaId String
  playbookEstrategia   PlaybookEstrategia @relation(fields: [playbookEstrategiaId], references: [id], onDelete: Restrict)

  @@unique([agenteIAConfigId, playbookEstrategiaId])
  @@index([agenteIAConfigId])
}

// Registro auditable de cada cálculo de selección de estrategia (FR-009 de
// la spec) — playbookEstrategiaIdSeleccionado null = ninguna coincidió.
model SeleccionEstrategiaLog {
  id                String   @id @default(cuid())
  motivo            String
  tipoRelacionUsado String?
  intencionUsada    String?
  creadoEn          DateTime @default(now())

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  agenteIAConfigId String
  agenteIAConfig   AgenteIAConfig @relation(fields: [agenteIAConfigId], references: [id], onDelete: Cascade)

  conversacionId String?
  conversacion   Conversacion? @relation(fields: [conversacionId], references: [id], onDelete: SetNull)

  playbookEstrategiaIdSeleccionado String?

  @@index([instanciaId, creadoEn])
  @@index([agenteIAConfigId])
}

// --- 015-herramientas-operativas-inventario-envios-acciones ---
// No existía ninguna configuración de métodos de envío/zonas/ubicaciones de
// retiro antes de esta spec — research.md Decisión 1 documenta por qué el
// modelo es deliberadamente simple (zona como texto libre, no un catálogo
// geográfico completo).

model MetodoEntregaConfig {
  id               String                @id @default(cuid())
  metodoEntrega    MetodoEntrega
  activo           Boolean               @default(true)
  costoBase        Decimal               @default(0)
  diasEstimadosMin Int?
  diasEstimadosMax Int?
  // 019-cobertura-geografica-envios — solo tiene efecto observable para
  // métodos de delivery propio (no COURIER_EXTERNO); default conservador
  // (favorece revisión humana) igual criterio que gate.ts (spec 016).
  modoCobertura    ModoCoberturaDelivery @default(SOLO_ZONAS_EVALUADAS)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  zonas ZonaCoberturaMetodo[]

  @@unique([instanciaId, metodoEntrega])
  @@index([instanciaId])
}

model ZonaCobertura {
  id     String @id @default(cuid())
  nombre String

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  metodos ZonaCoberturaMetodo[]

  @@unique([instanciaId, nombre])
}

model ZonaCoberturaMetodo {
  id              String  @id @default(cuid())
  cubierta        Boolean @default(true)
  costoAdicional  Decimal @default(0)
  diasAdicionales Int     @default(0)
  // 019-cobertura-geografica-envios — excepción explícita cuando el método
  // está en modo TODOS_LADOS_CON_EXCEPCIONES. Mutuamente excluyente con
  // `cubierta = true` (regla de negocio validada en el action, no aquí —
  // ver data-model.md).
  esExcepcion     Boolean @default(false)

  zonaCoberturaId String
  zonaCobertura   ZonaCobertura @relation(fields: [zonaCoberturaId], references: [id], onDelete: Cascade)

  metodoEntregaConfigId String
  metodoEntregaConfig   MetodoEntregaConfig @relation(fields: [metodoEntregaConfigId], references: [id], onDelete: Cascade)

  @@unique([zonaCoberturaId, metodoEntregaConfigId])
}

model UbicacionRetiro {
  id        String  @id @default(cuid())
  nombre    String
  direccion String
  activo    Boolean @default(true)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@index([instanciaId, activo])
}

// --- 019-cobertura-geografica-envios ---
// Catálogo global de referencia (no pertenece a ninguna instancia) — sembrado
// vía scripts/seed-geografia.ts, nunca editado a mano por un negocio.

enum ModoCoberturaDelivery {
  TODOS_LADOS_CON_EXCEPCIONES
  SOLO_ZONAS_EVALUADAS
}

enum ModoGeografico {
  UN_SOLO_PAIS
  MULTIPAIS
}

model Pais {
  id String @id @default(cuid())

  // ISO 3166-1 alpha-2 — usado para match/FK (único)
  codigo               String  @unique
  codigoAlpha3         String?
  nombre               String
  indicativoTelefonico String?
  banderaEmoji         String?

  estados                EstadoProvincia[]
  configuracionesEmpresa ConfiguracionEmpresa[]
  cotizacionesEntrega    EntregaCotizacion[]
  pedidosEntrega         EntregaPedido[]
  // 022-transportistas-zonas-tarifas — reemplaza `coberturas` (TransportistaCoberturaGeografica, retirado)
  zonaEntregaUbicaciones ZonaEntregaUbicacion[]
  // 023-transportistas-por-pais
  transportistas         Transportista[]

  @@index([nombre])
}

model EstadoProvincia {
  id String @id @default(cuid())

  // ISO 3166-2 si existe — presentacional, no usado para match
  codigo String?
  nombre String

  paisId String
  pais   Pais   @relation(fields: [paisId], references: [id], onDelete: Cascade)

  cotizacionesEntrega EntregaCotizacion[]
  pedidosEntrega      EntregaPedido[]

  @@unique([paisId, nombre])
  @@index([paisId])
}

// --- 016-niveles-autonomia-automatizacion ---

enum CategoriaIntencionAutonomia {
  SALUDO
  CONSULTA_HORARIO
  PREGUNTA_FRECUENTE
  INFORMACION_GENERAL
  RECOMENDACION
  CONSULTA_PRECIO
  CONSULTA_DISPONIBILIDAD
  COSTO_ENVIO
  SOLICITUD_COTIZACION
  RECLAMO
  SOLICITUD_REEMBOLSO
  DESCUENTO_ESPECIAL
  PROBLEMA_PAGO
  EXCEPCION_ENTREGA
  CLIENTE_MOLESTO
  COMPROMISO_NO_DEFINIDO
}

enum NivelAutonomia {
  SUGGESTION_ONLY
  AUTO_REPLY_SAFE_INTENTS
  CONDITIONAL_AUTOMATION
  HUMAN_ONLY
}

// La AUSENCIA total de filas para un agente equivale al comportamiento
// anterior a esta spec (envío automático sin clasificar) — no es lo mismo
// que "todas las categorías en AUTO_REPLY_SAFE_INTENTS", aunque el efecto
// observable sea el mismo (ver research.md Decisión 3).
model AutonomiaIntencionConfig {
  id                   String                      @id @default(cuid())
  categoria            CategoriaIntencionAutonomia
  nivel                NivelAutonomia
  // { confianzaMinimaClasificacion?: number; requiereAusenciaSenalClienteMolestoEnPerfil?: boolean }
  // — solo relevante cuando nivel = CONDITIONAL_AUTOMATION.
  condicionesConfianza Json?
  actualizadoEn        DateTime                    @updatedAt

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  agenteIAConfigId String
  agenteIAConfig   AgenteIAConfig @relation(fields: [agenteIAConfigId], references: [id], onDelete: Cascade)

  @@unique([agenteIAConfigId, categoria])
  @@index([instanciaId])
}

// 017-aprendizaje-supervisado-auditoria — tras esta spec, esta tabla
// representa "todo registro de respuesta generada por el agente" (enviada
// automáticamente o pendiente de revisión), no solo las pendientes; el
// nombre de la tabla y de sus columnas de 016 se conserva sin cambios
// (data-model.md — solo aditivo).
model RespuestaPendienteRevision {
  id                 String                       @id @default(cuid())
  categoriaDetectada CategoriaIntencionAutonomia?
  mensajeCliente     String
  respuestaPropuesta String
  motivoPendiente    String
  // PENDIENTE | ENVIADA_TAL_CUAL | EDITADA_Y_ENVIADA | DESCARTADA | ENVIADA_AUTOMATICAMENTE (017)
  estado             String                       @default("PENDIENTE")
  respuestaEditada   String?

  // --- 017-aprendizaje-supervisado-auditoria (todas aditivas) ---
  estrategiaUtilizadaId  String? // denormalizado desde SeleccionEstrategiaLog más cercano en tiempo
  ejemplosUtilizadosIds  Json? // string[] de EjemploPrompt.id
  herramientasEjecutadas Json? // string[] de nombres de tool ejecutadas
  confianza              Float?
  motivoTransferencia    String? // completado si transferir_a_humano se ejecutó en esta generación

  resueltaPorUsuarioId String?
  resueltaEn           DateTime?

  creadoEn DateTime @default(now())

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  agenteIAConfigId String
  agenteIAConfig   AgenteIAConfig @relation(fields: [agenteIAConfigId], references: [id], onDelete: Cascade)

  conversacionId String
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  productoIdentificadoId String?
  productoIdentificado   Producto? @relation("RespuestasProductoIdentificado", fields: [productoIdentificadoId], references: [id], onDelete: SetNull)

  usoIAId String?
  usoIA   UsoIA?  @relation(fields: [usoIAId], references: [id], onDelete: SetNull)

  evaluaciones EvaluacionRespuestaIA[]

  @@index([instanciaId, estado])
  @@index([conversacionId])
}

model EvaluacionRespuestaIA {
  id           String  @id @default(cuid())
  // BUENA | NECESITA_MEJORA
  calificacion String
  comentario   String?

  evaluadoPorUsuarioId String?
  evaluadoEn           DateTime @default(now())

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  respuestaId String
  respuesta   RespuestaPendienteRevision @relation(fields: [respuestaId], references: [id], onDelete: Cascade)

  @@index([instanciaId])
  @@index([respuestaId])
}

// --- 014-conversaciones-piloto-ejemplos-relevantes ---

enum ClasificacionPiloto {
  POSITIVO
  NEGATIVO
}

enum EstadoRecomendacion {
  PENDIENTE
  APROBADA
  RECHAZADA
  CONVERTIDA_REGLA
  CONVERTIDA_EJEMPLO
}

model ConversacionPiloto {
  id                   String              @id @default(cuid())
  clasificacion        ClasificacionPiloto
  explicacion          String
  // Copia transformada de los mensajes relevantes — { mensajes: Array<{ rol: "user"|"assistant"; texto: string }> }.
  // La Conversacion/Mensaje originales nunca se modifican (research.md Decisión 1).
  contenidoAnonimizado Json?
  intencion            String?
  tipoCliente          String?

  // FR-005 — falso hasta confirmar anonimización explícitamente.
  incluidaEnPerfil Boolean   @default(false)
  // null hasta ejecutar la anonimización — bloquea incluidaEnPerfil = true (Edge Case).
  anonimizadaEn    DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  // Se conserva la referencia para auditoría humana (FR-006) — no se
  // expone al modelo de IA (solo contenidoAnonimizado se usa para eso).
  conversacionOrigenId String
  conversacionOrigen   Conversacion @relation(fields: [conversacionOrigenId], references: [id], onDelete: Restrict)

  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)

  playbookEstrategiaId String?
  playbookEstrategia   PlaybookEstrategia? @relation("ConversacionesPilotoPorEstrategia", fields: [playbookEstrategiaId], references: [id], onDelete: SetNull)

  creadaPorUsuarioId String?
  creadaPorUsuario   Usuario? @relation("ConversacionesPilotoCreadas", fields: [creadaPorUsuarioId], references: [id], onDelete: SetNull)

  ejemplos EjemploPrompt[]

  @@index([instanciaId, incluidaEnPerfil])
}

model RecomendacionComportamiento {
  id                              String              @id @default(cuid())
  titulo                          String
  descripcion                     String
  reglaSugerida                   String
  confianza                       Float
  estado                          EstadoRecomendacion @default(PENDIENTE)
  // string[] de ids de ConversacionPiloto — trazabilidad, no relación Prisma
  // formal por ser N:M ligera (data-model.md).
  basadaEnConversacionesPilotoIds Json

  resueltaPorUsuarioId String?
  resueltaEn           DateTime?

  creadoEn DateTime @default(now())

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  // Puede ser general (instancia) o específica de un agente.
  agenteIAConfigId String?
  agenteIAConfig   AgenteIAConfig? @relation(fields: [agenteIAConfigId], references: [id], onDelete: SetNull)

  playbookEstrategiaAsociadoId String?
  playbookEstrategiaAsociado   PlaybookEstrategia? @relation("RecomendacionesAsociadas", fields: [playbookEstrategiaAsociadoId], references: [id], onDelete: SetNull)

  resueltaPorUsuario Usuario? @relation("RecomendacionesResueltas", fields: [resueltaPorUsuarioId], references: [id], onDelete: SetNull)

  @@index([instanciaId, estado])
}

model EjemploPrompt {
  id          String  @id @default(cuid())
  // Copia de ConversacionPiloto.contenidoAnonimizado al momento de crear el
  // ejemplo — independiente si la piloto de origen cambia después.
  contenido   Json
  intencion   String?
  tipoCliente String?
  // Derivada al crear (1.0 si POSITIVO y confianza alta de su recomendación
  // de origen; menor en otro caso) — usada para desempate (research.md Decisión 2).
  calidad     Float   @default(0.5)
  activo      Boolean @default(true)

  creadoEn DateTime @default(now())

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  // null = disponible para cualquier agente de la instancia.
  agenteIAConfigId String?
  agenteIAConfig   AgenteIAConfig? @relation(fields: [agenteIAConfigId], references: [id], onDelete: SetNull)

  conversacionPilotoOrigenId String
  conversacionPilotoOrigen   ConversacionPiloto @relation(fields: [conversacionPilotoOrigenId], references: [id], onDelete: Cascade)

  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)

  playbookEstrategiaId String?
  playbookEstrategia   PlaybookEstrategia? @relation("EjemplosPromptPorEstrategia", fields: [playbookEstrategiaId], references: [id], onDelete: SetNull)

  @@index([instanciaId, activo])
}

// =====================
// VOZ (049-proveedores-de-voz)
// =====================

// Credenciales y configuración de cada proveedor de voz por instancia.
//
// Separado de ProveedorIA a propósito: el consumo se mide en TIEMPO DE AUDIO,
// no en tokens. Meter segundos en las columnas de tokens de UsoIA rompería
// obtenerResumenUsoIA y el control de presupuesto de 042, que suman
// tokensInput + tokensOutput sin discriminar la tarea.
model ProveedorVoz {
  id String @id @default(cuid())

  // Mismo par alias/aliasNormalizado de 021: permite varias configuraciones
  // del mismo servicio dentro de una cuenta.
  alias            String
  aliasNormalizado String
  proveedor        ProveedorVozEnum

  // Salida de cifrarToken(). Nunca el valor plano, nunca sale al cliente.
  apiKeyEncriptada String?
  // A diferencia de ProveedorIA.baseUrl, este SÍ llega al adaptador: la
  // fábrica es (apiKey, modelo?, baseUrl?).
  baseUrl          String?
  modelo           String  @default("scribe_v3")

  activo    Boolean @default(true)
  prioridad Int     @default(1)

  // null = no se calcula costo. Nunca se inventa una tarifa: un costo
  // inventado contamina todos los agregados.
  costoPorHora     Decimal?
  limiteMinutosDia Int?

  timeoutMs     Int @default(30000)
  reintentosMax Int @default(2)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usoVoz UsoVoz[]

  @@unique([instanciaId, aliasNormalizado])
  @@index([instanciaId])
  @@index([instanciaId, activo, prioridad])
}

// Auditoría de uso y costo de voz. El análogo de UsoIA, medido en segundos.
// Se escribe una fila por intento, con éxito o sin él, para que el gasto real
// sea auditable aunque la llamada falle después de consumir.
model UsoVoz {
  id            String   @id @default(cuid())
  modelo        String
  segundos      Int      @default(0)
  costoEstimado Decimal?
  tiempoMs      Int      @default(0)
  exito         Boolean  @default(true)
  // Motivo funcional, nunca el stack ni la credencial.
  error         String?
  entidadTipo   String?
  entidadId     String?
  creadoEn      DateTime @default(now())

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  proveedorVozId String?
  proveedorVoz   ProveedorVoz? @relation(fields: [proveedorVozId], references: [id], onDelete: SetNull)

  @@index([instanciaId, creadoEn])
  @@index([proveedorVozId])
}
