// 026-preparacion-pedidos — el tablero de Preparación es un eje propio,
// independiente del Flujo de Venta y del EstadoEntrega de arriba (que sigue
// significando lo mismo que siempre: la logística del envío). Un pedido puede
// estar "Preparado" en el armado interno y todavía PENDIENTE de envío, o al
// revés — son combinaciones válidas, no inconsistencias (ver research.md
// Decisión 8 de la feature).
enum AgrupacionPreparacion {
  POR_PEDIDO
  POR_PRODUCTO
}

enum RangoPreparacion {
  HOY
  MANANA
  SEMANA
  PERSONALIZADO
}

// Tipo de producto — determina qué bloque de cumplimiento usa una
// Cotización/Pedido (ver TipoProducto en Cotizacion/Pedido más abajo).
// Sin reglas de obligatoriedad acá — eso lo resuelve después el Flujo de
// Venta con sus propias reglas de validación.
// 029-combos-productos-compuestos — filtro del selector de productos.
enum FiltroCatalogoVenta {
  TODOS
  PRODUCTOS
  COMBOS
}

enum TipoProducto {
  FISICO
  SERVICIO
  DIGITAL
}

// Modalidad de un ServicioCotizacion/ServicioPedido — todos los campos de
// ese bloque son abiertos/opcionales a propósito.
enum ModalidadServicio {
  EN_ESTABLECIMIENTO
  A_DOMICILIO
  REMOTO
  OTRO
}

// Método de un EntregaDigitalCotizacion/EntregaDigitalPedido — no
// reutiliza MetodoEntrega.DIGITAL (ese es el canal de un delivery físico,
// un concepto distinto).
enum MetodoEntregaDigital {
  EMAIL
  LINK
  DESCARGA
  ACCESO
  LICENCIA
  MANUAL
  OTRO
}

