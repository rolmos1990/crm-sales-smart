generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================
// ENUMS
// =====================

enum Rol {
  OWNER
  ADMIN
  AGENTE
}

enum EstadoContacto {
  ACTIVO
  INACTIVO
  LEAD
}

// Mantenido para compatibilidad con el kanban actual
enum Etapa {
  PROSPECTO
  CALIFICADO
  PROPUESTA
  NEGOCIACION
  GANADO
  PERDIDO
}

enum TipoActividad {
  LLAMADA
  EMAIL
  REUNION
  TAREA
  NOTA
  WHATSAPP
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  APROBADA
  RECHAZADA
  VENCIDA
}

enum EstadoPedido {
  PENDIENTE
  CONFIRMADO
  EN_PROCESO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum TipoCampoPersonalizado {
  TEXTO
  TEXTO_LARGO
  NUMERO
  DECIMAL
  FECHA
  BOOLEANO
  SELECT
  MULTISELECT
  EMAIL
  TELEFONO
  URL
  JSON
}

enum EntidadCampoPersonalizado {
  OPORTUNIDAD
  CONTACTO
  EMPRESA
  PEDIDO
  COTIZACION
  PRODUCTO
}

enum EstadoInstancia {
  ACTIVA
  INACTIVA
  SUSPENDIDA
}

enum EstadoUsuario {
  ACTIVO
  INVITADO
  SUSPENDIDO
  BLOQUEADO
}

enum EstadoIntegracion {
  INSTALADA
  ACTIVA
  INACTIVA
  ERROR
}

enum TipoAccionDisparador {
  CREAR_TAREA
  CREAR_NOTA
  WEBHOOK
  ASIGNAR_USUARIO
  ASIGNAR_ETIQUETA
  MODIFICAR_CAMPO
  CAMBIAR_ETAPA
}

enum EstadoDisparadorJob {
  PENDIENTE
  PROCESANDO
  COMPLETADO
  CANCELADO
  FALLIDO
}

enum OperadorCondicion {
  IGUAL
  DIFERENTE
  MAYOR_QUE
  MENOR_QUE
  CONTIENE
  ES_VERDADERO
  ES_FALSO
}

enum TipoMovimientoEtapa {
  MANUAL
  AUTOMATICO
}

enum TipoPlantilla {
  TEXTO
  TEXTO_IMAGEN
}

enum EstadoMedia {
  PENDIENTE
  PROCESANDO
  LISTO
  ERROR
}

enum EstadoConversacion {
  ABIERTA
  CERRADA
  ARCHIVADA
  EN_ESPERA
}

enum TipoMensaje {
  TEXTO
  IMAGEN
  VIDEO
  AUDIO
  NOTA_VOZ
  DOCUMENTO
  PLANTILLA
  BOTON
  EVENTO_SISTEMA
}

enum RemitenteMsg {
  CONTACTO
  AGENTE
  SISTEMA
  BOT
}

enum EstadoMensaje {
  RECIBIDO
  ENVIADO
  ENTREGADO
  LEIDO
  FALLIDO
}

enum TipoReaccion {
  CANAL // sincroniza con canal externo (WhatsApp)
  INTERNA // solo visible en CRM
}

// =====================
// INSTANCIA / TENANT
// =====================

model Instancia {
  id            String          @id @default(cuid())
  nombre        String
  slug          String          @unique
  descripcion   String?
  dominio       String?
  logoUrl       String?
  estado        EstadoInstancia @default(ACTIVA)
  configuracion Json?
  metadata      Json?
  creadoEn      DateTime        @default(now())
  actualizadoEn DateTime        @updatedAt

  usuarios             UsuarioInstancia[]
  empresas             Empresa[]
  contactos            Contacto[]
  pipelines            Pipeline[]
  oportunidades        Oportunidad[]
  productos            Producto[]
  actividades          Actividad[]
  cotizaciones         Cotizacion[]
  pedidos              Pedido[]
  tags                 Tag[]
  campos               CampoPersonalizado[]
  eventos              EventoLog[]
  integraciones        IntegracionInstancia[]
  configuracionEmpresa ConfiguracionEmpresa?
  plantillas           PlantillaCRM[]
  mediaArchivos        MediaArchivo[]
  cuentasCanal         CuentaCanal[]
  conversaciones       Conversacion[]
  identificadoresCanal ContactoIdentificadorCanal[]
  jobsMensaje          JobMensaje[]
  jobsSistema          JobSistema[]
  flujosVenta          FlujoVenta[]

  @@index([slug])
  @@index([estado])
}

// =====================
// USUARIOS
// =====================

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String?
  rol          Rol      @default(AGENTE)
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  // Autenticación (proveedor externo, ej. Supabase)
  authUserId       String?       @unique
  estado           EstadoUsuario @default(INVITADO)
  intentosFallidos Int           @default(0)
  bloqueadoHasta   DateTime?
  nivelBloqueo     Int           @default(0)
  ultimoLogin      DateTime?

  instancias    UsuarioInstancia[]
  empresas      Empresa[]
  contactos     Contacto[]
  oportunidades Oportunidad[]
  actividades   Actividad[]
  cotizaciones  Cotizacion[]
  pedidos       Pedido[]
}

model UsuarioInstancia {
  id            String   @id @default(cuid())
  rol           Rol      @default(AGENTE)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  oportunidades Oportunidad[]
  actividades   Actividad[]
  cotizaciones  Cotizacion[]
  pedidos       Pedido[]
  empresas      Empresa[]
  contactos     Contacto[]

  @@unique([usuarioId, instanciaId])
  @@index([instanciaId])
  @@index([usuarioId])
}

// =====================
// CRM BASE
// =====================

model Empresa {
  id            String   @id @default(cuid())
  nombre        String
  ruc           String?
  industria     String?
  tamano        String?
  sitioWeb      String?
  telefono      String?
  email         String?
  notas         String?
  activo        Boolean  @default(true)
  metadata      Json?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  contactos     Contacto[]
  oportunidades Oportunidad[]
  actividades   Actividad[]
  cotizaciones  Cotizacion[]
  pedidos       Pedido[]
  campos        CampoPersonalizadoValor[]

  @@index([instanciaId])
  @@index([nombre])
  @@index([ruc])
}

model Contacto {
  id                 String         @id @default(cuid())
  nombre             String
  apellido           String
  email              String?
  telefonoPrincipal  String?
  telefonoSecundario String?
  cargo              String?
  notas              String?
  estado             EstadoContacto @default(LEAD)
  activo             Boolean        @default(true)
  avatarUrl          String?
  metadata           Json?
  creadoEn           DateTime       @default(now())
  actualizadoEn      DateTime       @updatedAt

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  oportunidades        OportunidadContacto[]
  actividades          Actividad[]
  cotizaciones         Cotizacion[]
  pedidos              Pedido[]
  campos               CampoPersonalizadoValor[]
  tags                 ContactoTag[]
  conversaciones       Conversacion[]
  identificadoresCanal ContactoIdentificadorCanal[]
  mediaArchivos        MediaArchivo[]

  @@index([instanciaId])
  @@index([nombre])
  @@index([apellido])
  @@index([email])
}

// =====================
// PIPELINES DINÁMICOS
// =====================

model Pipeline {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  esDefault     Boolean  @default(false)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  stages        PipelineStage[]
  oportunidades Oportunidad[]
  campos        CampoPersonalizado[]
  disparadores  Disparador[]
  cuentasCanal  CuentaCanal[]

  @@index([instanciaId])
  @@index([esDefault])
}

model PipelineStage {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  color         String?
  orden         Int
  probabilidad  Int      @default(20)
  esInicial     Boolean  @default(false)
  esGanado      Boolean  @default(false)
  esPerdido     Boolean  @default(false)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  oportunidades Oportunidad[]
  campos        CampoPersonalizado[]
  disparadores  Disparador[]
  cuentasCanal  CuentaCanal[]

  @@unique([pipelineId, orden])
  @@index([pipelineId])
}

// =====================
// OPORTUNIDADES
// =====================

model Oportunidad {
  id                  String    @id @default(cuid())
  titulo              String
  descripcion         String?
  valor               Decimal   @default(0)
  moneda              String    @default("PEN")
  etapa               Etapa     @default(PROSPECTO)
  probabilidad        Int       @default(20)
  fechaCierre         DateTime?
  fechaGanada         DateTime?
  fechaPerdida        DateTime?
  notas               String?
  motivoPerdida       String?
  metadata            Json?
  nuevoMensaje        Boolean   @default(false)
  ultimaInteraccionEn DateTime?
  creadoEn            DateTime  @default(now())
  actualizadoEn       DateTime  @updatedAt

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  // Pipeline dinámico (opcional, convive con etapa enum)
  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id])

  stageId String?
  stage   PipelineStage? @relation(fields: [stageId], references: [id])

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  contactos             OportunidadContacto[]
  productos             OportunidadProducto[]
  actividades           Actividad[]
  cotizaciones          Cotizacion[]
  pedidos               Pedido[]
  tags                  OportunidadTag[]
  campos                CampoPersonalizadoValor[]
  disparadorJobs        DisparadorJob[]
  conversaciones        OportunidadConversacion[]
  conversacionesGanadas Conversacion[]            @relation("ConvOportunidadGanada")

  @@index([instanciaId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([empresaId])
  @@index([etapa])
}

model OportunidadContacto {
  oportunidadId String
  contactoId    String
  principal     Boolean @default(false)

  oportunidad Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)
  contacto    Contacto    @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  @@id([oportunidadId, contactoId])
}

model OportunidadProducto {
  id             String  @id @default(cuid())
  descripcion    String?
  cantidad       Decimal @default(1)
  precioUnitario Decimal
  descuento      Decimal @default(0)
  subtotal       Decimal @default(0)

  oportunidadId String
  oportunidad   Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)

  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id])
}

// =====================
// TAGS POR INSTANCIA
// =====================

model Tag {
  id       String   @id @default(cuid())
  nombre   String
  color    String?
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now())

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  oportunidades OportunidadTag[]
  contactos     ContactoTag[]

  @@index([instanciaId])
}

model OportunidadTag {
  oportunidadId String
  tagId         String

  oportunidad Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([oportunidadId, tagId])
}

model ContactoTag {
  contactoId String
  tagId      String

  contacto Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactoId, tagId])
}

// =====================
// CAMPOS PERSONALIZADOS
// =====================

model CampoPersonalizado {
  id            String                    @id @default(cuid())
  nombre        String
  clave         String
  descripcion   String?
  tipo          TipoCampoPersonalizado
  entidad       EntidadCampoPersonalizado
  requerido     Boolean                   @default(false)
  bloqueado     Boolean                   @default(false)
  activo        Boolean                   @default(true)
  orden         Int                       @default(0)
  opciones      Json?
  validaciones  Json?
  valorDefault  Json?
  visibleEn     Json?
  requeridoEn   Json?
  bloqueadoEn   Json?
  creadoEn      DateTime                  @default(now())
  actualizadoEn DateTime                  @updatedAt

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  stageId String?
  stage   PipelineStage? @relation(fields: [stageId], references: [id], onDelete: Cascade)

  valores CampoPersonalizadoValor[]

  @@index([instanciaId])
  @@index([entidad])
  @@index([pipelineId])
  @@index([stageId])
}

model CampoPersonalizadoValor {
  id    String @id @default(cuid())
  valor Json?

  campoId String
  campo   CampoPersonalizado @relation(fields: [campoId], references: [id], onDelete: Cascade)

  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)

  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  pedidoId String?
  pedido   Pedido? @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  cotizacionId String?
  cotizacion   Cotizacion? @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([campoId])
  @@index([oportunidadId])
  @@index([contactoId])
  @@index([empresaId])
  @@index([pedidoId])
  @@index([cotizacionId])
}

// =====================
// PRODUCTOS
// =====================

model Producto {
  id                 String   @id @default(cuid())
  sku                String?
  nombre             String
  descripcion        String?
  precio             Decimal  @default(0)
  moneda             String   @default("PEN")
  categoria          String?
  unidad             String   @default("unidad")
  imagenUrl          String?
  activo             Boolean  @default(true)
  manejaStock        Boolean  @default(false)
  cantidadDisponible Decimal  @default(0)
  metadata           Json?
  creadoEn           DateTime @default(now())
  actualizadoEn      DateTime @updatedAt

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  oportunidadLineas OportunidadProducto[]
  cotizacionLineas  CotizacionLinea[]
  pedidoLineas      PedidoLinea[]

  @@index([instanciaId])
  @@index([sku])
  @@index([nombre])
  @@index([categoria])
}

// =====================
// ACTIVIDADES
// =====================

model Actividad {
  id            String        @id @default(cuid())
  tipo          TipoActividad @default(TAREA)
  titulo        String
  descripcion   String?
  fecha         DateTime
  completada    Boolean       @default(false)
  completadaEn  DateTime?
  metadata      Json?
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt

  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id])

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  @@index([instanciaId])
  @@index([fecha])
  @@index([completada])
}

// =====================
// COTIZACIONES
// =====================

model Cotizacion {
  id               String           @id @default(cuid())
  numero           String           @unique
  estado           EstadoCotizacion @default(BORRADOR)
  fechaEmision     DateTime         @default(now())
  fechaVencimiento DateTime?
  subtotal         Decimal          @default(0)
  descuento        Decimal          @default(0)
  impuesto         Decimal          @default(0)
  total            Decimal          @default(0)
  moneda           String           @default("PEN")
  notas            String?
  metadata         Json?
  creadoEn         DateTime         @default(now())
  actualizadoEn    DateTime         @updatedAt

  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id])

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  lineas  CotizacionLinea[]
  pedidos Pedido[]
  campos  CampoPersonalizadoValor[]

  @@index([instanciaId])
  @@index([estado])
  @@index([oportunidadId])
}

model CotizacionLinea {
  id             String  @id @default(cuid())
  descripcion    String?
  cantidad       Decimal
  precioUnitario Decimal
  descuento      Decimal @default(0)
  impuesto       Decimal @default(0)
  subtotal       Decimal
  total          Decimal @default(0)
  orden          Int     @default(0)
  metadata       Json?

  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id])
}

// =====================
// PEDIDOS
// =====================

model Pedido {
  id     String       @id @default(cuid())
  numero String       @unique
  estado EstadoPedido @default(PENDIENTE)

  // Datos del comprador (pedido manual sin contacto en sistema)
  nombre        String?
  apellido      String?
  telefono      String?
  email         String?
  ruc           String?
  empresaNombre String?

  fechaPedido   DateTime  @default(now())
  fechaEntrega  DateTime?
  subtotal      Decimal   @default(0)
  descuento     Decimal   @default(0)
  impuesto      Decimal   @default(0)
  total         Decimal   @default(0)
  moneda        String    @default("PEN")
  notas         String?
  metadata      Json?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id])

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  cotizacionId String?
  cotizacion   Cotizacion? @relation(fields: [cotizacionId], references: [id])

  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  flujoVentaId String?
  flujoVenta   FlujoVenta? @relation(fields: [flujoVentaId], references: [id])

  flujoVentaEtapaId String?
  flujoVentaEtapa   FlujoVentaEtapa? @relation(fields: [flujoVentaEtapaId], references: [id])

  lineas          PedidoLinea[]
  campos          CampoPersonalizadoValor[]
  historialEtapas PedidoHistorialEtapa[]

  @@index([instanciaId])
  @@index([estado])
  @@index([flujoVentaEtapaId])
  @@index([telefono])
  @@index([email])
}

model PedidoLinea {
  id             String  @id @default(cuid())
  descripcion    String?
  cantidad       Decimal
  precioUnitario Decimal
  descuento      Decimal @default(0)
  impuesto       Decimal @default(0)
  subtotal       Decimal
  total          Decimal @default(0)
  orden          Int     @default(0)
  metadata       Json?

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id])
}

// =====================
// EVENTOS / AUDITORÍA
// =====================

model EventoLog {
  id          String   @id @default(cuid())
  tipo        String
  payload     Json
  ocurridoEn  DateTime @default(now())
  entidadTipo String?
  entidadId   String?
  usuarioId   String?

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@index([instanciaId])
  @@index([entidadTipo, entidadId])
  @@index([tipo])
  @@index([ocurridoEn])
}

// =====================
// DISPARADORES (TRIGGERS)
// =====================

model Disparador {
  id            String               @id @default(cuid())
  nombre        String
  activo        Boolean              @default(true)
  orden         Int                  @default(0)
  delayMinutos  Int?
  tipo          TipoAccionDisparador
  config        Json
  creadoEn      DateTime             @default(now())
  actualizadoEn DateTime             @updatedAt

  stageId String
  stage   PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  jobs DisparadorJob[]

  @@index([stageId])
  @@index([pipelineId])
}

model DisparadorJob {
  id          String              @id @default(cuid())
  estado      EstadoDisparadorJob @default(PENDIENTE)
  ejecutarEn  DateTime
  payload     Json
  resultado   Json?
  error       String?
  creadoEn    DateTime            @default(now())
  procesadoEn DateTime?

  disparadorId String
  disparador   Disparador @relation(fields: [disparadorId], references: [id])

  oportunidadId String
  oportunidad   Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)

  stageId    String
  pipelineId String

  @@index([estado, ejecutarEn])
  @@index([oportunidadId, stageId])
  @@index([disparadorId])
}

// =====================
// FLUJO DE VENTA (PEDIDOS)
// =====================

model FlujoVenta {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  esDefault     Boolean  @default(false)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  etapas  FlujoVentaEtapa[]
  pedidos Pedido[]

  @@index([instanciaId])
}

model FlujoVentaEtapa {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  color         String?
  orden         Int      @default(0)
  esInicial     Boolean  @default(false)
  esFinal       Boolean  @default(false)
  esCancelacion Boolean  @default(false)
  esSecuencial  Boolean  @default(true)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  flujoVentaId String
  flujoVenta   FlujoVenta @relation(fields: [flujoVentaId], references: [id], onDelete: Cascade)

  parentId String?
  parent   FlujoVentaEtapa?  @relation("EtapaTree", fields: [parentId], references: [id])
  children FlujoVentaEtapa[] @relation("EtapaTree")

  pedidos   Pedido[]
  reglas    FlujoVentaRegla[]
  historial PedidoHistorialEtapa[]

  @@index([flujoVentaId, orden])
  @@index([flujoVentaId])
  @@index([parentId])
}

model FlujoVentaRegla {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  activo        Boolean  @default(true)
  prioridad     Int      @default(0)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  etapaDestinoId String
  etapaDestino   FlujoVentaEtapa @relation(fields: [etapaDestinoId], references: [id], onDelete: Cascade)

  condiciones FlujoVentaReglaCondicion[]

  @@index([etapaDestinoId])
}

model FlujoVentaReglaCondicion {
  id       String            @id @default(cuid())
  campo    String
  operador OperadorCondicion
  valor    String

  reglaId String
  regla   FlujoVentaRegla @relation(fields: [reglaId], references: [id], onDelete: Cascade)

  @@index([reglaId])
}

model PedidoHistorialEtapa {
  id          String              @id @default(cuid())
  etapaNombre String
  tipo        TipoMovimientoEtapa
  notas       String?
  creadoEn    DateTime            @default(now())

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  etapaId String
  etapa   FlujoVentaEtapa @relation(fields: [etapaId], references: [id])

  usuarioId String?

  @@index([pedidoId])
  @@index([etapaId])
}

// =====================
// INTEGRACIONES
// =====================

model IntegracionInstancia {
  id            String            @id @default(cuid())
  clave         String
  estado        EstadoIntegracion @default(INSTALADA)
  configuracion Json?
  metadata      Json?
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@unique([instanciaId, clave])
  @@index([instanciaId])
  @@index([clave])
}

// =====================
// CONFIGURACIÓN EMPRESA
// =====================

model ConfiguracionEmpresa {
  id                String   @id @default(cuid())
  nombreEmpresa     String?
  nombreComercial   String?
  razonSocial       String?
  ruc               String?
  tipoNegocio       String?
  industria         String?
  correoPrincipal   String?
  telefonoPrincipal String?
  whatsappPrincipal String?
  sitioWeb          String?
  pais              String?
  provincia         String?
  ciudad            String?
  direccion         String?
  zonaHoraria       String   @default("America/Lima")
  monedaPrincipal   String   @default("PEN")
  idiomaPrincipal   String   @default("es")
  formatoFecha      String   @default("DD/MM/YYYY")
  formatoHora       String   @default("24h")
  activo            Boolean  @default(true)
  creadoEn          DateTime @default(now())
  actualizadoEn     DateTime @updatedAt

  instanciaId String    @unique
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
}

// =====================
// PLANTILLAS CRM
// =====================

model PlantillaCRM {
  id             String        @id @default(cuid())
  nombre         String
  alias          String
  descripcion    String?
  tipo           TipoPlantilla @default(TEXTO)
  contenidoTexto String?
  imagenUrl      String?
  activo         Boolean       @default(true)
  creadoEn       DateTime      @default(now())
  actualizadoEn  DateTime      @updatedAt

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  creadoPorId      String?
  actualizadoPorId String?

  @@unique([instanciaId, alias])
  @@index([instanciaId])
  @@index([alias])
  @@index([activo])
}

// =====================
// MEDIA / ARCHIVOS
// =====================

model MediaArchivo {
  id String @id @default(cuid())

  // Tenant
  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  // Módulo de origen
  modulo      String // "productos" | "plantillas" | "logos" | "conversaciones" | ...
  entidadTipo String? // tipo de entidad relacionada, ej: "producto"
  entidadId   String? // ID de la entidad relacionada

  // Archivo original
  nombreOriginal String
  mimeOriginal   String
  pesoOriginal   Int
  anchoOriginal  Int?
  altoOriginal   Int?

  // Archivo procesado
  mimeOptimizado String @default("image/webp")
  pesoOptimizado Int?
  ancho          Int?
  alto           Int?

  // URLs de storage
  keyOptimizado String // clave en el storage (ej: {instanciaId}/productos/optimized/{id}.webp)
  keyThumbnail  String? // clave del thumbnail
  keyOriginal   String? // clave del original (si se guarda)

  urlOptimizada String
  urlThumbnail  String?
  urlOriginal   String?

  // Metadatos
  hash            String // SHA-256 del buffer original para deduplicación
  proveedor       String      @default("local") // "r2" | "local" | "s3" | "azure"
  canalOrigen     String? // "web" | "whatsapp" | "instagram" | ...
  estadoProcesado EstadoMedia @default(LISTO)
  errorMensaje    String?

  // Relación con contacto (para cascade delete y limpieza de storage)
  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  // Auditoría
  creadoPorId   String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  mensajes MensajeConversacion[]

  @@unique([instanciaId, hash])
  @@index([instanciaId])
  @@index([instanciaId, modulo])
  @@index([entidadTipo, entidadId])
  @@index([contactoId])
  @@index([hash])
  @@index([estadoProcesado])
}

// =====================
// CONVERSACIONES
// =====================

// Identificador externo del contacto por canal (teléfono, email, instagramId, etc.)
model ContactoIdentificadorCanal {
  id            String @id @default(cuid())
  canal         String // "whatsapp", "email", "instagram", "tiktok"
  identificador String // número, email, userId externo

  contactoId String
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  creadoEn DateTime @default(now())

  @@unique([canal, identificador, instanciaId])
  @@index([instanciaId])
  @@index([contactoId])
}

// Cuenta configurada por canal (número de WhatsApp, email, cuenta Instagram, etc.)
model CuentaCanal {
  id            String  @id @default(cuid())
  canal         String // "whatsapp_lite", "whatsapp_business", "email", "instagram"
  nombre        String // "WhatsApp Principal", "Email Ventas"
  identificador String // +51955..., info@empresa.com
  configuracion Json // tokens, credenciales
  activa        Boolean @default(true)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)

  stageId String?
  stage   PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  conversaciones Conversacion[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([instanciaId])
  @@index([canal])
  @@index([stageId])
}

// Agrupador de mensajes por contacto + canal/cuenta
model Conversacion {
  id               String                    @id @default(cuid())
  asunto           String?
  estado           EstadoConversacion        @default(ABIERTA)
  clasificacion    ClasificacionConversacion @default(NINGUNA)
  clasificadoEn    DateTime?
  clasificadoPorId String?

  oportunidadGanadaRelId String?
  oportunidadGanadaRel   Oportunidad? @relation("ConvOportunidadGanada", fields: [oportunidadGanadaRelId], references: [id], onDelete: SetNull)

  contactoId String
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  cuentaCanalId String?
  cuentaCanal   CuentaCanal? @relation(fields: [cuentaCanalId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: SetNull)

  mensajes      MensajeConversacion[]
  oportunidades OportunidadConversacion[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([instanciaId])
  @@index([contactoId])
  @@index([cuentaCanalId])
  @@index([estado])
  @@index([clasificacion])
}

// Mensaje individual dentro de una conversación
model MensajeConversacion {
  id            String        @id @default(cuid())
  contenido     String?
  tipo          TipoMensaje   @default(TEXTO)
  remitente     RemitenteMsg
  estado        EstadoMensaje @default(ENVIADO)
  esNotaInterna Boolean       @default(false)
  idExterno     String? // ID del mensaje en el canal externo

  conversacionId String
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  usuarioId String? // agente que envió (si remitente = AGENTE)

  mediaUrl      String?
  mediaMimeType String?
  mediaDuracion Int?

  // FK a MediaArchivo para imágenes/media procesada con control de estado
  mediaArchivoId String?
  mediaArchivo   MediaArchivo? @relation(fields: [mediaArchivoId], references: [id], onDelete: SetNull)

  creadoEn  DateTime  @default(now())
  enviadoEn DateTime?
  leidoEn   DateTime?

  reacciones MensajeReaccion[]

  @@index([conversacionId])
  @@index([creadoEn])
  @@index([remitente])
}

model MensajeReaccion {
  id            String       @id @default(cuid())
  emoji         String
  tipo          TipoReaccion @default(INTERNA)
  nombreUsuario String?
  canal         String?
  idExterno     String?

  mensajeId String
  mensaje   MensajeConversacion @relation(fields: [mensajeId], references: [id], onDelete: Cascade)

  usuarioId  String?
  contactoId String?

  creadoEn DateTime @default(now())

  @@unique([mensajeId, usuarioId, emoji])
  @@unique([mensajeId, contactoId, emoji])
  @@index([mensajeId])
}

// Relación conversación ↔ oportunidad
model OportunidadConversacion {
  id       String  @id @default(cuid())
  esActiva Boolean @default(true)

  oportunidadId String
  oportunidad   Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)

  conversacionId String
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  creadoEn DateTime @default(now())

  @@unique([oportunidadId, conversacionId])
  @@index([oportunidadId])
  @@index([conversacionId])
}

// =====================
// JOB QUEUE - MENSAJES
// =====================

enum TipoJobMensaje {
  ENVIAR_MENSAJE
  PROCESAR_ENTRANTE
  MARCAR_LEIDO
}

enum EstadoJobMensaje {
  PENDIENTE
  PROCESANDO
  COMPLETADO
  FALLIDO
}

enum ClasificacionConversacion {
  NINGUNA
  POSTVENTA
  SOPORTE
  COMERCIAL
}

// Cola de jobs para envío/recepción asíncrona de mensajes por cualquier canal
model JobMensaje {
  id          String           @id @default(cuid())
  tipo        TipoJobMensaje
  estado      EstadoJobMensaje @default(PENDIENTE)
  payload     Json
  intentos    Int              @default(0)
  maxIntentos Int              @default(3)
  error       String?
  creadoEn    DateTime         @default(now())
  procesadoEn DateTime?

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id])

  @@index([estado, creadoEn])
  @@index([instanciaId])
}

// =====================
// JOB QUEUE - SISTEMA
// =====================

enum TipoJobSistema {
  INICIALIZAR_INSTANCIA
}

enum EstadoJobSistema {
  PENDIENTE
  PROCESANDO
  COMPLETADO
  FALLIDO
}

// Cola de jobs para tareas de inicialización y configuración de instancias
model JobSistema {
  id          String           @id @default(cuid())
  tipo        TipoJobSistema
  estado      EstadoJobSistema @default(PENDIENTE)
  payload     Json
  intentos    Int              @default(0)
  maxIntentos Int              @default(3)
  error       String?
  creadoEn    DateTime         @default(now())
  procesadoEn DateTime?

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id])

  @@index([estado, creadoEn])
  @@index([instanciaId])
}
