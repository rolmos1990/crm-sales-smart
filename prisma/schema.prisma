generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================
// ENUMS
// =====================

enum Rol {
  OWNER
  ADMIN
  GERENTE_VENTAS
  SUPERVISOR
  AGENTE_VENTAS
  EJECUTIVO_VENTAS
  AGENTE_SOPORTE
  INVITADO
  AGENTE
}

enum EstadoContacto {
  ACTIVO
  INACTIVO
  LEAD
}

// Mantenido para compatibilidad con el kanban actual
enum Etapa {
  PROSPECTO
  CALIFICADO
  PROPUESTA
  NEGOCIACION
  GANADO
  PERDIDO
}

enum TipoActividad {
  LLAMADA
  EMAIL
  REUNION
  TAREA
  NOTA
  WHATSAPP
}

enum PrioridadActividad {
  ALTA
  MEDIA
  BAJA
}

enum EstadoCotizacion {
  BORRADOR
  REVISADA
  APROBADA
  ENVIADA
  RECHAZADA
  VENCIDA
}

enum EstadoPedido {
  PENDIENTE
  CONFIRMADO
  EN_PROCESO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum TipoTransportista {
  COURIER_EXTERNO
  MENSAJERO_PROPIO
  RETIRO_TIENDA
  DIGITAL
  INSTALACION_SERVICIO
}

enum MetodoEntrega {
  COURIER_EXTERNO
  MENSAJERO_PROPIO
  RETIRO_TIENDA
  DIGITAL
  INSTALACION_SERVICIO
}

enum EstadoEntrega {
  PENDIENTE
  PREPARANDO
  EN_CAMINO
  ENTREGADO
  FALLIDO
  CANCELADO
  DEVUELTO
}

// Tipo de producto — determina qué bloque de cumplimiento usa una
// Cotización/Pedido (ver TipoProducto en Cotizacion/Pedido más abajo).
// Sin reglas de obligatoriedad acá — eso lo resuelve después el Flujo de
// Venta con sus propias reglas de validación.
enum TipoProducto {
  FISICO
  SERVICIO
  DIGITAL
}

// Modalidad de un ServicioCotizacion/ServicioPedido — todos los campos de
// ese bloque son abiertos/opcionales a propósito.
enum ModalidadServicio {
  EN_ESTABLECIMIENTO
  A_DOMICILIO
  REMOTO
  OTRO
}

// Método de un EntregaDigitalCotizacion/EntregaDigitalPedido — no
// reutiliza MetodoEntrega.DIGITAL (ese es el canal de un delivery físico,
// un concepto distinto).
enum MetodoEntregaDigital {
  EMAIL
  LINK
  DESCARGA
  ACCESO
  LICENCIA
  MANUAL
  OTRO
}

enum TipoCampoPersonalizado {
  TEXTO
  TEXTO_LARGO
  NUMERO
  DECIMAL
  FECHA
  BOOLEANO
  SELECT
  MULTISELECT
  EMAIL
  TELEFONO
  URL
  JSON
}

enum EntidadCampoPersonalizado {
  OPORTUNIDAD
  CONTACTO
  EMPRESA
  PEDIDO
  COTIZACION
  PRODUCTO
}

enum EstadoInstancia {
  ACTIVA
  INACTIVA
  SUSPENDIDA
}

enum EstadoUsuario {
  ACTIVO
  INVITADO
  SUSPENDIDO
  BLOQUEADO
}

enum TipoUsuario {
  USUARIO
  AGENTE
}

enum EstadoIntegracion {
  INSTALADA
  ACTIVA
  INACTIVA
  ERROR
}

enum TipoAccionDisparador {
  CREAR_TAREA
  CREAR_NOTA
  WEBHOOK
  ASIGNAR_USUARIO
  ASIGNAR_ETIQUETA
  MODIFICAR_CAMPO
  CAMBIAR_ETAPA
  // Solo válido en disparadores de Flujo de Venta (pedidos): al llegar el
  // pedido a la etapa configurada, mueve la oportunidad relacionada a la
  // etapa Ganada o Perdida de SU pipeline — resuelta dinámicamente en cada
  // ejecución (ver ejecutor.ts), así sigue funcionando aunque el pipeline
  // cambie de forma más adelante.
  CERRAR_OPORTUNIDAD
}

enum EstadoDisparadorJob {
  PENDIENTE
  PROCESANDO
  COMPLETADO
  CANCELADO
  FALLIDO
}

enum OperadorCondicion {
  IGUAL
  DIFERENTE
  MAYOR_QUE
  MENOR_QUE
  CONTIENE
  ES_VERDADERO
  ES_FALSO
  // ── Agregados para el constructor de condiciones de Reglas de validación ──
  // Texto
  NO_CONTIENE
  ESTA_VACIO
  NO_ESTA_VACIO
  EMPIEZA_CON
  TERMINA_CON
  // Número / moneda
  MAYOR_IGUAL
  MENOR_IGUAL
  ENTRE
  // Lista / estado
  ESTA_EN
  NO_ESTA_EN
  // Fecha
  ANTES_DE
  DESPUES_DE
  ENTRE_FECHAS
  ESTA_VENCIDA
  ES_HOY
  PROXIMOS_N_DIAS
  // Colección
  CONTIENE_ALGUNO
  CONTIENE_TODOS
  NO_CONTIENE_COLECCION
  COLECCION_VACIA
  COLECCION_NO_VACIA
  CANTIDAD_IGUAL
  CANTIDAD_MAYOR
  CANTIDAD_MENOR
  // Archivo
  ADJUNTO
  NO_ADJUNTO
}

enum EstadoFlujoVentaRegla {
  BORRADOR
  PUBLICADA
}

enum TipoMovimientoEtapa {
  MANUAL
  AUTOMATICO
}

enum TipoPlantilla {
  TEXTO
  TEXTO_IMAGEN
}

enum EstadoMedia {
  PENDIENTE
  PROCESANDO
  LISTO
  ERROR
}

enum EstadoConversacion {
  ABIERTA
  CERRADA
  ARCHIVADA
  EN_ESPERA
}

// Flujo de OAuth usado para obtener el access token de una CuentaCanal de
// Instagram. "MetaFacebook" = flujo heredado (Facebook Login + Página
// vinculada). "Instagram" = Instagram API with Instagram Login (Business
// Login for Instagram) — no requiere Página de Facebook.
enum ProveedorAuthCanal {
  MetaFacebook
  Instagram
}

enum EstadoImportacion {
  EN_PROCESO
  COMPLETADO
  COMPLETADO_CON_ERRORES
  FALLIDO
}

enum TipoMensaje {
  TEXTO
  IMAGEN
  VIDEO
  AUDIO
  NOTA_VOZ
  DOCUMENTO
  PLANTILLA
  BOTON
  EVENTO_SISTEMA
}

enum RemitenteMsg {
  CONTACTO
  AGENTE
  SISTEMA
  BOT
}

enum EstadoMensaje {
  RECIBIDO
  ENVIADO
  ENTREGADO
  LEIDO
  FALLIDO
}

enum TipoReaccion {
  CANAL // sincroniza con canal externo (WhatsApp)
  INTERNA // solo visible en CRM
}

// =====================
// INSTANCIA / TENANT
// =====================

model Instancia {
  id            String          @id @default(cuid())
  nombre        String
  slug          String          @unique
  descripcion   String?
  dominio       String?
  logoUrl       String?
  estado        EstadoInstancia @default(ACTIVA)
  configuracion Json?
  metadata      Json?
  creadoEn      DateTime        @default(now())
  actualizadoEn DateTime        @updatedAt

  usuarios             UsuarioInstancia[]
  empresas             Empresa[]
  contactos            Contacto[]
  pipelines            Pipeline[]
  oportunidades        Oportunidad[]
  productos            Producto[]
  actividades          Actividad[]
  cotizaciones         Cotizacion[]
  pedidos              Pedido[]
  tags                 Tag[]
  campos               CampoPersonalizado[]
  eventos              EventoLog[]
  integraciones        IntegracionInstancia[]
  configuracionEmpresa ConfiguracionEmpresa?
  plantillas           PlantillaCRM[]
  mediaArchivos        MediaArchivo[]
  cuentasCanal         CuentaCanal[]
  conversaciones       Conversacion[]
  identificadoresCanal ContactoIdentificadorCanal[]

  flujosVenta    FlujoVenta[]
  importaciones  HistorialImportacion[]
  transportistas Transportista[]

  // IA
  configuracionIA        ConfiguracionIA?
  proveedoresIA          ProveedorIA[]
  agentesIAConfig        AgenteIAConfig[]
  usoIA                  UsoIA[]
  agenteIAConfigVersions AgenteIAConfigVersion[]

  @@index([slug])
  @@index([estado])
}

// =====================
// USUARIOS
// =====================

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String?
  rol          Rol      @default(AGENTE)
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  tipo     TipoUsuario @default(USUARIO)
  telefono String?
  cargo    String?

  // Autenticación (proveedor externo, ej. Supabase)
  authUserId       String?       @unique
  estado           EstadoUsuario @default(INVITADO)
  intentosFallidos Int           @default(0)
  bloqueadoHasta   DateTime?
  nivelBloqueo     Int           @default(0)
  ultimoLogin      DateTime?

  instancias    UsuarioInstancia[]
  empresas      Empresa[]
  contactos     Contacto[]
  oportunidades Oportunidad[]
  actividades   Actividad[]
  cotizaciones  Cotizacion[]
  pedidos       Pedido[]

  // IA — presente solo en usuarios tipo AGENTE con capacidades IA
  agenteIAConfig AgenteIAConfig?

  // 009-perfil-agente-estructurado-versionado — quién guardó/publicó cada versión
  versionesAgenteIACreadas AgenteIAConfigVersion[] @relation("VersionesAgenteIACreadas")
}

model UsuarioInstancia {
  id            String   @id @default(cuid())
  rol           Rol      @default(AGENTE)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  oportunidades Oportunidad[]
  actividades   Actividad[]
  cotizaciones  Cotizacion[]
  pedidos       Pedido[]
  empresas      Empresa[]
  contactos     Contacto[]

  @@unique([usuarioId, instanciaId])
  @@index([instanciaId])
  @@index([usuarioId])
}

// =====================
// CRM BASE
// =====================

model Empresa {
  id            String   @id @default(cuid())
  nombre        String
  ruc           String?
  industria     String?
  tamano        String?
  sitioWeb      String?
  telefono      String?
  email         String?
  notas         String?
  activo        Boolean  @default(true)
  metadata      Json?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  contactos     Contacto[]
  oportunidades Oportunidad[]
  actividades   Actividad[]
  cotizaciones  Cotizacion[]
  pedidos       Pedido[]
  campos        CampoPersonalizadoValor[]

  @@index([instanciaId])
  @@index([nombre])
  @@index([ruc])
}

model Contacto {
  id                 String         @id @default(cuid())
  nombre             String
  apellido           String
  email              String?
  telefonoPrincipal  String?
  telefonoSecundario String?
  cargo              String?
  notas              String?
  estado             EstadoContacto @default(LEAD)
  activo             Boolean        @default(true)
  avatarUrl          String?
  metadata           Json?
  creadoEn           DateTime       @default(now())
  actualizadoEn      DateTime       @updatedAt

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  oportunidades        OportunidadContacto[]
  actividades          Actividad[]
  cotizaciones         Cotizacion[]
  pedidos              Pedido[]
  campos               CampoPersonalizadoValor[]
  tags                 ContactoTag[]
  conversaciones       Conversacion[]
  identificadoresCanal ContactoIdentificadorCanal[]
  mediaArchivos        MediaArchivo[]

  @@index([instanciaId])
  @@index([nombre])
  @@index([apellido])
  @@index([email])
}

// =====================
// PIPELINES DINÁMICOS
// =====================

model Pipeline {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  esDefault     Boolean  @default(false)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  stages        PipelineStage[]
  oportunidades Oportunidad[]
  campos        CampoPersonalizado[]
  disparadores  Disparador[]
  cuentasCanal  CuentaCanal[]

  @@index([instanciaId])
  @@index([esDefault])
}

model PipelineStage {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  color         String?
  orden         Int
  probabilidad  Int      @default(20)
  esInicial     Boolean  @default(false)
  esGanado      Boolean  @default(false)
  esPerdido     Boolean  @default(false)
  // Solo aplica a etapas esGanado/esPerdido: permite ocultarlas como columna
  // del kanban sin perder la posibilidad de mover una oportunidad a esa etapa
  // (drag&drop directo o vía el popover "Mover a").
  visible       Boolean  @default(true)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  respuestaIAHabilitada Boolean         @default(false)
  agenteIAConfigId      String?
  agenteIAConfig        AgenteIAConfig? @relation(fields: [agenteIAConfigId], references: [id], onDelete: SetNull)

  oportunidades Oportunidad[]
  campos        CampoPersonalizado[]
  disparadores  Disparador[]
  cuentasCanal  CuentaCanal[]

  @@unique([pipelineId, orden])
  @@index([pipelineId])
}

// =====================
// OPORTUNIDADES
// =====================

model Oportunidad {
  id                  String    @id @default(cuid())
  titulo              String
  descripcion         String?
  valor               Decimal   @default(0)
  moneda              String    @default("PEN")
  etapa               Etapa     @default(PROSPECTO)
  probabilidad        Int       @default(20)
  fechaCierre         DateTime?
  fechaGanada         DateTime?
  fechaPerdida        DateTime?
  notas               String?
  motivoPerdida       String?
  metadata            Json?
  nuevoMensaje        Boolean   @default(false)
  ultimaInteraccionEn DateTime?
  creadoEn            DateTime  @default(now())
  actualizadoEn       DateTime  @updatedAt

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  // Pipeline dinámico (opcional, convive con etapa enum)
  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id])

  stageId String?
  stage   PipelineStage? @relation(fields: [stageId], references: [id])

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  contactos             OportunidadContacto[]
  productos             OportunidadProducto[]
  actividades           Actividad[]
  cotizaciones          Cotizacion[]
  pedidos               Pedido[]
  tags                  OportunidadTag[]
  campos                CampoPersonalizadoValor[]
  disparadorJobs        DisparadorJob[]
  conversaciones        OportunidadConversacion[]
  conversacionesGanadas Conversacion[]            @relation("ConvOportunidadGanada")

  @@index([instanciaId])
  @@index([instanciaId, id])
  @@index([pipelineId])
  @@index([stageId])
  @@index([empresaId])
  @@index([etapa])
}

model OportunidadContacto {
  oportunidadId String
  contactoId    String
  principal     Boolean @default(false)

  oportunidad Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)
  contacto    Contacto    @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  @@id([oportunidadId, contactoId])
  @@index([oportunidadId, principal])
}

model OportunidadProducto {
  id             String  @id @default(cuid())
  descripcion    String?
  cantidad       Decimal @default(1)
  precioUnitario Decimal
  descuento      Decimal @default(0)
  subtotal       Decimal @default(0)

  oportunidadId String
  oportunidad   Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)

  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id])
}

// =====================
// TAGS POR INSTANCIA
// =====================

model Tag {
  id       String   @id @default(cuid())
  nombre   String
  color    String?
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now())

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  oportunidades OportunidadTag[]
  contactos     ContactoTag[]

  @@index([instanciaId])
}

model OportunidadTag {
  oportunidadId String
  tagId         String

  oportunidad Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([oportunidadId, tagId])
}

model ContactoTag {
  contactoId String
  tagId      String

  contacto Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactoId, tagId])
}

// =====================
// CAMPOS PERSONALIZADOS
// =====================

model CampoPersonalizado {
  id            String                    @id @default(cuid())
  nombre        String
  clave         String
  descripcion   String?
  tipo          TipoCampoPersonalizado
  entidad       EntidadCampoPersonalizado
  requerido     Boolean                   @default(false)
  bloqueado     Boolean                   @default(false)
  activo        Boolean                   @default(true)
  orden         Int                       @default(0)
  opciones      Json?
  validaciones  Json?
  valorDefault  Json?
  visibleEn     Json?
  requeridoEn   Json?
  bloqueadoEn   Json?
  creadoEn      DateTime                  @default(now())
  actualizadoEn DateTime                  @updatedAt

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  stageId String?
  stage   PipelineStage? @relation(fields: [stageId], references: [id], onDelete: Cascade)

  valores CampoPersonalizadoValor[]

  @@index([instanciaId])
  @@index([entidad])
  @@index([pipelineId])
  @@index([stageId])
}

model CampoPersonalizadoValor {
  id    String @id @default(cuid())
  valor Json?

  campoId String
  campo   CampoPersonalizado @relation(fields: [campoId], references: [id], onDelete: Cascade)

  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)

  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  pedidoId String?
  pedido   Pedido? @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  cotizacionId String?
  cotizacion   Cotizacion? @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([campoId])
  @@index([oportunidadId])
  @@index([contactoId])
  @@index([empresaId])
  @@index([pedidoId])
  @@index([cotizacionId])
}

// =====================
// PRODUCTOS
// =====================

model Producto {
  id                 String       @id @default(cuid())
  sku                String?
  nombre             String
  descripcion        String?
  precio             Decimal      @default(0)
  moneda             String       @default("PEN")
  categoria          String?
  // Determina qué bloque de cumplimiento usa una Cotización/Pedido que
  // incluya este producto — ver TipoProducto, ServicioCotizacion/Pedido y
  // EntregaDigitalCotizacion/Pedido.
  tipo               TipoProducto @default(FISICO)
  unidad             String       @default("unidad")
  imagenUrl          String?
  activo             Boolean      @default(true)
  manejaStock        Boolean      @default(false)
  cantidadDisponible Decimal      @default(0)
  metadata           Json?
  creadoEn           DateTime     @default(now())
  actualizadoEn      DateTime     @updatedAt

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  oportunidadLineas OportunidadProducto[]
  cotizacionLineas  CotizacionLinea[]
  pedidoLineas      PedidoLinea[]
  // Plantilla de entrega digital — solo se usa cuando tipo = DIGITAL. Se
  // copia como snapshot independiente a cada línea que use este producto
  // (ver EntregaDigitalCotizacion/Pedido); editar esto después NUNCA
  // cambia una Cotización/Pedido ya creada.
  entregaDigital    ProductoEntregaDigital?

  @@index([instanciaId])
  @@index([sku])
  @@index([nombre])
  @@index([categoria])
}

// Valores por defecto de entrega digital de un Producto — ver comentario en
// Producto.entregaDigital. Todos los campos abiertos/opcionales, igual
// criterio que EntregaDigitalCotizacion/Pedido. Sin `email` a propósito: el
// email es del comprador, no del producto.
model ProductoEntregaDigital {
  id                  String                @id @default(cuid())
  metodo              MetodoEntregaDigital?
  url                 String?
  archivo             String?
  codigo              String?
  usuarioAcceso       String?
  instrucciones       String?
  observaciones       String?
  requiereSeguimiento Boolean               @default(false)
  tipoSeguimiento     String?
  creadoEn            DateTime              @default(now())
  actualizadoEn       DateTime              @updatedAt

  productoId String   @unique
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId])
}

// =====================
// ACTIVIDADES
// =====================

model Actividad {
  id            String             @id @default(cuid())
  tipo          TipoActividad      @default(TAREA)
  prioridad     PrioridadActividad @default(MEDIA)
  titulo        String
  descripcion   String?
  fecha         DateTime
  completada    Boolean            @default(false)
  completadaEn  DateTime?
  metadata      Json?
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt

  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id])

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id])

  pedidoId String?
  pedido   Pedido? @relation(fields: [pedidoId], references: [id])

  cotizacionId String?
  cotizacion   Cotizacion? @relation(fields: [cotizacionId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  @@index([instanciaId])
  @@index([fecha])
  @@index([completada])
  @@index([pedidoId])
  @@index([cotizacionId])
}

// =====================
// COTIZACIONES
// =====================

model Cotizacion {
  id               String           @id @default(cuid())
  numero           String
  estado           EstadoCotizacion @default(BORRADOR)
  fechaEmision     DateTime         @default(now())
  fechaVencimiento DateTime?
  subtotal         Decimal          @default(0)
  descuento        Decimal          @default(0)
  impuesto         Decimal          @default(0)
  // Costo de envío — se suma al `total` (lo que paga el cliente) pero se
  // excluye a propósito de los KPIs "Total ventas"/"Total ventas · mes
  // actual" de Pedidos (no es ganancia, ver obtenerPedidosKpis).
  costoEnvio       Decimal          @default(0)
  total            Decimal          @default(0)
  moneda           String           @default("PEN")
  notas            String?
  metadata         Json?
  // Calculado en el servidor a partir del producto de la primera línea que
  // tenga uno vinculado (FISICO si ninguna línea tiene producto) — nunca lo
  // manda el cliente. Determina cuál de entrega/servicio/entregaDigital usa
  // esta cotización. Ver resolverTipoCumplimiento en actions.ts.
  tipoCumplimiento TipoProducto     @default(FISICO)
  creadoEn         DateTime         @default(now())
  actualizadoEn    DateTime         @updatedAt

  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id])

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  lineas      CotizacionLinea[]
  pedidos     Pedido[]
  campos      CampoPersonalizadoValor[]
  actividades Actividad[]
  // entrega/servicio: solo una existe a la vez, según tipoCumplimiento —
  // sin cambios. entregaDigital ya NO vive acá: pasó a CotizacionLinea
  // (una cotización puede tener varios productos DIGITAL, cada uno con su
  // propia entrega — ver CotizacionLinea.entregaDigital).
  entrega     EntregaCotizacion?
  servicio    ServicioCotizacion?

  @@unique([instanciaId, numero])
  @@index([instanciaId])
  @@index([estado])
  @@index([oportunidadId])
}

// Espejo de EntregaPedido — se captura ya en la cotización para que, al
// aprobarla y generar el Pedido, la información de entrega pase directo sin
// que el usuario tenga que volver a registrarla (ver aprobarCotizacion).
// A esta altura (cotización, antes de despachar nada) todavía no existen
// numeroGuia/urlSeguimiento — esos se completan recién en el Pedido.
// Solo aplica cuando Cotizacion.tipoCumplimiento = FISICO.
model EntregaCotizacion {
  id            String        @id @default(cuid())
  metodoEntrega MetodoEntrega @default(COURIER_EXTERNO)
  estadoEntrega EstadoEntrega @default(PENDIENTE)
  fechaEstimada DateTime?
  observaciones String?
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt

  cotizacionId String     @unique
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  transportistaId String?
  transportista   Transportista? @relation(fields: [transportistaId], references: [id])

  @@index([cotizacionId])
}

// Cumplimiento cuando Cotizacion.tipoCumplimiento = SERVICIO — espejo de
// ServicioPedido. Todos los campos abiertos/opcionales a propósito: las
// reglas de obligatoriedad se resuelven después desde el Flujo de Venta.
model ServicioCotizacion {
  id            String             @id @default(cuid())
  modalidad     ModalidadServicio?
  fecha         DateTime?
  hora          String?
  duracion      String?
  ubicacion     String?
  direccion     String?
  responsable   String?
  instrucciones String?
  observaciones String?
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt

  cotizacionId String     @unique
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@index([cotizacionId])
}

// Cumplimiento cuando la línea usa un producto DIGITAL — espejo de
// EntregaDigitalPedido. Todos los campos abiertos/opcionales. Anclada a la
// LÍNEA (no a la cotización completa): una cotización con varios productos
// DIGITAL distintos tiene una fila independiente por cada uno — se copia
// como snapshot desde Producto.entregaDigital al agregar la línea, y queda
// totalmente editable sin depender del producto (ver actions.ts).
model EntregaDigitalCotizacion {
  id              String                @id @default(cuid())
  metodo          MetodoEntregaDigital?
  email           String?
  url             String?
  archivo         String?
  codigo          String?
  usuarioAcceso   String?
  fechaEntrega    DateTime?
  fechaExpiracion DateTime?
  instrucciones   String?
  observaciones   String?
  creadoEn        DateTime              @default(now())
  actualizadoEn   DateTime              @updatedAt

  cotizacionLineaId String          @unique
  cotizacionLinea   CotizacionLinea @relation(fields: [cotizacionLineaId], references: [id], onDelete: Cascade)

  @@index([cotizacionLineaId])
}

model CotizacionLinea {
  id             String  @id @default(cuid())
  descripcion    String?
  cantidad       Decimal
  precioUnitario Decimal
  descuento      Decimal @default(0)
  impuesto       Decimal @default(0)
  subtotal       Decimal
  total          Decimal @default(0)
  orden          Int     @default(0)
  metadata       Json?

  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id])

  entregaDigital EntregaDigitalCotizacion?
}

// =====================
// PEDIDOS
// =====================

model Pedido {
  id     String       @id @default(cuid())
  numero String
  estado EstadoPedido @default(PENDIENTE)

  // Datos del comprador (pedido manual sin contacto en sistema)
  nombre        String?
  apellido      String?
  telefono      String?
  email         String?
  ruc           String?
  empresaNombre String?

  fechaPedido      DateTime     @default(now())
  fechaEntrega     DateTime?
  // Fecha límite para tener en cuenta el pedido (deadline configurable por el
  // usuario) — usada para las métricas "Pendientes"/"Expirados" del listado.
  fechaExpiracion  DateTime?
  subtotal         Decimal      @default(0)
  descuento        Decimal      @default(0)
  impuesto         Decimal      @default(0)
  // Costo de envío — se suma al `total` (lo que paga el cliente) pero se
  // excluye a propósito de "Total ventas"/"Total ventas · mes actual" en
  // los KPIs del listado (no es ganancia, ver obtenerPedidosKpis).
  costoEnvio       Decimal      @default(0)
  total            Decimal      @default(0)
  moneda           String       @default("PEN")
  notas            String?
  metadata         Json?
  // Igual que Cotizacion.tipoCumplimiento — se copia directo de la
  // cotización de origen si el pedido nace de una aprobación, o se calcula
  // igual (primera línea con producto) si el pedido se crea directo.
  tipoCumplimiento TipoProducto @default(FISICO)
  creadoEn         DateTime     @default(now())
  actualizadoEn    DateTime     @updatedAt

  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id])

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  cotizacionId String?
  cotizacion   Cotizacion? @relation(fields: [cotizacionId], references: [id])

  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  flujoVentaId String?
  flujoVenta   FlujoVenta? @relation(fields: [flujoVentaId], references: [id])

  flujoVentaEtapaId String?
  flujoVentaEtapa   FlujoVentaEtapa? @relation(fields: [flujoVentaEtapaId], references: [id])

  lineas          PedidoLinea[]
  campos          CampoPersonalizadoValor[]
  historialEtapas PedidoHistorialEtapa[]
  historial       PedidoHistorial[]
  disparadorJobs  DisparadorJob[]
  actividades     Actividad[]
  // entrega/servicio: solo una existe a la vez, según tipoCumplimiento —
  // sin cambios. entregaDigital ya NO vive acá: pasó a PedidoLinea (mismo
  // motivo que en Cotizacion — ver PedidoLinea.entregaDigital).
  entrega         EntregaPedido?
  servicio        ServicioPedido?

  @@unique([instanciaId, numero])
  @@index([instanciaId])
  @@index([estado])
  @@index([flujoVentaEtapaId])
  @@index([telefono])
  @@index([email])
}

model PedidoLinea {
  id             String  @id @default(cuid())
  descripcion    String?
  cantidad       Decimal
  precioUnitario Decimal
  descuento      Decimal @default(0)
  impuesto       Decimal @default(0)
  subtotal       Decimal
  total          Decimal @default(0)
  orden          Int     @default(0)
  metadata       Json?

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id])

  entregaDigital EntregaDigitalPedido?
}

// =====================
// ENTREGA Y TRANSPORTISTAS
// =====================

model Transportista {
  id            String            @id @default(cuid())
  nombre        String
  tipo          TipoTransportista @default(COURIER_EXTERNO)
  activo        Boolean           @default(true)
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  entregas           EntregaPedido[]
  entregasCotizacion EntregaCotizacion[]

  @@index([instanciaId])
}

// Solo aplica cuando Pedido.tipoCumplimiento = FISICO.
model EntregaPedido {
  id             String        @id @default(cuid())
  metodoEntrega  MetodoEntrega @default(COURIER_EXTERNO)
  estadoEntrega  EstadoEntrega @default(PENDIENTE)
  numeroGuia     String?
  urlSeguimiento String?
  fechaEstimada  DateTime?
  observaciones  String?
  creadoEn       DateTime      @default(now())
  actualizadoEn  DateTime      @updatedAt

  pedidoId String @unique
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  transportistaId String?
  transportista   Transportista? @relation(fields: [transportistaId], references: [id])

  @@index([pedidoId])
}

// Cumplimiento cuando Pedido.tipoCumplimiento = SERVICIO — espejo de
// ServicioCotizacion. Todos los campos abiertos/opcionales a propósito:
// las reglas de obligatoriedad se resuelven después desde el Flujo de
// Venta.
model ServicioPedido {
  id            String             @id @default(cuid())
  modalidad     ModalidadServicio?
  fecha         DateTime?
  hora          String?
  duracion      String?
  ubicacion     String?
  direccion     String?
  responsable   String?
  instrucciones String?
  observaciones String?
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt

  pedidoId String @unique
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
}

// Cumplimiento cuando Pedido.tipoCumplimiento = DIGITAL — espejo de
// EntregaDigitalCotizacion. Todos los campos abiertos/opcionales.
// Anclada a la LÍNEA — ver comentario en EntregaDigitalCotizacion (mismo
// motivo: un pedido puede tener varios productos DIGITAL distintos).
model EntregaDigitalPedido {
  id              String                @id @default(cuid())
  metodo          MetodoEntregaDigital?
  email           String?
  url             String?
  archivo         String?
  codigo          String?
  usuarioAcceso   String?
  fechaEntrega    DateTime?
  fechaExpiracion DateTime?
  instrucciones   String?
  observaciones   String?
  creadoEn        DateTime              @default(now())
  actualizadoEn   DateTime              @updatedAt

  pedidoLineaId String      @unique
  pedidoLinea   PedidoLinea @relation(fields: [pedidoLineaId], references: [id], onDelete: Cascade)

  @@index([pedidoLineaId])
}

// =====================
// EVENTOS / AUDITORÍA
// =====================

model EventoLog {
  id          String   @id @default(cuid())
  tipo        String
  payload     Json
  ocurridoEn  DateTime @default(now())
  entidadTipo String?
  entidadId   String?
  usuarioId   String?

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@index([instanciaId])
  @@index([entidadTipo, entidadId])
  @@index([tipo])
  @@index([ocurridoEn])
}

// =====================
// HISTORIAL DE IMPORTACIONES
// =====================

model HistorialImportacion {
  id                String            @id @default(cuid())
  entidad           String
  archivoNombre     String
  archivoTipo       String
  archivoPeso       Int
  totalRegistros    Int
  registrosExitosos Int
  registrosConError Int
  errores           Json
  estado            EstadoImportacion @default(EN_PROCESO)
  fechaCreacion     DateTime          @default(now())

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioId String?

  @@index([instanciaId])
  @@index([fechaCreacion])
}

// =====================
// DISPARADORES (TRIGGERS)
// =====================

model Disparador {
  id            String               @id @default(cuid())
  nombre        String
  activo        Boolean              @default(true)
  orden         Int                  @default(0)
  delayMinutos  Int?
  tipo          TipoAccionDisparador
  config        Json
  creadoEn      DateTime             @default(now())
  actualizadoEn DateTime             @updatedAt

  // Pipeline CRM (oportunidades) — opcionales
  stageId String?
  stage   PipelineStage? @relation(fields: [stageId], references: [id], onDelete: Cascade)

  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  // Flujo de Venta (pedidos) — opcionales
  flujoVentaEtapaId String?
  flujoVentaEtapa   FlujoVentaEtapa? @relation(fields: [flujoVentaEtapaId], references: [id], onDelete: Cascade)

  flujoVentaId String?
  flujoVenta   FlujoVenta? @relation(fields: [flujoVentaId], references: [id], onDelete: Cascade)

  jobs DisparadorJob[]

  @@index([stageId])
  @@index([pipelineId])
  @@index([flujoVentaEtapaId, activo])
  @@index([flujoVentaId])
}

model DisparadorJob {
  id          String              @id @default(cuid())
  estado      EstadoDisparadorJob @default(PENDIENTE)
  ejecutarEn  DateTime
  payload     Json
  resultado   Json?
  error       String?
  creadoEn    DateTime            @default(now())
  procesadoEn DateTime?

  disparadorId String
  disparador   Disparador @relation(fields: [disparadorId], references: [id])

  // Oportunidad (CRM) — opcional
  oportunidadId String?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)

  // Pedido (Ventas) — opcional
  pedidoId String?
  pedido   Pedido? @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  // Denormalizados para búsqueda rápida
  stageId           String?
  pipelineId        String?
  flujoVentaEtapaId String?
  flujoVentaId      String?

  @@index([estado, ejecutarEn])
  @@index([oportunidadId, stageId])
  @@index([pedidoId, flujoVentaEtapaId])
  @@index([disparadorId])
}

// =====================
// FLUJO DE VENTA (PEDIDOS)
// =====================

model FlujoVenta {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  esDefault     Boolean  @default(false)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  etapas       FlujoVentaEtapa[]
  pedidos      Pedido[]
  disparadores Disparador[]

  @@index([instanciaId])
}

model FlujoVentaEtapa {
  id                   String   @id @default(cuid())
  nombre               String
  descripcion          String?
  color                String?
  orden                Int      @default(0)
  esInicial            Boolean  @default(false)
  esFinal              Boolean  @default(false)
  esCancelacion        Boolean  @default(false)
  esSecuencial         Boolean  @default(true)
  permiteEditarPedido  Boolean  @default(true)
  permiteEditarEntrega Boolean  @default(false)
  activo               Boolean  @default(true)
  creadoEn             DateTime @default(now())
  actualizadoEn        DateTime @updatedAt

  flujoVentaId String
  flujoVenta   FlujoVenta @relation(fields: [flujoVentaId], references: [id], onDelete: Cascade)

  parentId String?
  parent   FlujoVentaEtapa?  @relation("EtapaTree", fields: [parentId], references: [id])
  children FlujoVentaEtapa[] @relation("EtapaTree")

  pedidos      Pedido[]
  reglas       FlujoVentaRegla[]
  historial    PedidoHistorialEtapa[]
  disparadores Disparador[]

  @@index([flujoVentaId, orden])
  @@index([flujoVentaId])
  @@index([parentId])
}

model FlujoVentaRegla {
  id            String   @id @default(cuid())
  nombre        String
  descripcion   String?
  activo        Boolean  @default(true)
  prioridad     Int      @default(0)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Gobierno de la regla — ver Reglas de validación (src/sales/flujo-venta/reglas/)
  estado EstadoFlujoVentaRegla @default(PUBLICADA)

  // Árbol tipado AND/OR (GroupNode/ConditionNode, ver reglas/tipos.ts). Si es
  // null, el evaluador cae al comportamiento legado: AND plano sobre
  // `condiciones` — así las reglas creadas antes de este árbol se siguen
  // evaluando exactamente igual que hoy, sin necesidad de migrar datos.
  arbolCondiciones Json?

  mensajeFallo      String?
  mostrarPendientes Boolean @default(true)
  version           Int     @default(1)

  // Auditoría — string plano (sin FK), mismo patrón que
  // PedidoHistorialEtapa.usuarioId.
  creadoPorId      String?
  actualizadoPorId String?

  etapaDestinoId String
  etapaDestino   FlujoVentaEtapa @relation(fields: [etapaDestinoId], references: [id], onDelete: Cascade)

  // Tabla legada — sigue sirviendo a las reglas sin `arbolCondiciones`.
  condiciones FlujoVentaReglaCondicion[]

  @@index([etapaDestinoId])
}

model FlujoVentaReglaCondicion {
  id       String            @id @default(cuid())
  campo    String
  operador OperadorCondicion
  valor    String

  reglaId String
  regla   FlujoVentaRegla @relation(fields: [reglaId], references: [id], onDelete: Cascade)

  @@index([reglaId])
}

model PedidoHistorialEtapa {
  id                  String              @id @default(cuid())
  etapaNombre         String
  etapaAnteriorNombre String?
  tipo                TipoMovimientoEtapa
  origen              String              @default("SISTEMA")
  notas               String?
  referencia          String?
  usuarioNombre       String?
  creadoEn            DateTime            @default(now())

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  etapaId String
  etapa   FlujoVentaEtapa @relation(fields: [etapaId], references: [id])

  usuarioId String?

  @@index([pedidoId])
  @@index([etapaId])
}

model PedidoHistorial {
  id            String   @id @default(cuid())
  accion        String
  valorAnterior Json?
  valorNuevo    Json?
  usuarioNombre String?
  creadoEn      DateTime @default(now())

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  usuarioId String?

  @@index([pedidoId])
}

// =====================
// INTEGRACIONES
// =====================

model IntegracionInstancia {
  id            String            @id @default(cuid())
  clave         String
  estado        EstadoIntegracion @default(INSTALADA)
  configuracion Json?
  metadata      Json?
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@unique([instanciaId, clave])
  @@index([instanciaId])
  @@index([clave])
}

// =====================
// CONFIGURACIÓN EMPRESA
// =====================

model ConfiguracionEmpresa {
  id                String   @id @default(cuid())
  nombreEmpresa     String?
  nombreComercial   String?
  razonSocial       String?
  ruc               String?
  tipoNegocio       String?
  industria         String?
  correoPrincipal   String?
  telefonoPrincipal String?
  whatsappPrincipal String?
  sitioWeb          String?
  pais              String?
  provincia         String?
  ciudad            String?
  direccion         String?
  zonaHoraria       String   @default("America/Lima")
  monedaPrincipal   String   @default("PEN")
  idiomaPrincipal   String   @default("es")
  formatoFecha      String   @default("DD/MM/YYYY")
  formatoHora       String   @default("24h")
  activo            Boolean  @default(true)
  creadoEn          DateTime @default(now())
  actualizadoEn     DateTime @updatedAt

  instanciaId String    @unique
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
}

// =====================
// PLANTILLAS CRM
// =====================

model PlantillaCRM {
  id             String        @id @default(cuid())
  nombre         String
  alias          String
  descripcion    String?
  tipo           TipoPlantilla @default(TEXTO)
  contenidoTexto String?
  imagenUrl      String?
  activo         Boolean       @default(true)
  creadoEn       DateTime      @default(now())
  actualizadoEn  DateTime      @updatedAt

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  creadoPorId      String?
  actualizadoPorId String?

  @@unique([instanciaId, alias])
  @@index([instanciaId])
  @@index([alias])
  @@index([activo])
}

// =====================
// MEDIA / ARCHIVOS
// =====================

model MediaArchivo {
  id String @id @default(cuid())

  // Tenant
  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  // Módulo de origen
  modulo      String // "productos" | "plantillas" | "logos" | "conversaciones" | ...
  entidadTipo String? // tipo de entidad relacionada, ej: "producto"
  entidadId   String? // ID de la entidad relacionada

  // Archivo original
  nombreOriginal String
  mimeOriginal   String
  pesoOriginal   Int
  anchoOriginal  Int?
  altoOriginal   Int?

  // Archivo procesado
  mimeOptimizado String @default("image/webp")
  pesoOptimizado Int?
  ancho          Int?
  alto           Int?

  // URLs de storage
  keyOptimizado String // clave en el storage (ej: {instanciaId}/productos/optimized/{id}.webp)
  keyThumbnail  String? // clave del thumbnail
  keyOriginal   String? // clave del original (si se guarda)

  urlOptimizada String
  urlThumbnail  String?
  urlOriginal   String?

  // Metadatos
  hash            String // SHA-256 del buffer original para deduplicación
  proveedor       String      @default("local") // "r2" | "local" | "s3" | "azure"
  canalOrigen     String? // "web" | "whatsapp" | "instagram" | ...
  estadoProcesado EstadoMedia @default(LISTO)
  errorMensaje    String?

  // Relación con contacto (para cascade delete y limpieza de storage)
  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  // Auditoría
  creadoPorId   String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  mensajes MensajeConversacion[]

  @@unique([instanciaId, hash])
  @@index([instanciaId])
  @@index([instanciaId, modulo])
  @@index([entidadTipo, entidadId])
  @@index([contactoId])
  @@index([hash])
  @@index([estadoProcesado])
}

// =====================
// CONVERSACIONES
// =====================

// Identificador externo del contacto por canal (teléfono, email, instagramId, etc.)
model ContactoIdentificadorCanal {
  id            String  @id @default(cuid())
  canal         String // "whatsapp", "email", "instagram", "tiktok"
  identificador String // número, email, userId externo
  handle        String? // @usuario visible del contacto en el canal, si el canal lo expone (ej. Instagram)

  contactoId String
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  creadoEn DateTime @default(now())

  @@unique([canal, identificador, instanciaId])
  @@index([instanciaId])
  @@index([contactoId])
}

// Cuenta configurada por canal (número de WhatsApp, email, cuenta Instagram, etc.)
model CuentaCanal {
  id            String  @id @default(cuid())
  canal         String // "whatsapp_lite", "whatsapp_business", "email", "instagram", "facebook_messenger"
  nombre        String // "WhatsApp Principal", "Email Ventas"
  identificador String // +51955..., info@empresa.com
  configuracion Json // tokens, credenciales
  activa        Boolean @default(true)

  // Proveedor de autenticación usado para obtener el token (solo relevante
  // para canal "instagram"; el resto de canales queda en su default). No
  // migra tokens existentes: las cuentas conectadas antes de este campo
  // quedan como "MetaFacebook" (su flujo real) vía el default de la migración.
  proveedorAuth   ProveedorAuthCanal @default(MetaFacebook)
  tokenExpiraEn   DateTime? // vencimiento del access token, si el proveedor lo informa
  tokenRenovadoEn DateTime? // última vez que se renovó/reemplazó el access token

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)

  stageId String?
  stage   PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  conversaciones Conversacion[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  // Nota: además de este índice existen dos índices únicos parciales,
  // creados a mano porque Prisma no soporta índices únicos parciales en el
  // schema DSL:
  //   - (instanciaId, identificador) WHERE canal = 'instagram'
  //     (migración 20260817120000_add_instagram_auth_provider)
  //   - (instanciaId, identificador) WHERE canal = 'facebook_messenger'
  //     (migración 20260827000000_add_facebook_messenger_canal)
  // Ambos se restringen a su canal específico para no arriesgar otros
  // canales (whatsapp_lite, email) que hoy no garantizan esa unicidad en
  // datos existentes. Si se corre `prisma migrate dev` después de tocar
  // este modelo, revisar el diff propuesto antes de aceptar — Prisma puede
  // proponer eliminar esos índices por no estar declarados aquí.

  @@index([instanciaId])
  @@index([canal])
  @@index([stageId])
}

// Agrupador de mensajes por contacto + canal/cuenta
model Conversacion {
  id               String                    @id @default(cuid())
  asunto           String?
  estado           EstadoConversacion        @default(ABIERTA)
  clasificacion    ClasificacionConversacion @default(NINGUNA)
  clasificadoEn    DateTime?
  clasificadoPorId String?

  oportunidadGanadaRelId String?
  oportunidadGanadaRel   Oportunidad? @relation("ConvOportunidadGanada", fields: [oportunidadGanadaRelId], references: [id], onDelete: SetNull)

  contactoId String
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  cuentaCanalId String?
  cuentaCanal   CuentaCanal? @relation(fields: [cuentaCanalId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: SetNull)

  mensajes      MensajeConversacion[]
  oportunidades OportunidadConversacion[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([instanciaId])
  @@index([contactoId])
  @@index([cuentaCanalId])
  @@index([estado])
  @@index([clasificacion])
}

// Mensaje individual dentro de una conversación
model MensajeConversacion {
  id            String        @id @default(cuid())
  contenido     String?
  tipo          TipoMensaje   @default(TEXTO)
  remitente     RemitenteMsg
  estado        EstadoMensaje @default(ENVIADO)
  esNotaInterna Boolean       @default(false)
  idExterno     String? // ID del mensaje en el canal externo

  conversacionId String
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  usuarioId String? // agente que envió (si remitente = AGENTE)

  mediaUrl      String?
  mediaMimeType String?
  mediaDuracion Int?

  // FK a MediaArchivo para imágenes/media procesada con control de estado
  mediaArchivoId String?
  mediaArchivo   MediaArchivo? @relation(fields: [mediaArchivoId], references: [id], onDelete: SetNull)

  creadoEn  DateTime  @default(now())
  enviadoEn DateTime?
  leidoEn   DateTime?

  // Info funcional del fallo cuando estado = FALLIDO (ver EnvioMensajeError
  // en src/conversaciones/errores.ts) — no el stack trace técnico, eso
  // sigue solo en logs. codigoError es el slug estable que usa el frontend
  // para no depender del texto (localizado) que devuelve Meta.
  codigoError String?
  motivoError String?
  fechaError  DateTime?

  reacciones MensajeReaccion[]

  @@index([conversacionId])
  @@index([creadoEn])
  @@index([remitente])
  // Último mensaje del CONTACTO en una conversación — la ventana de
  // mensajería de Instagram se calcula desde ahí, no desde el último
  // mensaje en general (ver instagram-ventana.ts).
  @@index([conversacionId, remitente, creadoEn])
}

model MensajeReaccion {
  id            String       @id @default(cuid())
  emoji         String
  tipo          TipoReaccion @default(INTERNA)
  nombreUsuario String?
  canal         String?
  idExterno     String?

  mensajeId String
  mensaje   MensajeConversacion @relation(fields: [mensajeId], references: [id], onDelete: Cascade)

  usuarioId  String?
  contactoId String?

  creadoEn DateTime @default(now())

  @@unique([mensajeId, usuarioId, emoji])
  @@unique([mensajeId, contactoId, emoji])
  @@index([mensajeId])
}

// Relación conversación ↔ oportunidad
model OportunidadConversacion {
  id       String  @id @default(cuid())
  esActiva Boolean @default(true)

  oportunidadId String
  oportunidad   Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)

  conversacionId String
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  creadoEn DateTime @default(now())

  @@unique([oportunidadId, conversacionId])
  @@index([oportunidadId])
  @@index([conversacionId])
}

enum ClasificacionConversacion {
  NINGUNA
  POSTVENTA
  SOPORTE
  COMERCIAL
}

// =====================
// CAPA DE INTELIGENCIA ARTIFICIAL
// =====================

// =====================
// ENUMS DE IA
// =====================

enum ProveedorIAEnum {
  ANTHROPIC
  OPENAI
  GEMINI
  DEEPSEEK
  NVIDIA
  LOCAL
}

enum TareaIA {
  CHAT
  RESUMEN
  CLASIFICACION
  SENTIMIENTO
  EXTRACCION_ENTIDADES
  REPORTE
  EMBEDDINGS
  // 010-enrutamiento-modelos-ia-por-objetivo — distinto de EXTRACCION_ENTIDADES
  // genérica: identificar qué producto del catálogo menciona el cliente.
  IDENTIFICACION_PRODUCTO
}

enum TipoMemoriaIA {
  EPISODICO
  SEMANTICO
  PROCEDURAL
}

enum TipoAgenteIA {
  COMERCIAL
  GERENCIA
}

// =====================
// MODELOS DE IA
// =====================

// Configuración global de IA por instancia (1-1)
model ConfiguracionIA {
  id                  String          @id @default(cuid())
  habilitado          Boolean         @default(false)
  proveedorDefault    ProveedorIAEnum @default(ANTHROPIC)
  modeloDefault       String          @default("claude-sonnet-4-6")
  temperaturaDefault  Float           @default(0.7)
  limiteTokensDiarios Int?
  limiteTokensMensual Int?
  fallbackHabilitado  Boolean         @default(true)
  creadoEn            DateTime        @default(now())
  actualizadoEn       DateTime        @updatedAt

  instanciaId String    @unique
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
}

// Credenciales y configuración de cada proveedor IA por instancia
model ProveedorIA {
  id                     String          @id @default(cuid())
  proveedor              ProveedorIAEnum
  apiKeyEncriptada       String?
  baseUrl                String?
  modelosDisponibles     Json            @default("[]")
  activo                 Boolean         @default(true)
  prioridad              Int             @default(1)
  limitePorMinuto        Int?
  limitePorDia           Int?
  costoInputPorMilToken  Decimal?
  costoOutputPorMilToken Decimal?
  timeoutMs              Int             @default(30000)
  reintentosMax          Int             @default(2)
  casosDeUso             Json?
  tipoAgenteIA           TipoAgenteIA?
  creadoEn               DateTime        @default(now())
  actualizadoEn          DateTime        @updatedAt

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usoIA UsoIA[]

  @@unique([instanciaId, proveedor, tipoAgenteIA])
  @@index([instanciaId])
  @@index([instanciaId, activo, prioridad])
}

// Extensión de Usuario (tipo=AGENTE) con capacidades de IA
model AgenteIAConfig {
  id                  String       @id @default(cuid())
  sistemaPrompt       String?
  personalidad        String?
  objetivo            String?
  especialidad        String?
  tipo                TipoAgenteIA @default(COMERCIAL)
  temperaturaOverride Float?
  modeloPreferido     String?
  herramientas        Json?
  canalesPermitidos   Json?
  memoriaHabilitada   Boolean      @default(true)
  limiteTokensCtx     Int          @default(4000)
  instrucciones       Json?
  configuracionTono   Json?

  // --- 009-perfil-agente-estructurado-versionado ---
  // Todos opcionales: un agente sin ninguno configurado mantiene el
  // comportamiento exacto que tenía antes de esta extensión (ver
  // construirSystemPrompt en src/ai/prompt/builder.ts).
  nombreAgente                   String?
  rol                            String?
  idiomaPrincipal                String?
  idiomasPermitidos              Json? // string[]
  longitudRespuesta              String? // "CORTA" | "MEDIA" | "LARGA"
  proactividad                   String? // "BAJA" | "MEDIA" | "ALTA"
  intensidadComercial            String? // "SUAVE" | "MODERADA" | "DIRECTA"
  estiloRecomendacion            String? // "CONSULTIVO" | "DIRECTO" | "COMPARATIVO"
  frasesPreferidas               Json? // string[]
  frasesProhibidas               Json? // string[]
  comportamientosProhibidos      Json? // string[]
  reglasPersonalizadas           Json? // string[]
  condicionesTransferenciaHumano Json? // string[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  memorias       MemoriaAgenteIA[]
  usoIA          UsoIA[]
  pipelineStages PipelineStage[]
  versiones      AgenteIAConfigVersion[]
}

// --- 009-perfil-agente-estructurado-versionado ---

enum EstadoVersionAgenteIA {
  BORRADOR
  PUBLICADA
}

// Historial append-only de la configuración de un AgenteIAConfig. La fila
// "viva" de AgenteIAConfig siempre representa la versión PUBLICADA vigente
// (se actualiza atómicamente al publicar) — ver research.md de la spec para
// el porqué de este modelado (evita reescribir a los consumidores actuales
// de AgenteIAConfig).
model AgenteIAConfigVersion {
  id        String                @id @default(cuid())
  numero    Int? // null mientras es BORRADOR — se asigna al publicar
  estado    EstadoVersionAgenteIA
  contenido Json // fotografía completa de los campos configurables de AgenteIAConfig

  publicadaEn   DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  agenteIAConfigId String
  agenteIAConfig   AgenteIAConfig @relation(fields: [agenteIAConfigId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  creadaPorUsuarioId String?
  creadaPorUsuario   Usuario? @relation("VersionesAgenteIACreadas", fields: [creadaPorUsuarioId], references: [id], onDelete: SetNull)

  usoIA UsoIA[]

  @@unique([agenteIAConfigId, numero])
  @@index([agenteIAConfigId, estado])
  @@index([instanciaId])
}

// Memoria persistente del agente IA
model MemoriaAgenteIA {
  id       String        @id @default(cuid())
  tipo     TipoMemoriaIA
  clave    String
  valor    String
  expiraEn DateTime?
  creadoEn DateTime      @default(now())

  agenteIAConfigId String
  agenteIAConfig   AgenteIAConfig @relation(fields: [agenteIAConfigId], references: [id], onDelete: Cascade)

  @@index([agenteIAConfigId, tipo])
  @@index([expiraEn])
}

// Auditoría de uso y costos de IA
model UsoIA {
  id            String   @id @default(cuid())
  modelo        String
  tarea         TareaIA
  tokensInput   Int      @default(0)
  tokensOutput  Int      @default(0)
  costoEstimado Decimal?
  tiempoMs      Int      @default(0)
  exito         Boolean  @default(true)
  error         String?
  entidadTipo   String?
  entidadId     String?
  creadoEn      DateTime @default(now())

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  proveedorIAId String?
  proveedorIA   ProveedorIA? @relation(fields: [proveedorIAId], references: [id], onDelete: SetNull)

  agenteIAConfigId String?
  agenteIAConfig   AgenteIAConfig? @relation(fields: [agenteIAConfigId], references: [id], onDelete: SetNull)

  // 009-perfil-agente-estructurado-versionado — qué versión exacta generó esta respuesta
  agenteIAConfigVersionId String?
  agenteIAConfigVersion   AgenteIAConfigVersion? @relation(fields: [agenteIAConfigVersionId], references: [id], onDelete: SetNull)

  @@index([instanciaId, creadoEn])
  @@index([instanciaId, tarea])
  @@index([proveedorIAId])
  @@index([agenteIAConfigVersionId])
}
