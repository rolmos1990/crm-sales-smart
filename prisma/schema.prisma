  EN_PROCESO
  COMPLETADO
  COMPLETADO_CON_ERRORES
  FALLIDO
}

enum TipoMensaje {
  TEXTO
  IMAGEN
  VIDEO
  AUDIO
  NOTA_VOZ
  DOCUMENTO
  PLANTILLA
  BOTON
  EVENTO_SISTEMA
}

enum RemitenteMsg {
  CONTACTO
  AGENTE
  SISTEMA
  BOT
  AGENTE_CANAL_NATIVO // mensaje saliente detectado por eco, enviado desde la app/web nativa del canal (no desde Karia)
}

enum EstadoMensaje {
  RECIBIDO
  ENVIADO
  ENTREGADO
  LEIDO
  FALLIDO
}

enum TipoReaccion {
  CANAL // sincroniza con canal externo (WhatsApp)
  INTERNA // solo visible en CRM
}

// =====================
// INSTANCIA / TENANT
// =====================

model Instancia {
  id            String          @id @default(cuid())
  nombre        String
  slug          String          @unique
  descripcion   String?
  dominio       String?
  logoUrl       String?
  estado        EstadoInstancia @default(ACTIVA)
  configuracion Json?
  metadata      Json?
  creadoEn      DateTime        @default(now())
  actualizadoEn DateTime        @updatedAt

  usuarios             UsuarioInstancia[]
  empresas             Empresa[]
  contactos            Contacto[]
  pipelines            Pipeline[]
  oportunidades        Oportunidad[]
  productos            Producto[]
  actividades          Actividad[]
  cotizaciones         Cotizacion[]
  pedidos              Pedido[]
  tags                 Tag[]
  etiquetasProducto    EtiquetaProducto[]
  campos               CampoPersonalizado[]
  eventos              EventoLog[]
  integraciones        IntegracionInstancia[]
  configuracionEmpresa ConfiguracionEmpresa?
  plantillas           PlantillaCRM[]
  mediaArchivos        MediaArchivo[]
  cuentasCanal         CuentaCanal[]
  conversaciones       Conversacion[]
  identificadoresCanal ContactoIdentificadorCanal[]
  buzonesCorreoEstado  BuzonCorreoEstado[]
  mensajesCorreo       MensajeCorreo[]

  flujosVenta            FlujoVenta[]
  importaciones          HistorialImportacion[]
  transportistas         Transportista[]
  // 022-transportistas-zonas-tarifas
  zonasEntrega           ZonaEntrega[]
  tarifasTransportista   TarifaTransportistaZona[]
  transportistaHistorial TransportistaHistorial[]
  // 024-alias-ubicaciones-transportistas
  aliasesUbicacion       AliasUbicacion[]

  // 049-proveedores-de-voz
  proveedoresVoz ProveedorVoz[]
  usoVoz         UsoVoz[]

  // IA
  configuracionIA                 ConfiguracionIA?
  proveedoresIA                   ProveedorIA[]
  agentesIAConfig                 AgenteIAConfig[]
  usoIA                           UsoIA[]
  agenteIAConfigVersions          AgenteIAConfigVersion[]
  perfilesCliente                 PerfilClienteSnapshot[]
  historialClasificacionContactos ContactoClasificacionHistorial[]
  // 031-memoria-y-ficha-conversacion
  fichasConversacion              FichaConversacionIA[]
  playbooksEstrategia             PlaybookEstrategia[]
  seleccionesEstrategia           SeleccionEstrategiaLog[]
  metodosEntregaConfig            MetodoEntregaConfig[]
  zonasCobertura                  ZonaCobertura[]
  ubicacionesRetiro               UbicacionRetiro[]
  // 016-niveles-autonomia-automatizacion
  autonomiaIntencionConfigs       AutonomiaIntencionConfig[]
  respuestasPendientesRevision    RespuestaPendienteRevision[]
  // 014-conversaciones-piloto-ejemplos-relevantes
  conversacionesPiloto            ConversacionPiloto[]
  recomendacionesComportamiento   RecomendacionComportamiento[]
  ejemplosPrompt                  EjemploPrompt[]
  // 017-aprendizaje-supervisado-auditoria
  evaluacionesRespuestaIA         EvaluacionRespuestaIA[]
  // 026-preparacion-pedidos
  flujoPreparacion                FlujoPreparacion?
  // Workflows (docs/WORKFLOWS-PROPUESTA-ARQUITECTURA.md)
  workflows                       Workflow[]
  workflowAsignaciones            WorkflowAsignacion[]
  // 033-documentacion-vector-store-openai
  documentosAgenteIA              DocumentoAgenteIA[]
  // 042-contactos-analisis-ia
  configuracionAnalisisContactos  ConfiguracionAnalisisContactos?
  colaAnalisisContactos           ContactoAnalisisCola[]
  evaluacionesContactos           ContactoEvaluacion[]
  criterioAnalisisContactos       CriterioAnalisisContactos?
  versionesCriterioAnalisis       CriterioAnalisisContactosVersion[]
  ejecucionesAnalisisContactos    EjecucionAnalisisContactos[]
  itemsEjecucionAnalisis          EjecucionAnalisisContactosItem[]
  resumenesAnalisisContactos      ResumenDiarioAnalisisContactos[]

  /// Vector store de OpenAI donde se indexa la documentación de ESTA cuenta.
  /// Uno por instancia: así el índice de un comercio no contiene bytes de otro
  /// y el techo de 10.000 archivos por store pasa a ser por cuenta, inalcanzable.
  ///
  /// Se crea solo, la primera vez que la cuenta sube un documento — no hay
  /// forma de pre-crear a mano un store por cada tenant. Null = esta cuenta
  /// todavía no subió documentación. Vive en la organización de OpenAI de
  /// Karia (OPENAI_DOCUMENTACION_API_KEY), no en la del cliente.
  vectorStoreDocumentacionId String?

  @@index([slug])
  @@index([estado])
}

// =====================
// USUARIOS
// =====================

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String?
  rol          Rol      @default(AGENTE)
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  tipo     TipoUsuario @default(USUARIO)
  telefono String?
  cargo    String?

  // Zona horaria IANA de preferencia del usuario — SOLO presentación: decide
  // con qué reloj se renderiza un instante en pantalla. Nunca entra en un
  // `where` ni en el cálculo de un rango de día: eso siempre usa la zona de
  // negocio (ConfiguracionEmpresa.zonaHoraria). Si esta zona decidiera los
  // filtros, dos usuarios del mismo tenant verían totales distintos para
  // "ventas de hoy" sin poder reconciliarlos. Null = heredar la de la empresa.
  zonaHoraria String?

  // Autenticación (proveedor externo, ej. Supabase)
  authUserId       String?       @unique
  estado           EstadoUsuario @default(INVITADO)
  intentosFallidos Int           @default(0)
  bloqueadoHasta   DateTime?
  nivelBloqueo     Int           @default(0)
  ultimoLogin      DateTime?

  instancias    UsuarioInstancia[]
  empresas      Empresa[]
  contactos     Contacto[]
  oportunidades Oportunidad[]
  actividades   Actividad[]
  cotizaciones  Cotizacion[]
  pedidos       Pedido[]

  // IA — presente solo en usuarios tipo AGENTE con capacidades IA
  agenteIAConfig AgenteIAConfig?

  // 009-perfil-agente-estructurado-versionado — quién guardó/publicó cada versión
  versionesAgenteIACreadas AgenteIAConfigVersion[] @relation("VersionesAgenteIACreadas")

  // 015-herramientas-operativas-inventario-envios-acciones — quién confirmó un documento generado por IA
  cotizacionesConfirmadas Cotizacion[] @relation("CotizacionesConfirmadasPorUsuario")
  pedidosConfirmados      Pedido[]     @relation("PedidosConfirmadosPorUsuario")

  // 014-conversaciones-piloto-ejemplos-relevantes
  conversacionesPilotoCreadas            ConversacionPiloto[]          @relation("ConversacionesPilotoCreadas")
  recomendacionesComportamientoResueltas RecomendacionComportamiento[] @relation("RecomendacionesResueltas")
  // 026-preparacion-pedidos
  preparacionesAsignadas                 PreparacionPedido[]
  lineasPreparadas                       PedidoLinea[]                 @relation("LineasPreparadasPorUsuario")
}

model UsuarioInstancia {
  id            String   @id @default(cuid())
  rol           Rol      @default(AGENTE)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  oportunidades Oportunidad[]
  actividades   Actividad[]
  cotizaciones  Cotizacion[]
  pedidos       Pedido[]
  empresas      Empresa[]
  contactos     Contacto[]

  @@unique([usuarioId, instanciaId])
  @@index([instanciaId])
  @@index([usuarioId])
}

// =====================
// CRM BASE
// =====================

model Empresa {
  id            String   @id @default(cuid())
  nombre        String
  ruc           String?
  industria     String?
  tamano        String?
  sitioWeb      String?
  telefono      String?
  email         String?
  notas         String?
  activo        Boolean  @default(true)
  metadata      Json?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  contactos     Contacto[]
  oportunidades Oportunidad[]
  actividades   Actividad[]
  cotizaciones  Cotizacion[]
  pedidos       Pedido[]
  campos        CampoPersonalizadoValor[]

  @@index([instanciaId])
  @@index([nombre])
  @@index([ruc])
}

model Contacto {
  id                 String         @id @default(cuid())
  nombre             String
  apellido           String
  email              String?
  telefonoPrincipal  String?
  telefonoSecundario String?
  cargo              String?
  notas              String?
  estado             EstadoContacto @default(LEAD)
  activo             Boolean        @default(true)
  avatarUrl          String?
  metadata           Json?
  creadoEn           DateTime       @default(now())
  actualizadoEn      DateTime       @updatedAt

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usuarioInstanciaId String?
  usuarioInstancia   UsuarioInstancia? @relation(fields: [usuarioInstanciaId], references: [id])

  oportunidades        OportunidadContacto[]
  actividades          Actividad[]
  cotizaciones         Cotizacion[]
  pedidos              Pedido[]
  campos               CampoPersonalizadoValor[]
  tags                 ContactoTag[]
  conversaciones       Conversacion[]
  identificadoresCanal ContactoIdentificadorCanal[]
  mediaArchivos        MediaArchivo[]
  // 012-perfil-dinamico-cliente
  perfilCliente        PerfilClienteSnapshot?

  // 041 — Interés comercial. Lo escriben personas o la IA (042); mientras
  // `nivelInteresFijado` sea true, ningún proceso automático lo cambia.
  // "Cliente" NO vive acá: se deriva en cada consulta de la condición de
  // venta (regla 10 de CLAUDE.md, src/crm/contactos/segmentacion/condiciones.ts).
  nivelInteres              NivelInteres         @default(SIN_EVALUAR)
  nivelInteresOrigen        OrigenClasificacion?
  nivelInteresFijado        Boolean              @default(false)
  nivelInteresActualizadoEn DateTime?

  // 041 — No contactar. Corta los envíos automáticos en enviarMensajeInterno;
  // solo una persona lo vuelve a null.
  noContactarDesde  DateTime?
  noContactarOrigen OrigenClasificacion?
  noContactarPorId  String?

  // 041 — Hechos con fecha materializados para ordenar y filtrar sin agregar
  // sobre mensajes/actividades/pedidos. Solo se escriben desde
  // src/crm/contactos/interaccion.ts.
  ultimaInteraccionEn     DateTime?
  esperandoRespuestaDesde DateTime?

  historialClasificacion ContactoClasificacionHistorial[]

  // 042 — Copia del puntaje vigente para ordenar la tabla sin join (research
  // D15). Se escribe en la misma transacción que ContactoEvaluacion. No choca
  // con la regla 10: es el resultado fechado de una evaluación, como el
  // interés, no algo que se derive de la configuración vigente del flujo.
  puntajeComercial Int?
  evaluacion       ContactoEvaluacion?
  colaAnalisis     ContactoAnalisisCola?

  @@index([instanciaId])
  @@index([nombre])
  @@index([apellido])
  @@index([email])
  @@index([instanciaId, ultimaInteraccionEn])
  @@index([instanciaId, nivelInteres])
  @@index([instanciaId, esperandoRespuestaDesde])
  @@index([instanciaId, noContactarDesde])
  @@index([instanciaId, puntajeComercial])
  // 042 — barrido de reconciliación: contactos nuevos sin fila de cola.
  @@index([instanciaId, creadoEn])
}

/// El orden de declaración ES el orden de "ordenar por interés" (asc = Alto primero).
enum NivelInteres {
  ALTO
  MEDIO
  BAJO
  SIN_EVALUAR
}

enum OrigenClasificacion {
  MANUAL
  REGLA
  IA
}

enum DimensionClasificacion {
  INTERES
  PREFERENCIA_CONTACTO
}

// 041 — Traza de cada cambio de interés o de preferencia de contacto. Solo
// inserción. valorAnterior/valorNuevo son texto porque guarda dos dominios.
model ContactoClasificacionHistorial {
  id                 String                 @id @default(cuid())
  dimension          DimensionClasificacion
  valorAnterior      String?
  valorNuevo         String
  fijado             Boolean                @default(false)
  origen             OrigenClasificacion
  usuarioInstanciaId String?
  creadoEn           DateTime               @default(now())

  contactoId String
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@index([contactoId, creadoEn])
  @@index([instanciaId])
}

// =====================
// 042 — ANÁLISIS INTELIGENTE DE CONTACTOS
// =====================
// Detalle: specs/042-contactos-analisis-ia/ y docs/analisis-contactos.md.
// La planificación vive en PostgreSQL (lease + SKIP LOCKED, mismo patrón que
// DisparadorJob) y no en RabbitMQ: hace falta repartir turnos por cuenta y
// deduplicar por contacto, y ninguna de las dos cosas la da una cola de
// mensajes sin una cola por tenant.

enum ModoAplicacionInteres {
  SOLO_SUGERIR
  APLICAR_AUTOMATICO
}

enum EstadoColaAnalisis {
  AL_DIA
  PENDIENTE
  EN_PROCESO
  FALLIDO
}

/// El orden de declaración ES la prioridad (P0 primero).
enum PrioridadAnalisis {
  P0
  P1
  P2
}

enum TipoEjecucionAnalisis {
  INICIAL
  INCREMENTAL
  REEVALUACION
}

enum ModoEjecucionAnalisis {
  REGLAS
  IA
}

enum EstadoEjecucionAnalisis {
  PENDIENTE
  EN_CURSO
  COMPLETADA
  PARCIAL
  FALLIDA
  CANCELADA
  ABANDONADA
}

enum EstadoItemAnalisis {
  EXITOSO
  OMITIDO
  INVALIDO
  DESCARTADO_VERSION
  FALLIDO
}

enum OrigenEvaluacion {
  REGLA
  IA
}

enum RelacionComercial {
  PROSPECTO
  CLIENTE
  CLIENTE_RECURRENTE
  CLIENTE_INACTIVO
}

enum IntencionCompra {
  ALTA
  MEDIA
  BAJA
  DESCONOCIDA
}

enum NivelUrgencia {
