// =====================
// MEDIA / ARCHIVOS
// =====================

model MediaArchivo {
  id String @id @default(cuid())

  // Tenant
  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  // Módulo de origen
  modulo      String // "productos" | "plantillas" | "logos" | "conversaciones" | ...
  entidadTipo String? // tipo de entidad relacionada, ej: "producto"
  entidadId   String? // ID de la entidad relacionada

  // Archivo original
  nombreOriginal String
  mimeOriginal   String
  pesoOriginal   Int
  anchoOriginal  Int?
  altoOriginal   Int?

  // Archivo procesado
  mimeOptimizado String @default("image/webp")
  pesoOptimizado Int?
  ancho          Int?
  alto           Int?

  // URLs de storage
  keyOptimizado String // clave en el storage (ej: {instanciaId}/productos/optimized/{id}.webp)
  keyThumbnail  String? // clave del thumbnail
  keyOriginal   String? // clave del original (si se guarda)

  urlOptimizada String
  urlThumbnail  String?
  urlOriginal   String?

  // Metadatos
  hash            String // SHA-256 del buffer original para deduplicación
  proveedor       String      @default("local") // "r2" | "local" | "s3" | "azure"
  canalOrigen     String? // "web" | "whatsapp" | "instagram" | ...
  estadoProcesado EstadoMedia @default(LISTO)
  errorMensaje    String?

  // Relación con contacto (para cascade delete y limpieza de storage)
  contactoId String?
  contacto   Contacto? @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  // Auditoría
  creadoPorId   String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  mensajes MensajeConversacion[]

  @@unique([instanciaId, hash])
  @@index([instanciaId])
  @@index([instanciaId, modulo])
  @@index([entidadTipo, entidadId])
  @@index([contactoId])
  @@index([hash])
  @@index([estadoProcesado])
}

// =====================
// CONVERSACIONES
// =====================

// Identificador externo del contacto por canal (teléfono, email, instagramId, etc.)
model ContactoIdentificadorCanal {
  id            String @id @default(cuid())
  canal         String // "whatsapp", "email", "instagram", "tiktok"
  identificador String // número, email, userId externo

  contactoId String
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  creadoEn DateTime @default(now())

  @@unique([canal, identificador, instanciaId])
  @@index([instanciaId])
  @@index([contactoId])
}

// Cuenta configurada por canal (número de WhatsApp, email, cuenta Instagram, etc.)
model CuentaCanal {
  id            String  @id @default(cuid())
  canal         String // "whatsapp_lite", "whatsapp_business", "email", "instagram"
  nombre        String // "WhatsApp Principal", "Email Ventas"
  identificador String // +51955..., info@empresa.com
  configuracion Json // tokens, credenciales
  activa        Boolean @default(true)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)

  stageId String?
  stage   PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  conversaciones Conversacion[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([instanciaId])
  @@index([canal])
  @@index([stageId])
}

// Agrupador de mensajes por contacto + canal/cuenta
model Conversacion {
  id               String                    @id @default(cuid())
  asunto           String?
  estado           EstadoConversacion        @default(ABIERTA)
  clasificacion    ClasificacionConversacion @default(NINGUNA)
  clasificadoEn    DateTime?
  clasificadoPorId String?

  oportunidadGanadaRelId String?
  oportunidadGanadaRel   Oportunidad? @relation("ConvOportunidadGanada", fields: [oportunidadGanadaRelId], references: [id], onDelete: SetNull)

  contactoId String
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  cuentaCanalId String?
  cuentaCanal   CuentaCanal? @relation(fields: [cuentaCanalId], references: [id])

  instanciaId String?
  instancia   Instancia? @relation(fields: [instanciaId], references: [id], onDelete: SetNull)

  mensajes      MensajeConversacion[]
  oportunidades OportunidadConversacion[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([instanciaId])
  @@index([contactoId])
  @@index([cuentaCanalId])
  @@index([estado])
  @@index([clasificacion])
}

// Mensaje individual dentro de una conversación
model MensajeConversacion {
  id            String        @id @default(cuid())
  contenido     String?
  tipo          TipoMensaje   @default(TEXTO)
  remitente     RemitenteMsg
  estado        EstadoMensaje @default(ENVIADO)
  esNotaInterna Boolean       @default(false)
  idExterno     String? // ID del mensaje en el canal externo

  conversacionId String
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  usuarioId String? // agente que envió (si remitente = AGENTE)

  mediaUrl      String?
  mediaMimeType String?
  mediaDuracion Int?

  // FK a MediaArchivo para imágenes/media procesada con control de estado
  mediaArchivoId String?
  mediaArchivo   MediaArchivo? @relation(fields: [mediaArchivoId], references: [id], onDelete: SetNull)

  creadoEn  DateTime  @default(now())
  enviadoEn DateTime?
  leidoEn   DateTime?

  reacciones MensajeReaccion[]

  @@index([conversacionId])
  @@index([creadoEn])
  @@index([remitente])
}

model MensajeReaccion {
  id            String       @id @default(cuid())
  emoji         String
  tipo          TipoReaccion @default(INTERNA)
  nombreUsuario String?
  canal         String?
  idExterno     String?

  mensajeId String
  mensaje   MensajeConversacion @relation(fields: [mensajeId], references: [id], onDelete: Cascade)

  usuarioId  String?
  contactoId String?

  creadoEn DateTime @default(now())

  @@unique([mensajeId, usuarioId, emoji])
  @@unique([mensajeId, contactoId, emoji])
  @@index([mensajeId])
}

// Relación conversación ↔ oportunidad
model OportunidadConversacion {
  id       String  @id @default(cuid())
  esActiva Boolean @default(true)

  oportunidadId String
  oportunidad   Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)

  conversacionId String
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  creadoEn DateTime @default(now())

  @@unique([oportunidadId, conversacionId])
  @@index([oportunidadId])
  @@index([conversacionId])
}

enum ClasificacionConversacion {
  NINGUNA
  POSTVENTA
  SOPORTE
  COMERCIAL
}

// =====================
// CAPA DE INTELIGENCIA ARTIFICIAL
// =====================

// =====================
// ENUMS DE IA
// =====================

enum ProveedorIAEnum {
  ANTHROPIC
  OPENAI
  GEMINI
  DEEPSEEK
  NVIDIA
  LOCAL
}

enum TareaIA {
  CHAT
  RESUMEN
  CLASIFICACION
  SENTIMIENTO
  EXTRACCION_ENTIDADES
  REPORTE
  EMBEDDINGS
}

enum TipoMemoriaIA {
  EPISODICO
  SEMANTICO
  PROCEDURAL
}

enum TipoAgenteIA {
  COMERCIAL
  GERENCIA
}

// =====================
// MODELOS DE IA
// =====================

// Configuración global de IA por instancia (1-1)
model ConfiguracionIA {
  id                   String          @id @default(cuid())
  habilitado           Boolean         @default(false)
  proveedorDefault     ProveedorIAEnum @default(ANTHROPIC)
  modeloDefault        String          @default("claude-sonnet-4-6")
  temperaturaDefault   Float           @default(0.7)
  limiteTokensDiarios  Int?
  limiteTokensMensual  Int?
  fallbackHabilitado   Boolean         @default(true)
  creadoEn             DateTime        @default(now())
  actualizadoEn        DateTime        @updatedAt

  instanciaId String    @unique
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)
}

// Credenciales y configuración de cada proveedor IA por instancia
model ProveedorIA {
  id                     String          @id @default(cuid())
  proveedor              ProveedorIAEnum
  apiKeyEncriptada       String?
  baseUrl                String?
  modelosDisponibles     Json            @default("[]")
  activo                 Boolean         @default(true)
  prioridad              Int             @default(1)
  limitePorMinuto        Int?
  limitePorDia           Int?
  costoInputPorMilToken  Decimal?
  costoOutputPorMilToken Decimal?
  timeoutMs              Int             @default(30000)
  reintentosMax          Int             @default(2)
  casosDeUso             Json?
  tipoAgenteIA           TipoAgenteIA?
  creadoEn               DateTime        @default(now())
  actualizadoEn          DateTime        @updatedAt

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  usoIA UsoIA[]

  @@unique([instanciaId, proveedor, tipoAgenteIA])
  @@index([instanciaId])
  @@index([instanciaId, activo, prioridad])
}

// Extensión de Usuario (tipo=AGENTE) con capacidades de IA
model AgenteIAConfig {
  id                  String           @id @default(cuid())
  sistemaPrompt       String?
  personalidad        String?
  objetivo            String?
  especialidad        String?
  tipo                TipoAgenteIA     @default(COMERCIAL)
  temperaturaOverride Float?
  modeloPreferido     String?
  herramientas        Json?
  canalesPermitidos   Json?
  memoriaHabilitada   Boolean          @default(true)
  limiteTokensCtx     Int              @default(4000)
  instrucciones       Json?
  configuracionTono   Json?
  creadoEn            DateTime         @default(now())
  actualizadoEn       DateTime         @updatedAt

  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  memorias       MemoriaAgenteIA[]
  usoIA          UsoIA[]
  pipelineStages PipelineStage[]
}

// Memoria persistente del agente IA
model MemoriaAgenteIA {
  id       String        @id @default(cuid())
  tipo     TipoMemoriaIA
  clave    String
  valor    String
  expiraEn DateTime?
  creadoEn DateTime      @default(now())

  agenteIAConfigId String
  agenteIAConfig   AgenteIAConfig @relation(fields: [agenteIAConfigId], references: [id], onDelete: Cascade)

  @@index([agenteIAConfigId, tipo])
  @@index([expiraEn])
}

// Auditoría de uso y costos de IA
model UsoIA {
  id            String   @id @default(cuid())
  modelo        String
  tarea         TareaIA
  tokensInput   Int      @default(0)
  tokensOutput  Int      @default(0)
  costoEstimado Decimal?
  tiempoMs      Int      @default(0)
  exito         Boolean  @default(true)
  error         String?
  entidadTipo   String?
  entidadId     String?
  creadoEn      DateTime @default(now())

  instanciaId String
  instancia   Instancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  proveedorIAId String?
  proveedorIA   ProveedorIA? @relation(fields: [proveedorIAId], references: [id], onDelete: SetNull)

  agenteIAConfigId String?
  agenteIAConfig   AgenteIAConfig? @relation(fields: [agenteIAConfigId], references: [id], onDelete: SetNull)

  @@index([instanciaId, creadoEn])
  @@index([instanciaId, tarea])
  @@index([proveedorIAId])
}
